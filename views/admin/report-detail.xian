<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Report Details - Telengrow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes slideInLeft { from { opacity: 0; transform: translateX(-30px); } to { opacity: 1; transform: translateX(0); } }
    
    html, body {
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    
    .animate-fadeInDown { animation: fadeInDown 0.6s ease-out; }
    .animate-fadeInUp { animation: fadeInUp 0.6s ease-out; }
    .animate-slideInLeft { animation: slideInLeft 0.5s ease-out; }
    
    .sidebar {
      animation: slideInLeft 0.5s ease-out;
      background: #ffffff;
      border-right: 3px solid #009688;
    }
    
    .sidebar-link {
      transition: all 0.3s ease;
      color: #2C3E50;
    }
    
    .sidebar-link:hover, .sidebar-link.active {
      background-color: #f0fdf4;
      color: #009688;
      padding-left: 1.5rem;
      border-left: 4px solid #009688;
    }

    .status-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .status-new {
      background-color: #dcfce7;
      color: #166534;
    }

    .status-read {
      background-color: #e0e7ff;
      color: #3730a3;
    }

    .status-in_progress {
      background-color: #fef3c7;
      color: #92400e;
    }

    .status-resolved {
      background-color: #cffafe;
      color: #0c4a6e;
    }

    .type-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .type-feedback {
      background-color: #e9d5ff;
      color: #6b21a8;
    }

    .type-bug {
      background-color: #fee2e2;
      color: #991b1b;
    }

    .type-feature {
      background-color: #e0f2f1;
      color: #004D40;
    }

    .type-complaint {
      background-color: #fce7f3;
      color: #831843;
    }

    .details-section {
      animation: fadeInUp 0.6s ease-out;
      background: white;
      border-radius: 0.75rem;
      border: 1px solid #e5e7eb;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 1rem 0;
      border-bottom: 1px solid #f3f4f6;
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .info-label {
      font-weight: 600;
      color: #6b7280;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .info-value {
      color: #1f2937;
      font-weight: 500;
    }
  </style>
</head>
<body class="bg-gray-50">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="sidebar w-64 shadow-lg fixed h-full overflow-y-auto">
      <div class="p-6 border-b border-gray-100">
        <h1 class="text-2xl font-bold text-green-600">Telengrow</h1>
        <p class="text-xs text-gray-500 mt-1">Admin Panel</p>
      </div>

      <nav class="mt-6">
        <!-- Dashboard -->
        <a href="/admin/dashboard" class="sidebar-link flex items-center px-6 py-3 hover:bg-green-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <span>Dashboard</span>
        </a>

        <!-- Users -->
        <a href="/admin/users" class="sidebar-link flex items-center px-6 py-3 hover:bg-green-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 0a2 2 0 11-4 0 2 2 0 014 0zM5 20a3 3 0 015.856-1.487M5 10a3 3 0 016 0v.008a3 3 0 006 0 3 3 0 01-5.856 1.487M15 20h5v-2a6 6 0 00-5.856-5.856M5 20a6 6 0 005.856-5.856"></path>
          </svg>
          <span>Users</span>
        </a>

        <!-- Reports -->
        <a href="/admin/reports" class="sidebar-link flex items-center px-6 py-3 bg-green-50 text-green-600 border-l-4 border-green-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Reports</span>
        </a>

        <!-- Activity Log -->
        <a href="/admin/activity-log" class="sidebar-link flex items-center px-6 py-3 hover:bg-green-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Activity Log</span>
        </a>

        <!-- Analytics -->
        <a href="/admin/analytics" class="sidebar-link flex items-center px-6 py-3 hover:bg-green-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
          <span>Analytics</span>
        </a>

        <!-- Settings -->
        <a href="/admin/settings" class="sidebar-link flex items-center px-6 py-3 hover:bg-green-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Settings</span>
        </a>
      </nav>
    </div>

    <!-- Main Content -->
    <div class="flex-1 ml-64">
      <!-- Header -->
      <div class="bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm">
        <div class="px-8 py-6 flex justify-between items-center">
          <div class="animate-fadeInDown">
            <h2 class="text-3xl font-bold text-gray-800">Report Details</h2>
            <p class="text-gray-600 text-sm mt-1">View and manage user feedback and reports</p>
          </div>
          <div class="flex items-center space-x-4">
            <span class="text-gray-600 text-sm">{{user.name}}</span>
            <a href="/logout" class="text-red-600 hover:text-red-700 font-semibold text-sm">Logout</a>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-8">
        <!-- Back Button -->
        <a href="/admin/reports" class="inline-flex items-center mb-6 text-teal-600 hover:text-teal-700 font-semibold">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Reports
        </a>

        {{#if report}}
          <!-- Report Header -->
          <div class="details-section">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h1 class="text-2xl font-bold text-gray-900">{{report.subject}}</h1>
                <p class="text-gray-600 text-sm mt-1">Report ID: #{{report.id}}</p>
              </div>
              <div class="flex gap-3">
                <span class="type-badge type-{{report.type}}">
                  {{#switch report.type}}
                    {{#case 'feedback'}}Feedback{{/case}}
                    {{#case 'bug_report'}}Bug Report{{/case}}
                    {{#case 'feature_request'}}Feature Request{{/case}}
                    {{#case 'complaint'}}Complaint{{/case}}
                  {{/switch}}
                </span>
                <span class="status-badge status-{{report.status}}">
                  {{#switch report.status}}
                    {{#case 'new'}}New{{/case}}
                    {{#case 'read'}}Read{{/case}}
                    {{#case 'in_progress'}}In Progress{{/case}}
                    {{#case 'resolved'}}Resolved{{/case}}
                  {{/switch}}
                </span>
              </div>
            </div>
          </div>

          <!-- User Information -->
          <div class="details-section">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">User Information</h3>
            <div class="info-row">
              <span class="info-label">Name</span>
              <span class="info-value">{{report.User.name}}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Email</span>
              <span class="info-value">{{report.User.email}}</span>
            </div>
            {{#if report.User.phone}}
            <div class="info-row">
              <span class="info-label">Phone</span>
              <span class="info-value">{{report.User.phone}}</span>
            </div>
            {{/if}}
            {{#if report.User.age}}
            <div class="info-row">
              <span class="info-label">Age</span>
              <span class="info-value">{{report.User.age}}</span>
            </div>
            {{/if}}
          </div>

          <!-- Report Details -->
          <div class="details-section">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Report Details</h3>
            <div class="info-row">
              <span class="info-label">Subject</span>
              <span class="info-value">{{report.subject}}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Type</span>
              <span class="info-value capitalize">{{report.type}}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Status</span>
              <span class="info-value capitalize">{{report.status}}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Date Submitted</span>
              <span class="info-value">{{formatDate report.createdAt}}</span>
            </div>
          </div>

          <!-- Message Content -->
          <div class="details-section">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Message</h3>
            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
              <p class="text-gray-800 whitespace-pre-wrap leading-relaxed">{{report.message}}</p>
            </div>
          </div>

          <!-- Admin Response Section -->
          <div class="details-section">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Admin Response</h3>
            {{#if report.adminResponse}}
              <div class="bg-green-50 p-4 rounded-lg border border-green-200 mb-4">
                <p class="text-gray-800 whitespace-pre-wrap leading-relaxed">{{report.adminResponse}}</p>
                <p class="text-xs text-gray-600 mt-3">Responded on: {{formatDate report.responseDate}}</p>
              </div>
            {{else}}
              <p class="text-gray-600 italic">No response yet</p>
            {{/if}}

            {{#unless report.resolved}}
              <form method="POST" action="/admin/reports/{{report.id}}/respond" class="mt-4">
                <textarea 
                  name="adminResponse" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 resize-none" 
                  rows="5" 
                  placeholder="Type your response here..."></textarea>
                <div class="mt-4 flex gap-3">
                  <button 
                    type="submit" 
                    class="px-6 py-2 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition duration-200">
                    Send Response
                  </button>
                  <button 
                    type="button" 
                    onclick="updateStatus('resolved')" 
                    class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition duration-200">
                    Mark as Resolved
                  </button>
                </div>
              </form>
            {{else}}
              <div class="bg-blue-50 px-4 py-3 rounded-lg border border-blue-200">
                <p class="text-blue-900 font-semibold">This report has been resolved.</p>
              </div>
            {{/unless}}
          </div>

          <!-- Status Update Form (Hidden) -->
          <form id="statusForm" method="POST" action="/admin/reports/{{report.id}}/status" style="display: none;">
            <input type="hidden" name="status" id="statusInput">
          </form>

        {{else}}
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
            <p class="text-yellow-900">Report not found.</p>
          </div>
        {{/if}}
      </div>
    </div>
  </div>

  <script>
    function formatDate(dateString) {
      if (!dateString) return 'N/A';
      const options = { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric', 
        hour: '2-digit', 
        minute: '2-digit'
      };
      return new Date(dateString).toLocaleDateString('en-US', options);
    }

    function updateStatus(status) {
      document.getElementById('statusInput').value = status;
      document.getElementById('statusForm').submit();
    }

    // Format all dates on load
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-date]').forEach(el => {
        const date = el.getAttribute('data-date');
        if (date) el.textContent = formatDate(date);
      });
    });
  </script>
</body>
</html>
