<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Telengrow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-50px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-fade-in-down {
      animation: fadeInDown 0.6s ease-out;
    }

    .animate-fade-in-up {
      animation: fadeInUp 0.6s ease-out;
    }

    .animate-slide-in-left {
      animation: slideInLeft 0.6s ease-out;
    }

    .sidebar {
      animation: slideInLeft 0.6s ease-out;
      background: #ffffff;
      border-right: 2px solid #009688;
    }

    .sidebar-link {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      color: #2C3E50;
      border-left: 4px solid transparent;
    }

    .sidebar-link:hover,
    .sidebar-link.active {
      background: linear-gradient(90deg, rgba(0, 150, 136, 0.1), transparent);
      color: #009688;
      border-left-color: #009688;
      font-weight: 600;
    }

    .stat-card {
      animation: fadeInUp 0.6s ease-out backwards;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      background: #ffffff;
      border: 1.5px solid #e5e7eb;
      border-radius: 12px;
    }

    .stat-card:nth-child(1) {
      animation-delay: 0.1s;
    }
    .stat-card:nth-child(2) {
      animation-delay: 0.2s;
    }
    .stat-card:nth-child(3) {
      animation-delay: 0.3s;
    }
    .stat-card:nth-child(4) {
      animation-delay: 0.4s;
    }
    .stat-card:nth-child(5) {
      animation-delay: 0.5s;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px rgba(0, 150, 136, 0.15);
      border-color: #009688;
    }

    .progress-bar {
      background: linear-gradient(90deg, #009688 0%, #00796B 100%);
      border-radius: 8px;
      height: 6px;
      overflow: hidden;
    }

    .card {
      background: #ffffff;
      border: 1.5px solid #e5e7eb;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 12px;
    }

    .card:hover {
      box-shadow: 0 10px 25px rgba(0, 150, 136, 0.15);
      border-color: #009688;
      transform: translateY(-4px);
    }

    .navbar-clean {
      background: #ffffff;
      border-bottom: 2px solid #009688;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .quick-link {
      background: #ffffff;
      border-left: 4px solid #009688;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 8px;
    }

    .quick-link:hover {
      transform: translateX(4px);
      box-shadow: 0 8px 15px rgba(0, 150, 136, 0.1);
    }

    .admin-card {
      background: linear-gradient(135deg, #f0fdf4 0%, #f0fdf4 100%);
      border: 2px solid #d1fae5;
      border-radius: 12px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .admin-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px rgba(0, 150, 136, 0.15);
      border-color: #009688;
    }

    html {
      scroll-behavior: smooth;
    }
  </style>

</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Sidebar -->
  <div class="sidebar fixed left-0 top-0 w-64 h-screen text-white shadow-lg overflow-y-auto">
    <!-- Logo -->
    <div class="p-6 border-b-2 border-green-100 bg-gradient-to-r from-green-50 to-emerald-50">
      <div class="flex items-center gap-3 mb-3">
        <img src="/images/logo.svg" alt="Telengrow" class="h-10 w-10">
        <h1 class="text-2xl font-bold text-teal-600">Telengrow</h1>
      </div>
      <p class="text-teal-700 text-xs font-semibold text-center">Mindoro State University</p>
    <nav class="mt-6">
      <a href="/admin/HOME" class="sidebar-link active block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        <span>Dashboard</span>
      </a>
      <a href="/admin/users" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2z"></path>
        </svg>
        <span>Users</span>
      </a>
      <a href="/admin/reports" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Reports</span>
      </a>
      <a href="/admin/activity-log" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        <span>Activity Log</span>
      </a>
      <a href="/admin/analytics" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
        </svg>
        <span>Analytics</span>
      </a>
      <a href="/admin/settings" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>Settings</span>
      </a>
    </nav>

    <!-- User Profile -->
    <div class="absolute bottom-0 left-0 right-0 p-4 border-t-2 border-green-100 bg-gradient-to-r from-green-50 to-emerald-50">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-500 rounded-full flex items-center justify-center font-bold text-white text-lg">
          {{substring user.name 0 1}}
        </div>
        <div class="w-12 h-12 bg-gradient-to-br from-teal-500 to-teal-600 rounded-full flex items-center justify-center font-bold text-white text-lg">
          {{substring user.name 0 1}}
        </div>
        <div>
          <div class="font-bold text-sm text-gray-900">{{user.name}}</div>
          <div class="text-xs text-teal-700 font-semibold">Admin</div>white px-4 py-2 rounded-lg font-bold text-center block transition">
        Logout
      </a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="ml-64 min-h-screen bg-gray-50">
    <!-- Top Navigation -->
    <nav class="navbar-clean sticky top-0 z-30">
      <div class="container mx-auto flex justify-between items-center px-6 py-3">
        <div class="flex items-center space-x-4">
          <img src="/images/logo.svg" alt="Telengrow" class="h-10 w-10">
          <h1 class="text-2xl font-bold text-green-600">Telengrow</h1>
          <span class="text-sm text-gray-600 font-semibold ml-2">Admin Panel</span>
        </div>
        <div class="flex items-center space-xteal
          <div class="hidden md:block text-right">
            <p class="text-sm font-semibold text-gray-900">{{user.name}}</p>
            <p class="text-xs text-gray-500">Administrator</p>
          </div>
          <a href="/logout" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition text-sm font-semibold">
            Logout
          </a>
        </div>
      </div>
    </nav>

    <!-- Page Content -->
    <div class="container mx-auto p-6 md:p-8">
      <!-- Welcome Header -->
      <div class="mb-12 animate-fade-in-down">
        <h1 class="text-5xl font-bold text-gray-900 mb-2">Welcome, <span class="text-teal-600">{{user.name}}</span></h1>
        <p class="text-lg text-gray-600">Manage system activity, users, and track platform metrics in real-time</p>
      </div>

      <!-- Main Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-12">
        <!-- Total Users Card -->
        <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.1s;">
          <div class="mb-4">
            <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Total Users</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{stats.totalUsers}}</p>
          </div>
          <div class="text-gray-500 text-xs font-medium">Registered users</div>
          <div class="progress-bar mt-3"></div>
        </div>

        <!-- Games Played Card -->
        <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.2s;">
          <div class="mb-4">
            <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Games Played</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{stats.totalGames}}</p>
          </div>
          <div class="text-gray-500 text-xs font-medium">Total sessions</div>
          <div class="progress-bar mt-3"></div>
        </div>

        <!-- Journal Entries Card -->
        <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.3s;">
          <div class="mb-4">
            <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Journals</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{stats.totalJournals}}</p>
          </div>
          <div class="text-gray-500 text-xs font-medium">Entries written</div>
          <div class="progress-bar mt-3"></div>
        </div>

        <!-- Reading Sessions Card -->
        <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.4s;">
          <div class="mb-4">
            <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Reading</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{stats.totalReadingSessions}}</p>
          </div>
          <div class="text-gray-500 text-xs font-medium">Reading sessions</div>
          <div class="progress-bar mt-3"></div>
        </div>

        <!-- Active Today Card -->
        <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.5s;">
          <div class="mb-4">
            <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Active Today</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{stats.activeToday}}</p>
          </div>
          <div class="text-gray-500 text-xs font-medium">Online now</div>
          <div class="progress-bar mt-3"></div>
        </div>
      </div>

      <!-- Main Content Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
        <!-- Left Column -->
        <div class="lg:col-span-2">
          <!-- Quick Stats Row -->
          <div class="mb-12">
            <div class="mb-8 animate-fade-in-down">
              <h2 class="text-3xl font-bold text-gray-900">📊 System Metrics</h2>
              <p class="text-gray-600 text-lg mt-2">Real-time platform analytics and insights</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Total Activities Card -->
              <div class="admin-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.1s;">
                <div class="flex justify-between items-start mb-4">
                  <div class="text-4xl">📈</div>
                  <span class="text-xs bg-green-100 text-green-700 px-3 py-1 rounded-full font-bold">Analytics</span>
                </div>
                <h3 class="font-bold text-xl text-gray-900 mb-2">Total Activities</h3>
                <p class="text-sm text-gray-600 mb-5">All user interactions combined</p>
                <div class="text-3xl font-bold text-green-600">{{stats.totalGames}}</div>
                <div class="text-xs text-gray-500 font-medium mt-3">Sessions completed</div>
              </div>

              <!-- Engagement Status Card -->
              <div class="admin-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.2s;">
                <div class="flex justify-between items-start mb-4">
                  <div class="text-4xl">👥</div>
                  <span class="text-xs bg-blue-100 text-blue-700 px-3 py-1 rounded-full font-bold">Users</span>
                </div>
                <h3 class="font-bold text-xl text-gray-900 mb-2">Engagement Status</h3>
                <p class="text-sm text-gray-600 mb-5">Users currently active</p>
                <div class="text-3xl font-bold text-blue-600">{{stats.activeToday}}</div>
                <div class="text-xs text-gray-500 font-medium mt-3">Online right now</div>
              </div>

              <!-- Content Created Card -->
              <div class="admin-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.3s;">
                <div class="flex justify-between items-start mb-4">
                  <div class="text-4xl">✍️</div>
                  <span class="text-xs bg-purple-100 text-purple-700 px-3 py-1 rounded-full font-bold">Content</span>
                </div>
                <h3 class="font-bold text-xl text-gray-900 mb-2">Content Created</h3>
                <p class="text-sm text-gray-600 mb-5">User-generated journal entries</p>
                <div class="text-3xl font-bold text-purple-600">{{stats.totalJournals}}</div>
                <div class="text-xs text-gray-500 font-medium mt-3">Total entries</div>
              </div>

              <!-- System Health Card -->
              <div class="admin-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.4s;">
                <div class="flex justify-between items-start mb-4">
                  <div class="text-4xl">✅</div>
                  <span class="text-xs bg-green-100 text-green-700 px-3 py-1 rounded-full font-bold">Status</span>
                </div>
                <h3 class="font-bold text-xl text-gray-900 mb-2">System Health</h3>
                <p class="text-sm text-gray-600 mb-5">Platform status and performance</p>
                <div class="text-3xl font-bold text-green-600">Optimal</div>
                <div class="text-xs text-gray-500 font-medium mt-3">All systems running</div>
              </div>
            </div>
          </div>

        <!-- Pending Counselor Approvals Section -->
        {{#if pendingCounselors}}
        <div class="mb-12">
          <div class="mb-8 animate-fade-in-down">
            <h2 class="text-3xl font-bold text-gray-900">👤 Pending Approvals</h2>
            <p class="text-gray-600 text-lg mt-2">Counselor accounts awaiting review</p>
          </div>
          
          <div class="space-y-4">
            {{#each pendingCounselors}}
            <div class="approval-card rounded-xl p-6 animate-fade-in-up">
              <div class="flex justify-between items-start gap-4 mb-4">
                <div class="flex items-start gap-4 flex-1">
                  <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-green-500 to-emerald-500 flex items-center justify-center text-white font-bold text-lg">
                    {{substring this.name 0 1}}
                  </div>
                  <div class="flex-1">
                    <h3 class="font-bold text-gray-900 text-lg">{{this.name}}</h3>
                    <p class="text-sm text-gray-600">{{this.email}}</p>
                    <div class="flex gap-2 mt-2">
                      <span class="text-xs bg-amber-100 text-amber-800 px-2 py-1 rounded font-semibold">Counselor</span>
                      <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded font-semibold">Pending</span>
                    </div>
                  </div>
                </div>
                <div class="flex gap-2">
                  <button onclick="approveCounselor({{this.id}})" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition font-bold text-sm">✓ Approve</button>
                  <button onclick="rejectCounselor({{this.id}})" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition font-bold text-sm">✕ Reject</button>
                </div>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
        {{/if}}

        <!-- Recent Users Section -->
        <div class="mb-12">
          <div class="mb-8 animate-fade-in-down">
            <h2 class="text-3xl font-bold text-gray-900">👥 Recent Users</h2>
            <p class="text-gray-600 text-lg mt-2">Recently joined members</p>
          </div>
          
          {{#if users}}
          <div class="grid grid-cols-1 gap-4">
            {{#each users}}
            {{#lt @index 3}}
            <div class="card rounded-xl p-6 animate-fade-in-up">
              <div class="flex justify-between items-start gap-4">
                <div class="flex items-start gap-4 flex-1">
                  <div class="w-14 h-14 rounded-lg bg-gradient-to-br from-green-500 to-emerald-500 flex items-center justify-center text-white font-bold text-xl">
                    {{substring this.name 0 1}}
                  </div>
                  <div class="flex-1">
                    <h3 class="font-bold text-gray-900 text-lg">{{this.name}}</h3>
                    <p class="text-sm text-gray-600">{{this.email}}</p>
                    {{#if this.lastActive}}
                    <p class="text-xs text-gray-500 mt-1">Last active: {{formatDate this.lastActive}}</p>
                    {{/if}}
                  </div>
                </div>
                <a href="/admin/users/{{this.id}}" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition font-bold text-sm whitespace-nowrap">View</a>
              </div>
            </div>
            {{/lt}}
            {{/each}}
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Right Column - Quick Access -->
      <div class="lg:col-span-1">
        <!-- Quick Navigation -->
        <div class="mb-8">
          <div class="mb-4 animate-fade-in-down">
            <h2 class="text-2xl font-bold text-gray-900">⚡ Quick Access</h2>
          </div>
          <div class="space-y-3">
            <a href="/admin/users" class="quick-link bg-white rounded-lg p-4 block animate-fade-in-up" style="animation-delay: 0.1s;">
              <p class="font-bold text-gray-900">👥 All Users</p>
              <p class="text-xs text-gray-600 mt-1">Manage user accounts</p>
            </a>
            
            <a href="/admin/reports" class="quick-link bg-white rounded-lg p-4 border-l-blue-600 block animate-fade-in-up" style="animation-delay: 0.2s;">
              <p class="font-bold text-gray-900">📋 Reports</p>
              <p class="text-xs text-gray-600 mt-1">View system reports</p>
            </a>
            
            <a href="/admin/activity-log" class="quick-link bg-white rounded-lg p-4 border-l-purple-600 block animate-fade-in-up" style="animation-delay: 0.3s;">
              <p class="font-bold text-gray-900">📊 Activity Log</p>
              <p class="text-xs text-gray-600 mt-1">Track user activities</p>
            </a>

            <a href="/admin/analytics" class="quick-link bg-white rounded-lg p-4 border-l-orange-600 block animate-fade-in-up" style="animation-delay: 0.4s;">
              <p class="font-bold text-gray-900">📈 Analytics</p>
              <p class="text-xs text-gray-600 mt-1">Detailed platform analytics</p>
            </a>

            <a href="/admin/settings" class="quick-link bg-white rounded-lg p-4 border-l-teal-600 block animate-fade-in-up" style="animation-delay: 0.5s;">
              <p class="font-bold text-gray-900">⚙️ Settings</p>
              <p class="text-xs text-gray-600 mt-1">System configuration</p>
            </a>
          </div>
        </div>

        <!-- System Status -->
        <div class="mb-8">
          <div class="mb-4 animate-fade-in-down">
            <h2 class="text-2xl font-bold text-gray-900">System Status</h2>
          </div>
          <div class="bg-white rounded-xl p-6 border border-gray-200 border-t-4 border-t-green-600 animate-fade-in-up">
            <div class="space-y-6">
              <div>
                <div class="flex justify-between text-sm mb-3">
                  <span class="text-gray-900 font-bold">Server</span>
                  <span class="text-green-600 font-bold">✓ Online</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full" style="width: 100%;"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-sm mb-3">
                  <span class="text-gray-900 font-bold">Database</span>
                  <span class="text-green-600 font-bold">✓ Connected</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full" style="width: 100%;"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-sm mb-3">
                  <span class="text-gray-900 font-bold">Storage</span>
                  <span class="text-green-600 font-bold">65% Used</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full" style="width: 65%;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

  <script>
    // Utility functions for the dashboard
    function formatDate(date) {
      if (!date) return 'Never';
      const d = new Date(date);
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    async function approveCounselor(id) {
      if (!confirm('Approve this counselor?')) return;
      
      try {
        const response = await fetch(`/admin/counselor/approve/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        
        if (response.ok) {
          alert('Counselor approved successfully!');
          location.reload();
        } else {
          alert('Error approving counselor');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Failed to approve counselor');
      }
    }

    async function rejectCounselor(id) {
      if (!confirm('Reject this counselor?')) return;
      
      try {
        const response = await fetch(`/admin/counselor/reject/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        
        if (response.ok) {
          alert('Counselor rejected!');
          location.reload();
        } else {
          alert('Error rejecting counselor');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Failed to reject counselor');
      }
    }

    // Initialize dashboard
    document.addEventListener('DOMContentLoaded', () => {
      console.log('Admin Dashboard Loaded');
      
      // Add smooth scroll behavior
      document.documentElement.style.scrollBehavior = 'smooth';
      
      // Format all timestamps
      document.querySelectorAll('[data-date]').forEach(el => {
        const date = el.getAttribute('data-date');
        if (date) el.textContent = formatDate(new Date(date));
      });
    });
  </script>
</body>
</html>
