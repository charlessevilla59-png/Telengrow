<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users Management - Tell 'n Grow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes slideInLeft { from { opacity: 0; transform: translateX(-30px); } to { opacity: 1; transform: translateX(0); } }
    
    .animate-fadeInDown { animation: fadeInDown 0.6s ease-out; }
    .animate-fadeInUp { animation: fadeInUp 0.6s ease-out; }
    .animate-slideInLeft { animation: slideInLeft 0.6s ease-out; }
    
    .sidebar {
      animation: slideInLeft 0.5s ease-out;
      background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
      border-right: 1px solid rgba(0, 150, 136, 0.15);
    }
    
    .sidebar-link {
      transition: all 0.3s ease;
      color: #2C3E50;
    }
    
    .sidebar-link:hover, .sidebar-link.active {
      background-color: rgba(0, 150, 136, 0.12);
      color: #009688;
      padding-left: 1.5rem;
      border-left: 4px solid #009688;
      box-shadow: inset 0 0 15px rgba(0, 150, 136, 0.08);
    }
    
    .user-row {
      animation: fadeInUp 0.6s ease-out backwards;
      transition: all 0.3s ease;
      background: linear-gradient(135deg, #FFFFFF 0%, #F5F5F5 100%);
      border: 1px solid rgba(0, 150, 136, 0.15);
    }
    .user-row:hover {
      background: rgba(0, 150, 136, 0.05);
      transform: translateX(4px);
      border-color: rgba(0, 150, 136, 0.3);
    }
  </style>
</head>
<body class="bg-gradient-to-br from-white via-green-50 to-green-100 min-h-screen text-gray-800">
  <!-- Sidebar -->
  <div class="sidebar fixed left-0 top-0 w-64 h-screen text-gray-800 shadow-2xl overflow-y-auto">
    <!-- Logo -->
    <div class="p-6 border-b border-green-200 bg-gradient-to-r from-green-50 to-green-100">
      <div class="flex items-center gap-3 mb-3">
        <img src="/images/logo.jpg" alt="Tell 'n Grow" class="h-10 w-10">
        <h1 class="text-2xl font-bold bg-gradient-to-r from-teal-600 to-teal-500 bg-clip-text text-transparent">Tell 'n Grow</h1>
      </div>
      <p class="text-gray-600 text-xs font-semibold text-center">Mindoro State University</p>
    </div>

    <!-- Navigation -->
    <nav class="mt-6">
      <a href="/admin/dashboard" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">📊</span>
        <span>Dashboard</span>
      </a>
      <a href="/admin/users" class="sidebar-link active block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">👥</span>
        <span>Users</span>
      </a>
      <a href="/admin/analytics" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">📉</span>
        <span>Analytics</span>
      </a>

    </nav>

    <!-- User Profile -->
    <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-green-200 bg-gradient-to-r from-green-50 to-green-100">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-teal-400 to-teal-600 rounded-full flex items-center justify-center font-bold text-white text-lg shadow-lg">
          {{substring user.name 0 1}}
        </div>
        <div>
          <div class="font-bold text-sm text-gray-800">{{user.name}}</div>
          <div class="text-xs text-gray-600 font-semibold">Admin</div>
        </div>
      </div>
      <a href="/logout" class="w-full bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white px-4 py-2 rounded-lg font-bold text-center block transition shadow-lg">
        Logout
      </a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="ml-64 min-h-screen bg-gradient-to-br from-white via-green-50 to-yellow-50">
    <!-- Header -->
    <div class="bg-gradient-to-r from-white to-green-50 border-b border-green-200 sticky top-0 z-40 shadow-lg">
      <div class="px-8 py-4">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-3xl font-bold text-gray-800">Users Management</h1>
            <p class="text-gray-600 text-sm mt-1">View and manage all users in the system</p>
          </div>
          <a href="/admin/create-counselor" class="bg-gradient-to-r from-teal-600 to-teal-500 hover:from-teal-700 hover:to-teal-600 text-white px-6 py-3 rounded-lg font-bold transition shadow-lg">
            + Create Counselor
          </a>
        </div>
      </div>
    </div>

    <!-- Page Content -->
    <div class="p-8">
      <!-- Search and Filter -->
      <div class="bg-white border border-teal-400 border-opacity-30 rounded-2xl p-6 mb-8 animate-fadeInUp shadow-lg">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label class="text-sm font-bold text-teal-600 block mb-2">Search</label>
            <input type="text" id="searchInput" placeholder="Name or email..." 
                   class="w-full px-4 py-3 border border-green-300 bg-green-50 text-gray-800 rounded-lg focus:border-teal-500 outline-none transition placeholder-gray-500"
                   onkeyup="filterUsers()">
          </div>
          <div>
            <label class="text-sm font-bold text-teal-600 block mb-2">Role</label>
            <select id="roleFilter" class="w-full px-4 py-3 border border-green-300 bg-green-50 text-gray-800 rounded-lg focus:border-teal-500 outline-none transition hover:bg-green-100" 
                    onchange="filterUsers()">
              <option value="">All Roles</option>
              <option value="user">Regular User</option>
              <option value="counselor">Counselor</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <div>
            <label class="text-sm font-bold text-teal-600 block mb-2">Status</label>
            <select id="statusFilter" class="w-full px-4 py-3 border border-green-300 bg-green-50 text-gray-800 rounded-lg focus:border-teal-500 outline-none transition hover:bg-green-100" 
                    onchange="filterUsers()">
              <option value="">All Status</option>
              <option value="active">Active</option>
              <option value="pending">Pending</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
          <div class="flex items-end">
            <button onclick="location.reload()" class="w-full bg-gradient-to-r from-teal-600 to-teal-500 hover:from-teal-700 hover:to-teal-600 text-white px-4 py-3 rounded-lg font-bold transition shadow-lg">
              Refresh
            </button>
          </div>
        </div>
      </div>

      <!-- Users Table -->
      <div class="bg-slate-800 border border-slate-700 rounded-2xl overflow-hidden shadow-lg">
        {{#if users.length}}
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-slate-900 border-b border-slate-700">
              <tr>
                <th class="px-6 py-4 text-left font-bold text-slate-300">User</th>
                <th class="px-6 py-4 text-left font-bold text-slate-300">Email</th>
                <th class="px-6 py-4 text-left font-bold text-slate-300">Role</th>
                <th class="px-6 py-4 text-left font-bold text-slate-300">Status</th>
                <th class="px-6 py-4 text-left font-bold text-slate-300">Activity</th>
                <th class="px-6 py-4 text-left font-bold text-slate-300">Actions</th>
              </tr>
            </thead>
            <tbody id="usersTableBody">
              {{#each users}}
              <tr class="user-row border-b border-slate-700" data-role="{{this.role}}" data-status="{{this.accountStatus}}" data-name="{{this.name}}" data-email="{{this.email}}">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-green-500 rounded-full flex items-center justify-center text-white font-bold">
                      {{substring this.name 0 1}}
                    </div>
                    <div>
                      <div class="font-bold text-gray-100">{{this.name}}</div>
                      {{#if this.progress}}<div class="text-xs text-slate-400">⭐ {{this.progress.totalPoints}} pts</div>{{/if}}
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 text-slate-400">{{this.email}}</td>
                <td class="px-6 py-4">
                  {{#eq this.role 'user'}}
                  <span class="bg-blue-900 bg-opacity-30 text-blue-300 px-3 py-1 rounded-lg font-semibold text-xs border border-blue-700">👤 User</span>
                  {{else}}{{#eq this.role 'counselor'}}
                  <span class="bg-purple-900 bg-opacity-30 text-purple-300 px-3 py-1 rounded-lg font-semibold text-xs border border-purple-700">👨‍⚕️ Counselor</span>
                  {{else}}{{#eq this.role 'admin'}}
                  <span class="bg-red-900 bg-opacity-30 text-red-300 px-3 py-1 rounded-lg font-semibold text-xs border border-red-700">🔐 Admin</span>
                  {{/eq}}{{/eq}}{{/eq}}
                </td>
                <td class="px-6 py-4">
                  {{#eq this.accountStatus 'active'}}
                  <span class="bg-emerald-900 bg-opacity-30 text-emerald-300 px-3 py-1 rounded-lg font-semibold text-xs border border-emerald-700">✓ Active</span>
                  {{else}}{{#eq this.accountStatus 'pending'}}
                  <span class="bg-yellow-900 bg-opacity-30 text-yellow-300 px-3 py-1 rounded-lg font-semibold text-xs border border-yellow-700">⏳ Pending</span>
                  {{else}}
                  <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded-lg font-semibold text-xs border border-gray-600">○ Inactive</span>
                  {{/eq}}{{/eq}}
                </td>
                <td class="px-6 py-4 text-sm text-slate-400">
                  {{#if this.lastActive}}
                  {{formatDate this.lastActive}}
                  {{else}}
                  <span class="text-slate-500">Never</span>
                  {{/if}}
                </td>
                <td class="px-6 py-4">
                  <a href="/admin/users/{{this.id}}" class="bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 transition text-sm font-bold inline-block">
                    View
                  </a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="text-center py-12">
          <div class="text-5xl mb-3">👥</div>
          <p class="text-slate-400 text-lg">No users found</p>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  <script>
    function filterUsers() {
      const searchInput = document.getElementById('searchInput').value.toLowerCase();
      const roleFilter = document.getElementById('roleFilter').value;
      const statusFilter = document.getElementById('statusFilter').value;

      const rows = document.querySelectorAll('.user-row');
      
      rows.forEach(row => {
        const name = row.getAttribute('data-name').toLowerCase();
        const email = row.getAttribute('data-email').toLowerCase();
        const role = row.getAttribute('data-role');
        const status = row.getAttribute('data-status');

        const nameMatch = name.includes(searchInput) || email.includes(searchInput);
        const roleMatch = !roleFilter || role === roleFilter;
        const statusMatch = !statusFilter || status === statusFilter;

        row.style.display = (nameMatch && roleMatch && statusMatch) ? '' : 'none';
      });
    }
  </script>
</body>
</html>
