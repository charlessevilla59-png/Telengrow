<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Reports - Tell 'n Grow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * {
      scrollbar-width: thin;
      scrollbar-color: #009688 #F1F8E9;
    }
    
    ::-webkit-scrollbar {
      width: 8px;
    }
    
    ::-webkit-scrollbar-track {
      background: #F1F8E9;
    }
    
    ::-webkit-scrollbar-thumb {
      background: #009688;
      border-radius: 4px;
    }

    @keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes slideInLeft { from { opacity: 0; transform: translateX(-30px); } to { opacity: 1; transform: translateX(0); } }
    @keyframes glow { 0%, 100% { box-shadow: 0 0 20px rgba(0, 150, 136, 0.2); } 50% { box-shadow: 0 0 30px rgba(0, 150, 136, 0.3); } }
    
    .animate-fadeInDown { animation: fadeInDown 0.6s ease-out; }
    .animate-fadeInUp { animation: fadeInUp 0.6s ease-out; }
    .animate-slideInLeft { animation: slideInLeft 0.6s ease-out; }
    
    .sidebar {
      animation: slideInLeft 0.5s ease-out;
      background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
      border-right: 1px solid rgba(0, 150, 136, 0.2);
    }
    
    .sidebar-link {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      color: #2C3E50;
    }
    
    .sidebar-link:hover, .sidebar-link.active {
      background-color: rgba(0, 150, 136, 0.15);
      color: #009688;
      padding-left: 1.5rem;
      border-left: 4px solid #009688;
      box-shadow: inset 0 0 15px rgba(0, 150, 136, 0.1);
    }
    
    .report-row {
      animation: fadeInUp 0.6s ease-out backwards;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      background: linear-gradient(135deg, #FFFFFF 0%, #F5F5F5 100%);
      border: 1px solid rgba(0, 150, 136, 0.2);
    }
    
    .report-row:hover {
      transform: translateX(8px);
      border-color: rgba(0, 150, 136, 0.5);
      box-shadow: 0 0 20px rgba(0, 150, 136, 0.15);
    }

    .status-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .status-new {
      background-color: rgba(16, 185, 129, 0.2);
      color: #86efac;
      border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .status-read {
      background-color: rgba(59, 130, 246, 0.2);
      color: #93c5fd;
      border: 1px solid rgba(59, 130, 246, 0.4);
    }

    .status-in_progress {
      background-color: rgba(251, 191, 36, 0.2);
      color: #fcd34d;
      border: 1px solid rgba(251, 191, 36, 0.4);
    }

    .status-resolved {
      background-color: rgba(34, 197, 234, 0.2);
      color: #67e8f9;
      border: 1px solid rgba(34, 197, 234, 0.4);
    }

    .type-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .type-feedback {
      background-color: rgba(168, 85, 247, 0.2);
      color: #d8b4fe;
      border: 1px solid rgba(168, 85, 247, 0.4);
    }

    .type-bug_report {
      background-color: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.4);
    }

    .type-feature_request {
      background-color: rgba(16, 185, 129, 0.2);
      color: #86efac;
      border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .type-complaint {
      background-color: rgba(244, 63, 94, 0.2);
      color: #fb7185;
      border: 1px solid rgba(244, 63, 94, 0.4);
    }
  </style>
</head>
<body class="bg-gradient-to-br from-white via-green-50 to-yellow-50 min-h-screen text-gray-800">
  <!-- Sidebar -->
  <div class="sidebar fixed left-0 top-0 w-64 h-screen text-gray-900 shadow-2xl overflow-y-auto">
    <!-- Logo -->
    <div class="p-6 border-b border-slate-700">
      <div class="flex items-center gap-3 mb-3">
        <img src="/images/logo.jpg" alt="Tell 'n Grow" class="h-10 w-10">
        <h1 class="text-2xl font-bold bg-gradient-to-r from-teal-600 to-teal-500 bg-clip-text text-transparent">Tell 'n Grow</h1>
      </div>
      <p class="text-gray-600 text-xs font-semibold text-center">Mindoro State University</p>
    </div>

    <!-- Navigation -->
    <nav class="mt-6">
      <a href="/admin/dashboard" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">📊</span>
        <span>Dashboard</span>
      </a>
      <a href="/admin/users" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">👥</span>
        <span>Users</span>
      </a>
      <a href="/admin/reports" class="sidebar-link active block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">🚨</span>
        <span>Reports</span>
      </a>
      <a href="/admin/activity-log" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">📈</span>
        <span>Activity Log</span>
      </a>
      <a href="/admin/analytics" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">📉</span>
        <span>Analytics</span>
      </a>
      <a href="/admin/settings" class="sidebar-link block px-4 py-3 mx-3 rounded-lg mb-2 font-semibold flex items-center gap-3">
        <span class="text-xl">⚙️</span>
        <span>Settings</span>
      </a>
    </nav>

    <!-- User Profile -->
    <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-green-200 bg-slate-800">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-teal-500 to-teal-600 rounded-full flex items-center justify-center font-bold text-white text-lg">
          {{substring user.name 0 1}}
        </div>
        <div>
          <div class="font-bold text-sm text-gray-100">{{user.name}}</div>
          <div class="text-xs text-teal-400 font-semibold">Admin</div>
        </div>
      </div>
      <a href="/logout" class="w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-bold text-center block transition">
        Logout
      </a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="ml-64 min-h-screen bg-gradient-to-br from-white via-green-50 to-yellow-50">
    <!-- Header -->
    <div class="bg-white border-b border-green-200 sticky top-0 z-40">
      <div class="px-8 py-4 flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">User Reports</h1>
          <p class="text-gray-600 text-sm mt-1">View and manage all user feedback and reports</p>
        </div>
        <div class="text-right">
          <p class="text-sm text-gray-600">Total Reports: <span class="font-bold text-teal-600">{{reports.length}}</span></p>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="p-8">
      <!-- Statistics Cards -->
      <div class="grid grid-cols-4 gap-4 mb-8">
        <div class="bg-gradient-to-br from-white to-green-50 rounded-lg shadow-lg p-6 border-l-4 border-teal-500">
          <p class="text-gray-600 text-sm font-semibold">New Reports</p>
          <p class="text-3xl font-bold text-teal-600 mt-2">{{stats.new}}</p>
        </div>
        <div class="bg-gradient-to-br from-white to-blue-50 rounded-lg shadow-lg p-6 border-l-4 border-blue-500">
          <p class="text-gray-600 text-sm font-semibold">In Progress</p>
          <p class="text-3xl font-bold text-blue-600 mt-2">{{stats.in_progress}}</p>
        </div>
        <div class="bg-gradient-to-br from-white to-yellow-50 rounded-lg shadow-lg p-6 border-l-4 border-yellow-500">
          <p class="text-gray-600 text-sm font-semibold">Read</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2">{{stats.read}}</p>
        </div>
        <div class="bg-gradient-to-br from-white to-cyan-50 rounded-lg shadow-lg p-6 border-l-4 border-cyan-500">
          <p class="text-gray-600 text-sm font-semibold">Resolved</p>
          <p class="text-3xl font-bold text-cyan-600 mt-2">{{stats.resolved}}</p>
        </div>
      </div>

      <!-- Reports Table -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden border border-gray-200">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-gray-100 border-b border-gray-300">
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-800">User</th>
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-800">Type</th>
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-800">Subject</th>
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-800">Status</th>
                <th class="px-6 py-4 text-left text-sm font-bold text-gray-800">Date</th>
                <th class="px-6 py-4 text-center text-sm font-bold text-gray-800">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#if reports}}
                {{#each reports}}
                  <tr class="report-row border-b border-green-200">
                    <td class="px-6 py-4">
                      <div>
                        <p class="font-semibold text-gray-900">{{this.User.name}}</p>
                        <p class="text-xs text-gray-600">{{this.User.email}}</p>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <span class="type-badge type-{{this.type}}">
                        {{#if (eq this.type "bug_report")}}
                          Bug Report
                        {{else if (eq this.type "feature_request")}}
                          Feature Request
                        {{else}}
                          {{capitalize this.type}}
                        {{/if}}
                      </span>
                    </td>
                    <td class="px-6 py-4">
                      <p class="text-gray-900 font-medium truncate">{{this.subject}}</p>
                    </td>
                    <td class="px-6 py-4">
                      <span class="status-badge status-{{this.status}}">
                        {{capitalize this.status}}
                      </span>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                      {{formatDate this.createdAt}}
                    </td>
                    <td class="px-6 py-4 text-center">
                      <a href="/admin/reports/{{this.id}}" class="inline-block bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg font-semibold transition duration-200">
                        View
                      </a>
                    </td>
                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="6" class="px-6 py-8 text-center text-gray-600">
                    <p class="text-lg">No reports found</p>
                  </td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      console.log('User Reports page loaded');
    });
  </script>
</body>
</html>
