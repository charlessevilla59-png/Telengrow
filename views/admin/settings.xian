<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - Tellngrow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-white via-green-50 to-green-100 min-h-screen text-gray-800">
  <nav class="bg-gradient-to-r from-white to-green-50 border-b border-green-200 shadow-lg p-4 sticky top-0 z-50">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-6">
        <a href="/admin/dashboard" class="text-gray-700 hover:text-teal-600 transition font-medium">← Back</a>
        <h1 class="text-2xl font-bold text-gray-800">⚙️ Settings</h1>
      </div>
      <div class="space-x-4 flex items-center">
        <span class="text-gray-700">👤 {{user.name}}</span>
        <a href="/logout" class="text-gray-700 hover:text-red-500 font-medium transition">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <div class="mb-8">
      <h2 class="text-3xl font-bold text-gray-800">Admin Settings</h2>
      <p class="text-gray-600 mt-1">Manage system settings and configurations</p>
    </div>

    <!-- Coming Soon Message -->
    <div class="bg-gradient-to-br from-white to-green-50 rounded-xl shadow-lg p-12 text-center border border-green-200">
      <div class="text-8xl mb-6">⚙️</div>
      <h3 class="text-3xl font-bold text-gray-800 mb-4">Settings</h3>
      <p class="text-xl text-gray-700 mb-8">System settings and configuration options coming soon!</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto text-left">
        <div class="bg-teal-50 rounded-lg p-6 border border-teal-200">
          <div class="text-3xl mb-3">🔐</div>
          <h4 class="font-bold text-gray-800 mb-2">Security Settings</h4>
          <p class="text-sm text-gray-700">Manage admin accounts, passwords, and security policies</p>
        </div>
        
        <div class="bg-blue-50 rounded-lg p-6 border border-blue-200">
          <div class="text-3xl mb-3">🎨</div>
          <h4 class="font-bold text-gray-800 mb-2">System Configuration</h4>
          <p class="text-sm text-gray-700">Configure system-wide settings and preferences</p>
        </div>
        
        <div class="bg-green-50 rounded-lg p-6 border border-green-300">
          <div class="text-3xl mb-3">📧</div>
          <h4 class="font-bold text-gray-800 mb-2">Notifications</h4>
          <p class="text-sm text-gray-700">Manage email notifications and alerts</p>
        </div>
      </div>

      <div class="mt-8">
        <a href="/admin/dashboard" class="bg-gradient-to-r from-teal-600 to-teal-500 hover:from-teal-700 hover:to-teal-600 text-white px-6 py-3 rounded-lg font-medium inline-block transition shadow-lg">
          Return to Dashboard
        </a>
      </div>
    </div>
  </div>
</body>
</html>
