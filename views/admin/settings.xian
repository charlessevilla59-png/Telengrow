<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - Tellngrow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4 sticky top-0 z-50">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-6">
        <a href="/admin/dashboard" class="text-gray-600 hover:text-gray-900">← Back to Dashboard</a>
        <h1 class="text-2xl font-bold text-gray-600">⚙️ Settings</h1>
      </div>
      <div class="space-x-4 flex items-center">
        <span class="text-gray-700">👤 {{user.name}}</span>
        <a href="/logout" class="text-gray-600 hover:text-gray-800 font-medium">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <div class="mb-8">
      <h2 class="text-3xl font-bold text-gray-900">Admin Settings</h2>
      <p class="text-gray-600 mt-1">Manage system settings and configurations</p>
    </div>

    <!-- Coming Soon Message -->
    <div class="bg-white rounded-xl shadow-lg p-12 text-center">
      <div class="text-8xl mb-6">⚙️</div>
      <h3 class="text-3xl font-bold text-gray-900 mb-4">Settings</h3>
      <p class="text-xl text-gray-600 mb-8">System settings and configuration options coming soon!</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto text-left">
        <div class="bg-purple-50 rounded-lg p-6">
          <div class="text-3xl mb-3">🔐</div>
          <h4 class="font-bold text-gray-900 mb-2">Security Settings</h4>
          <p class="text-sm text-gray-600">Manage admin accounts, passwords, and security policies</p>
        </div>
        
        <div class="bg-blue-50 rounded-lg p-6">
          <div class="text-3xl mb-3">🎨</div>
          <h4 class="font-bold text-gray-900 mb-2">System Configuration</h4>
          <p class="text-sm text-gray-600">Configure system-wide settings and preferences</p>
        </div>
        
        <div class="bg-green-50 rounded-lg p-6">
          <div class="text-3xl mb-3">📧</div>
          <h4 class="font-bold text-gray-900 mb-2">Notifications</h4>
          <p class="text-sm text-gray-600">Manage email notifications and alerts</p>
        </div>
      </div>

      <div class="mt-8">
        <a href="/admin/dashboard" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg font-medium inline-block transition">
          Return to Dashboard
        </a>
      </div>
    </div>
  </div>
</body>
</html>
