<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  {{> sidebar}}
  
  <nav class="bg-white shadow-md p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-purple-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <h1 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h1>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6 max-w-4xl">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-800">✏️ Edit Journal Entry</h1>
      <a href="/journal/{{entry.id}}" class="inline-flex items-center text-gray-600 hover:text-gray-700 transition">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Cancel
      </a>
    </div>
    
    {{#if success_msg}}
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        {{success_msg}}
      </div>
    {{/if}}
    {{#if error_msg}}
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        {{error_msg}}
      </div>
    {{/if}}
    
    <div class="bg-white rounded-xl shadow-md p-8">
      <form action="/journal/edit/{{entry.id}}" method="POST">
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Title</label>
          <input type="text" name="title" required value="{{entry.title}}"
                 class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                 placeholder="Give your entry a title...">
        </div>

        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">How are you feeling?</label>
          <div class="flex gap-4">
            <label class="cursor-pointer">
              <input type="radio" name="mood" value="happy" class="hidden peer" {{#ifEquals entry.mood "happy"}}checked{{/ifEquals}}>
              <div class="text-4xl peer-checked:scale-125 transition">😊</div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="mood" value="calm" class="hidden peer" {{#ifEquals entry.mood "calm"}}checked{{/ifEquals}}>
              <div class="text-4xl peer-checked:scale-125 transition">😌</div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="mood" value="neutral" class="hidden peer" {{#ifEquals entry.mood "neutral"}}checked{{/ifEquals}}>
              <div class="text-4xl peer-checked:scale-125 transition">😐</div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="mood" value="anxious" class="hidden peer" {{#ifEquals entry.mood "anxious"}}checked{{/ifEquals}}>
              <div class="text-4xl peer-checked:scale-125 transition">😰</div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="mood" value="sad" class="hidden peer" {{#ifEquals entry.mood "sad"}}checked{{/ifEquals}}>
              <div class="text-4xl peer-checked:scale-125 transition">😢</div>
            </label>
          </div>
        </div>

        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Your Thoughts</label>
          <textarea name="content" required rows="10"
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="Write your thoughts here...">{{entry.content}}</textarea>
        </div>

        <div class="flex gap-4">
          <button type="submit" 
                  class="flex-1 bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
            Save Changes
          </button>
          <a href="/journal/{{entry.id}}" 
             class="flex-1 bg-gray-200 text-gray-800 py-3 rounded-lg font-semibold hover:bg-gray-300 transition text-center">
            Cancel
          </a>
          <button type="button" onclick="confirmDelete()"
                  class="px-6 bg-red-600 text-white py-3 rounded-lg font-semibold hover:bg-red-700 transition">
            Delete
          </button>
        </div>
      </form>
      
      <!-- Hidden delete form -->
      <form id="deleteForm" action="/journal/delete/{{entry.id}}" method="POST" style="display: none;">
        <input type="hidden" name="_method" value="DELETE">
      </form>
      
      <script>
        function confirmDelete() {
          if (confirm('Are you sure you want to delete this journal entry? This action cannot be undone.')) {
            document.getElementById('deleteForm').submit();
          }
        }
      </script>
    </div>
  </div>
</body>
</html>
