<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  {{> sidebar}}
  
  <nav class="bg-white shadow-md p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-purple-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <h1 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h1>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6 max-w-4xl">
    {{#if entry}}
      <div class="bg-white rounded-xl shadow-md p-8">
        <div class="flex justify-between items-start mb-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">{{entry.title}}</h1>
            <p class="text-gray-500">{{dateFormatFull entry.createdAt}}</p>
          </div>
          <span class="text-5xl">
            {{#ifEquals entry.mood "happy"}}😊{{/ifEquals}}
            {{#ifEquals entry.mood "sad"}}😢{{/ifEquals}}
            {{#ifEquals entry.mood "anxious"}}😰{{/ifEquals}}
            {{#ifEquals entry.mood "calm"}}😌{{/ifEquals}}
            {{#ifEquals entry.mood "stressed"}}😫{{/ifEquals}}
            {{#ifEquals entry.mood "neutral"}}😐{{/ifEquals}}
          </span>
        </div>
        
        <div class="prose max-w-none mb-6">
          <p class="text-gray-700 whitespace-pre-wrap">{{entry.content}}</p>
        </div>
        
        <div class="border-t pt-4 flex justify-between items-center">
          <span class="text-sm text-gray-500">{{wordCount entry.content}} words</span>
          <div class="flex gap-3">
            <a href="/journal/edit/{{entry.id}}" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit
            </a>
            <button onclick="confirmDelete()" class="inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              Delete
            </button>
            <a href="/journal" class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition">
              ← Back to Library
            </a>
          </div>
        </div>
      </div>
      
      <!-- Hidden delete form -->
      <form id="deleteForm" action="/journal/delete/{{entry.id}}" method="POST" style="display: none;">
        <input type="hidden" name="_method" value="DELETE">
      </form>
      
      <script>
        function confirmDelete() {
          if (confirm('Are you sure you want to delete this journal entry? This action cannot be undone.')) {
            document.getElementById('deleteForm').submit();
          }
        }
      </script>
    {{else}}
      <div class="bg-white rounded-xl shadow-md p-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-4">Entry Not Found</h1>
        <p class="text-gray-600 mb-4">This journal entry doesn't exist or you don't have permission to view it.</p>
        <a href="/journal" class="text-green-600 hover:text-green-700 font-semibold">← Back to Journal</a>
      </div>
    {{/if}}
  </div>
</body>
</html>
