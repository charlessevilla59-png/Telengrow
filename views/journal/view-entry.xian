<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes slideInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    
    .animate-fade-in-down { animation: fadeInDown 0.6s ease-out; }
    .animate-slide-in-up { animation: slideInUp 0.6s ease-out; }
    
    .emotion-score-bar {
      background: linear-gradient(90deg, #10b981, #34d399);
      height: 8px;
      border-radius: 4px;
      transition: width 0.3s ease;
    }
    
    .emotion-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-weight: 600;
      font-size: 0.875rem;
    }

    .emotion-happy { background-color: #fef3c7; color: #92400e; border: 2px solid #fcd34d; }
    .emotion-sad { background-color: #dbeafe; color: #082f49; border: 2px solid #93c5fd; }
    .emotion-anxious { background-color: #fed7aa; color: #7c2d12; border: 2px solid #fdba74; }
    .emotion-calm { background-color: #dcfce7; color: #166534; border: 2px solid #86efac; }
    .emotion-angry { background-color: #fee2e2; color: #7f1d1d; border: 2px solid #fca5a5; }
    .emotion-neutral { background-color: #f3f4f6; color: #374151; border: 2px solid #d1d5db; }
  </style>
</head>
<body class="bg-gradient-to-br from-green-50 via-white to-emerald-50 min-h-screen">
  {{> sidebar}}
  
  <nav class="bg-white shadow-md p-4 sticky top-0 z-20">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-purple-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <h1 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h1>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6 max-w-4xl">
    {{#if entry}}
      <div class="animate-fade-in-down">
        <!-- Header Section -->
        <div class="bg-white rounded-xl shadow-lg p-8 mb-6">
          <div class="flex justify-between items-start mb-6">
            <div>
              <h1 class="text-4xl font-bold text-gray-800 mb-2">{{entry.title}}</h1>
              <p class="text-gray-500">📅 {{dateFormatFull entry.createdAt}}</p>
              <p class="text-gray-600 mt-2">
                <span class="inline-block bg-gray-100 px-3 py-1 rounded-full text-sm">
                  📝 {{entry.wordCount}} words
                </span>
              </p>
            </div>
            <div class="text-right">
              <div class="text-6xl mb-2">
                {{#ifEquals entry.mood "happy"}}😊{{/ifEquals}}
                {{#ifEquals entry.mood "sad"}}😢{{/ifEquals}}
                {{#ifEquals entry.mood "anxious"}}😰{{/ifEquals}}
                {{#ifEquals entry.mood "calm"}}😌{{/ifEquals}}
                {{#ifEquals entry.mood "stressed"}}😫{{/ifEquals}}
                {{#ifEquals entry.mood "neutral"}}😐{{/ifEquals}}
              </div>
              <p class="text-sm text-gray-600 capitalize">{{entry.mood}}</p>
            </div>
          </div>
        </div>

        <!-- AI Emotion Analysis Section -->
        {{#if entry.detectedEmotion}}
        <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl shadow-lg p-8 mb-6 border-2 border-purple-200 animate-slide-in-up">
          <div class="flex items-start justify-between mb-6">
            <div>
              <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                🤖 AI Emotion Analysis
              </h2>
              <p class="text-sm text-gray-600 mt-1">Advanced sentiment detection from your writing</p>
            </div>
            <div class="text-5xl">
              {{#ifEquals entry.detectedEmotion "happy"}}😊{{/ifEquals}}
              {{#ifEquals entry.detectedEmotion "sad"}}😢{{/ifEquals}}
              {{#ifEquals entry.detectedEmotion "anxious"}}😰{{/ifEquals}}
              {{#ifEquals entry.detectedEmotion "angry"}}😠{{/ifEquals}}
              {{#ifEquals entry.detectedEmotion "calm"}}😌{{/ifEquals}}
              {{#ifEquals entry.detectedEmotion "neutral"}}😐{{/ifEquals}}
            </div>
          </div>

          <!-- Detected Emotion Badge -->
          <div class="mb-6">
            <p class="text-sm font-semibold text-gray-700 mb-3">Detected Emotion:</p>
            <div class="flex gap-3 items-center flex-wrap">
              <span class="emotion-badge emotion-{{entry.detectedEmotion}}">
                {{#ifEquals entry.detectedEmotion "happy"}}😊 Happy ({{entry.emotionConfidence}}%){{/ifEquals}}
                {{#ifEquals entry.detectedEmotion "sad"}}😢 Sad ({{entry.emotionConfidence}}%){{/ifEquals}}
                {{#ifEquals entry.detectedEmotion "anxious"}}😰 Anxious ({{entry.emotionConfidence}}%){{/ifEquals}}
                {{#ifEquals entry.detectedEmotion "angry"}}😠 Angry ({{entry.emotionConfidence}}%){{/ifEquals}}
                {{#ifEquals entry.detectedEmotion "calm"}}😌 Calm ({{entry.emotionConfidence}}%){{/ifEquals}}
                {{#ifEquals entry.detectedEmotion "neutral"}}😐 Neutral ({{entry.emotionConfidence}}%){{/ifEquals}}
              </span>
              <span class="text-xs text-gray-600">
                Confidence: {{entry.emotionConfidence}}%
              </span>
            </div>
          </div>

          <!-- Analysis Text -->
          <div class="bg-white rounded-lg p-4 mb-6 border-l-4 border-purple-500">
            <p class="text-gray-700 font-medium">✨ {{entry.sentimentAnalysis}}</p>
          </div>

          <!-- Emotion Scores -->
          {{#if entry.emotionScores}}
          <div class="bg-white rounded-lg p-6">
            <p class="text-sm font-semibold text-gray-700 mb-4">📊 Emotion Distribution:</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <div class="flex justify-between mb-2">
                  <span class="text-sm font-medium text-gray-700">😊 Happy</span>
                  <span class="text-sm font-bold text-green-600">{{entry.emotionScores.happy}}%</span>
                </div>
                <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                  <div class="emotion-score-bar" style="width: {{entry.emotionScores.happy}}%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between mb-2">
                  <span class="text-sm font-medium text-gray-700">😢 Sad</span>
                  <span class="text-sm font-bold text-blue-600">{{entry.emotionScores.sad}}%</span>
                </div>
                <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                  <div class="emotion-score-bar" style="width: {{entry.emotionScores.sad}}%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between mb-2">
                  <span class="text-sm font-medium text-gray-700">😰 Anxious</span>
                  <span class="text-sm font-bold text-orange-600">{{entry.emotionScores.anxious}}%</span>
                </div>
                <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                  <div class="emotion-score-bar" style="width: {{entry.emotionScores.anxious}}%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between mb-2">
                  <span class="text-sm font-medium text-gray-700">😌 Calm</span>
                  <span class="text-sm font-bold text-emerald-600">{{entry.emotionScores.calm}}%</span>
                </div>
                <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                  <div class="emotion-score-bar" style="width: {{entry.emotionScores.calm}}%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between mb-2">
                  <span class="text-sm font-medium text-gray-700">😠 Angry</span>
                  <span class="text-sm font-bold text-red-600">{{entry.emotionScores.angry}}%</span>
                </div>
                <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                  <div class="emotion-score-bar" style="width: {{entry.emotionScores.angry}}%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between mb-2">
                  <span class="text-sm font-medium text-gray-700">😐 Neutral</span>
                  <span class="text-sm font-bold text-gray-600">{{entry.emotionScores.neutral}}%</span>
                </div>
                <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                  <div class="emotion-score-bar" style="width: {{entry.emotionScores.neutral}}%"></div>
                </div>
              </div>
            </div>
          </div>
          {{/if}}

          <!-- Sentiment Score -->
          {{#if entry.sentimentScore}}
          <div class="mt-6 p-4 bg-white rounded-lg border-l-4 border-indigo-500">
            <p class="text-xs text-gray-600 mb-2">Overall Sentiment:</p>
            <div class="flex items-center gap-3">
              <div class="flex-1 h-2 bg-gradient-to-r from-red-500 via-gray-300 to-green-500 rounded-full relative">
                <div class="absolute h-4 w-4 bg-white rounded-full shadow-lg" style="left: calc({{entry.sentimentScore}} + 50)%; transform: translateX(-50%); top: -6px;"></div>
              </div>
              <span class="text-sm font-bold whitespace-nowrap">
                {{#gt entry.sentimentScore 15}}
                  ✨ Positive ({{entry.sentimentScore}})
                {{else}}
                  {{#lt entry.sentimentScore -15}}
                    💔 Negative ({{entry.sentimentScore}})
                  {{else}}
                    😐 Neutral ({{entry.sentimentScore}})
                  {{/lt}}
                {{/gt}}
              </span>
            </div>
          </div>
          {{/if}}
        </div>
        {{/if}}

        <!-- Journal Content -->
        <div class="bg-white rounded-xl shadow-lg p-8 mb-6 prose prose-sm max-w-none">
          <div class="text-gray-700 whitespace-pre-wrap leading-relaxed">
            {{entry.content}}
          </div>
        </div>

        <!-- Actions Footer -->
        <div class="bg-white rounded-xl shadow-lg p-6 border-t-4 border-green-500">
          <div class="flex justify-between items-center flex-wrap gap-4">
            <span class="text-sm text-gray-600">
              {{entry.wordCount}} words • Updated {{dateFormatFull entry.updatedAt}}
            </span>
            <div class="flex gap-3 flex-wrap">
              <a href="/journal/edit/{{entry.id}}" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition shadow-md">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit
              </a>
              <button onclick="confirmDelete()" class="inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition shadow-md">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                Delete
              </button>
              <a href="/journal" class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition shadow-md">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Journal
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Hidden delete form -->
      <form id="deleteForm" action="/journal/delete/{{entry.id}}" method="POST" style="display: none;">
        <input type="hidden" name="_method" value="DELETE">
      </form>
      
      <script>
        function confirmDelete() {
          if (confirm('Are you sure you want to delete this journal entry? This action cannot be undone.')) {
            document.getElementById('deleteForm').submit();
          }
        }
      </script>
    {{else}}
      <div class="bg-white rounded-xl shadow-md p-8 text-center">
        <h1 class="text-3xl font-bold text-gray-800 mb-4">📭 Entry Not Found</h1>
        <p class="text-gray-600 mb-6">This journal entry doesn't exist or you don't have permission to view it.</p>
        <a href="/journal" class="inline-flex items-center px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Journal
        </a>
      </div>
    {{/if}}
  </div>
</body>
</html>
