<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
  <div class="bg-white rounded-lg shadow-lg border-2 border-gray-200 p-8 w-full max-w-md">
    <h1 class="text-3xl font-bold text-center mb-6 text-gray-900">Register</h1>
    
    {{#if error_msg}}
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      {{error_msg}}
    </div>
    {{/if}}
    
    <form action="/register" method="POST" autocomplete="off">
      <div class="mb-4">
        <label class="block text-gray-700 mb-2">Full Name</label>
        <input type="text" name="name" required autocomplete="off"
               class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-400">
      </div>
      
      <div class="mb-4">
        <label class="block text-gray-700 mb-2">Email</label>
        <input type="email" name="email" required autocomplete="off"
               class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-400">
      </div>
      
      <div class="mb-4">
        <label class="block text-gray-700 mb-2">Password</label>
        <input type="password" name="password" required minlength="6" autocomplete="new-password"
               class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-400">
      </div>
      
      <div class="mb-6">
        <label class="block text-gray-700 mb-2">Confirm Password</label>
        <input type="password" name="confirmPassword" required autocomplete="new-password"
               class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-400">
      </div>

      <!-- Counselor Checkbox -->
      <div class="mb-6 bg-emerald-50 border-2 border-emerald-200 rounded-lg p-4">
        <label class="flex items-start cursor-pointer">
          <input type="checkbox" name="isFaculty" value="true" id="facultyCheckbox"
                 class="mt-1 w-5 h-5 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500">
          <div class="ml-3">
            <span class="text-gray-900 font-semibold">I am a Counselor</span>
            <p class="text-sm text-gray-600 mt-1">
              Counselor accounts require admin approval before you can login. You will be notified once approved.
            </p>
          </div>
        </label>
      </div>
      
      <button type="submit" id="registerBtn"
              class="w-full bg-gray-900 text-white py-3 rounded-lg font-semibold hover:bg-gray-800 transition">
        Register
      </button>
      </button>
    </form>
    
    <div class="mt-4 text-center text-gray-600">
      Already have an account? <a href="/login" class="text-gray-900 hover:underline font-semibold">Login</a>
    </div>
  </div>

  <script>
    // Prevent form from clearing checkbox on load
    window.addEventListener('load', function() {
      const form = document.querySelector('form');
      const facultyCheckbox = document.getElementById('facultyCheckbox');
      
      // Save checkbox state
      const wasChecked = facultyCheckbox.checked;
      
      if (form) {
        // Clear text inputs only, not checkbox
        document.querySelectorAll('input[type="text"], input[type="email"], input[type="password"]').forEach(input => {
          input.value = '';
        });
      }
      
      // Restore checkbox state
      facultyCheckbox.checked = wasChecked;
    });

    // Log form data before submit
    document.querySelector('form').addEventListener('submit', function(e) {
      const facultyCheckbox = document.getElementById('facultyCheckbox');
      const formData = new FormData(this);
      
      console.log('=== FORM SUBMIT DEBUG ===');
      console.log('Checkbox checked:', facultyCheckbox.checked);
      console.log('Checkbox value:', facultyCheckbox.value);
      console.log('Form data isFaculty:', formData.get('isFaculty'));
      console.log('All form data:');
      for (let [key, value] of formData.entries()) {
        console.log(`  ${key}: ${value}`);
      }
      console.log('========================');
      
      // Don't prevent default - let form submit normally
    });

    // Also clear on focus to remove any persistent autofill
    document.querySelectorAll('input[type="email"], input[type="password"], input[type="text"]').forEach(input => {
      input.addEventListener('focus', function() {
        // If value looks like autofill (contains @gmail.com from previous session)
        if (this.value && this.name === 'email' && this.value.includes('@gmail.com')) {
          this.value = '';
        }
      });
    });
  </script>
</body>
</html>
