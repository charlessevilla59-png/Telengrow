      <!-- Why Choose Tellngrow -->
      <div>
        <h3 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="text-4xl">⭐</span> Why Choose Tellngrow?
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:border-blue-400 hover:shadow-md transition text-center">
            <span class="text-5xl block mb-3">🔒</span>
