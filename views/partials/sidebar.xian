          </div>
          <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:border-blue-400 hover:shadow-md transition text-center">
            <span class="text-5xl block mb-3">📊</span>
            <p class="font-bold text-gray-900">Data-Driven</p>
            <p class="text-xs text-gray-600 mt-1">Evidence-Based</p>
          </div>
          <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:border-blue-400 hover:shadow-md transition text-center">
            <span class="text-5xl block mb-3">🎯</span>
            <p class="font-bold text-gray-900">Results Focused</p>
            <p class="text-xs text-gray-600 mt-1">Measurable Progress</p>
          </div>
          <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:border-blue-400 hover:shadow-md transition text-center">
            <span class="text-5xl block mb-3">🌍</span>
            <p class="font-bold text-gray-900">Accessible</p>
            <p class="text-xs text-gray-600 mt-1">For Everyone</p>
          </div>
          <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:border-blue-400 hover:shadow-md transition text-center">
            <span class="text-5xl block mb-3">🚀</span>
            <p class="font-bold text-gray-900">Always Improving</p>
            <p class="text-xs text-gray-600 mt-1">Regular Updates</p>
