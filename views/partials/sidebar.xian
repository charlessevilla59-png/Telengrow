<!-- Overlay -->
<div id="overlay" class="overlay fixed inset-0 bg-black bg-opacity-50 z-40" onclick="closeSidebar()"></div>

<!-- Sidebar -->
<div id="sidebar" class="sidebar fixed left-0 top-0 h-full w-64 bg-white shadow-2xl z-50">
  <div class="p-6">
    <!-- Close Button -->
    <button onclick="closeSidebar()" class="absolute top-4 right-4 text-gray-500 hover:text-gray-700">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Logo -->
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h2>
      <p class="text-sm text-gray-500">Mental Wellness</p>
    </div>

    <!-- User Profile Section -->
    {{#if user}}
    <div class="mb-6 p-4 bg-purple-50 rounded-lg">
      <a href="/user/profile" class="flex items-center space-x-3 hover:opacity-80 transition">
        <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-purple-200 bg-white flex items-center justify-center flex-shrink-0">
          {{#if user.profilePicture}}
            {{#if (eq (substring user.profilePicture 0 1) "/")}}
              <img src="{{user.profilePicture}}" alt="Profile" class="w-full h-full object-cover" />
            {{else}}
              <span class="text-2xl">{{user.profilePicture}}</span>
            {{/if}}
          {{else}}
            <span class="text-2xl text-gray-400">👤</span>
          {{/if}}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-800 truncate">{{user.name}}</p>
          <p class="text-xs text-gray-500 truncate">{{user.email}}</p>
        </div>
      </a>
    </div>
    {{/if}}

    <!-- Menu Items -->
    <nav class="space-y-2">
      {{#eq user.role "counselor"}}
        <!-- COUNSELOR MENU -->
        <a href="/counselor/materials/new" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span class="font-medium">Create Material</span>
        </a>

        <a href="/counselor/messages" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-blue-50 text-gray-700 hover:text-blue-600 transition relative">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <span class="font-medium">Messages</span>
        </a>

        <a href="/counselor/students" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-green-50 text-gray-700 hover:text-green-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10a3 3 0 11-6 0 3 3 0 016 0zM18 20a6 6 0 11-12 0 6 6 0 0112 0z"></path>
          </svg>
          <span class="font-medium">Students Info</span>
        </a>

        <a href="/counselor/student-activity" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-orange-50 text-gray-700 hover:text-orange-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span class="font-medium">Students Activity</span>
        </a>
      {{else}}
        <!-- USER MENU -->
        <a href="/user/dashboard" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span class="font-medium">Home</span>
        </a>

        <a href="/games" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-medium">Games</span>
        </a>

        <a href="/journal" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span class="font-medium">Journal</span>
        </a>

        <a href="/reading" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span class="font-medium">Reading Materials</span>
        </a>

        <a href="/fitness-guide" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span class="font-medium">Fitness Guide</span>
        </a>

        <a href="/conversations" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-blue-50 text-gray-700 hover:text-blue-600 transition relative">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <span class="font-medium">Messages</span>
        </a>
      {{/eq}}

      <div class="border-t border-gray-200 my-4"></div>

      <a href="/logout" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-red-50 text-red-600 hover:text-red-700 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        <span class="font-medium">Logout</span>
      </a>
    </nav>
  </div>
</div>

<style>
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
  }
  .sidebar.open {
    transform: translateX(0);
  }
  .overlay {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-in-out;
  }
  .overlay.show {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<!-- About Modal - Enhanced with System Info -->
<div id="aboutModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50 p-4 backdrop-blur-sm">
  <div class="bg-white rounded-2xl shadow-2xl max-w-5xl w-full max-h-[95vh] overflow-y-auto transform transition-all duration-300">
    <!-- Header with Gradient -->
    <div class="sticky top-0 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white p-8">
      <div class="flex justify-between items-start gap-4">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
            <span class="text-4xl font-bold">T</span>
          </div>
          <div>
            <h2 class="text-4xl font-bold">Tellngrow</h2>
            <p class="text-blue-100 text-lg">Your Complete Mental Wellness Platform</p>
          </div>
        </div>
        <button onclick="closeAboutModal()" class="text-white hover:bg-white/20 rounded-lg p-2 transition flex-shrink-0 hover:scale-110">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Main Content -->
    <div class="p-8 space-y-8">
      <!-- Version & Status -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 border-l-4 border-blue-600 rounded-lg p-4 hover:shadow-md transition">
          <p class="text-sm text-gray-600 font-semibold uppercase tracking-wide">VERSION</p>
          <p class="text-3xl font-bold text-blue-600 mt-2">2.0.1</p>
          <p class="text-xs text-gray-600 mt-1">Latest Release</p>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-green-100 border-l-4 border-green-600 rounded-lg p-4 hover:shadow-md transition">
          <p class="text-sm text-gray-600 font-semibold uppercase tracking-wide">STATUS</p>
          <p class="text-3xl font-bold text-green-600 mt-2 flex items-center gap-2">
            <span class="w-3 h-3 bg-green-600 rounded-full animate-pulse"></span>Active
          </p>
          <p class="text-xs text-gray-600 mt-1">All Systems Online</p>
        </div>
        <div class="bg-gradient-to-br from-purple-50 to-purple-100 border-l-4 border-purple-600 rounded-lg p-4 hover:shadow-md transition">
          <p class="text-sm text-gray-600 font-semibold uppercase tracking-wide">BUILD</p>
          <p class="text-3xl font-bold text-purple-600 mt-2">Latest</p>
          <p class="text-xs text-gray-600 mt-1">Fully Updated</p>
        </div>
        <div class="bg-gradient-to-br from-amber-50 to-amber-100 border-l-4 border-amber-600 rounded-lg p-4 hover:shadow-md transition">
          <p class="text-sm text-gray-600 font-semibold uppercase tracking-wide">SECURITY</p>
          <p class="text-3xl font-bold text-amber-600 mt-2">🔒</p>
          <p class="text-xs text-gray-600 mt-1">Military Grade</p>
        </div>
      </div>

      <!-- Mission & Vision -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-gradient-to-br from-indigo-50 to-blue-50 border-2 border-indigo-200 rounded-xl p-6">
          <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
            <span class="text-3xl">🎯</span> Our Mission
          </h3>
          <p class="text-gray-700 leading-relaxed">
            Tellngrow is dedicated to providing evidence-based mental health tools and resources to help individuals achieve better emotional wellness and personal growth. We combine therapeutic expertise with innovative technology to create a comprehensive, accessible, and compassionate wellness platform.
          </p>
        </div>
        <div class="bg-gradient-to-br from-purple-50 to-pink-50 border-2 border-purple-200 rounded-xl p-6">
          <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
            <span class="text-3xl">🚀</span> Our Vision
          </h3>
          <p class="text-gray-700 leading-relaxed">
            To make mental health support accessible, affordable, and stigma-free for everyone. We envision a world where individuals can seamlessly integrate wellness practices into their daily lives through technology that truly understands their needs.
          </p>
        </div>
      </div>

      <!-- Core Features -->
      <div>
        <h3 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="text-4xl">✨</span> Core Features & Capabilities
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-xl p-6 hover:shadow-lg transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-4xl">🎮</span>
              <h4 class="text-lg font-bold text-gray-900">Therapeutic Games</h4>
            </div>
            <ul class="text-sm text-gray-700 space-y-2">
              <li>✓ Breathing Bubble (anxiety relief)</li>
              <li>✓ Color Tap (focus training)</li>
              <li>✓ Grid Memory (concentration)</li>
              <li>✓ Progressive difficulty levels</li>
              <li>✓ Real-time performance tracking</li>
            </ul>
          </div>
          <div class="bg-gradient-to-br from-blue-50 to-cyan-50 border-2 border-blue-200 rounded-xl p-6 hover:shadow-lg transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-4xl">📖</span>
              <h4 class="text-lg font-bold text-gray-900">Expert Resources</h4>
            </div>
            <ul class="text-sm text-gray-700 space-y-2">
              <li>✓ 100+ curated articles</li>
              <li>✓ Professional counselor reviews</li>
              <li>✓ Video guides & tutorials</li>
              <li>✓ Comments & discussions</li>
              <li>✓ Save & bookmark content</li>
            </ul>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-pink-50 border-2 border-purple-200 rounded-xl p-6 hover:shadow-lg transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-4xl">📔</span>
              <h4 class="text-lg font-bold text-gray-900">Personal Journaling</h4>
            </div>
            <ul class="text-sm text-gray-700 space-y-2">
              <li>✓ Daily mood tracking</li>
              <li>✓ Emotion analytics</li>
              <li>✓ Pattern recognition</li>
              <li>✓ Reflection prompts</li>
              <li>✓ Privacy encrypted storage</li>
            </ul>
          </div>
          <div class="bg-gradient-to-br from-amber-50 to-orange-50 border-2 border-amber-200 rounded-xl p-6 hover:shadow-lg transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-4xl">📊</span>
              <h4 class="text-lg font-bold text-gray-900">Health Analytics</h4>
            </div>
            <ul class="text-sm text-gray-700 space-y-2">
              <li>✓ Mood trends & insights</li>
              <li>✓ Progress dashboards</li>
              <li>✓ Streak tracking</li>
              <li>✓ Performance metrics</li>
              <li>✓ Weekly/Monthly reports</li>
            </ul>
          </div>
          <div class="bg-gradient-to-br from-red-50 to-rose-50 border-2 border-red-200 rounded-xl p-6 hover:shadow-lg transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-4xl">🔒</span>
              <h4 class="text-lg font-bold text-gray-900">Security & Privacy</h4>
            </div>
            <ul class="text-sm text-gray-700 space-y-2">
              <li>✓ HIPAA compliant</li>
              <li>✓ End-to-end encryption</li>
              <li>✓ Military-grade security</li>
              <li>✓ Data privacy controls</li>
              <li>✓ Regular security audits</li>
            </ul>
          </div>
          <div class="bg-gradient-to-br from-teal-50 to-cyan-50 border-2 border-teal-200 rounded-xl p-6 hover:shadow-lg transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-4xl">👥</span>
              <h4 class="text-lg font-bold text-gray-900">Community Support</h4>
            </div>
            <ul class="text-sm text-gray-700 space-y-2">
              <li>✓ Message counselors</li>
              <li>✓ Professional guidance</li>
              <li>✓ Community discussions</li>
              <li>✓ Peer support groups</li>
              <li>✓ Resource sharing</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Technology & Platform -->
      <div>
        <h3 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="text-4xl">⚙️</span> Technology & Platform
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-white border-2 border-gray-200 rounded-xl p-6 hover:border-blue-400 hover:shadow-md transition">
            <h4 class="font-bold text-gray-900 mb-4 text-lg">Backend Infrastructure</h4>
            <div class="space-y-2 text-sm text-gray-700">
              <p><span class="font-semibold">Runtime:</span> Node.js</p>
              <p><span class="font-semibold">Framework:</span> Express.js</p>
              <p><span class="font-semibold">Database:</span> MongoDB</p>
              <p><span class="font-semibold">Authentication:</span> JWT + Passport.js</p>
              <p><span class="font-semibold">Real-time:</span> Socket.io</p>
            </div>
          </div>
          <div class="bg-white border-2 border-gray-200 rounded-xl p-6 hover:border-blue-400 hover:shadow-md transition">
            <h4 class="font-bold text-gray-900 mb-4 text-lg">Frontend & Tools</h4>
            <div class="space-y-2 text-sm text-gray-700">
              <p><span class="font-semibold">UI Framework:</span> HTML5 + Handlebars</p>
              <p><span class="font-semibold">Styling:</span> Tailwind CSS</p>
              <p><span class="font-semibold">Face Detection:</span> Face.js API</p>
              <p><span class="font-semibold">Desktop:</span> Electron</p>
              <p><span class="font-semibold">Deployment:</span> Cloud-based</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Impact & Metrics -->
      <div class="bg-gradient-to-r from-indigo-600 via-blue-600 to-purple-600 text-white rounded-2xl p-8 shadow-lg">
        <h3 class="text-3xl font-bold mb-8 flex items-center gap-3">
          <span class="text-4xl">📈</span> Impact & Metrics
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
          <div class="text-center p-4 bg-white/10 rounded-lg backdrop-blur-sm hover:bg-white/20 transition">
            <p class="text-4xl font-bold mb-2">500+</p>
            <p class="text-indigo-100 text-sm font-semibold">Active Users</p>
          </div>
          <div class="text-center p-4 bg-white/10 rounded-lg backdrop-blur-sm hover:bg-white/20 transition">
            <p class="text-4xl font-bold mb-2">10K+</p>
            <p class="text-indigo-100 text-sm font-semibold">Games Played</p>
          </div>
          <div class="text-center p-4 bg-white/10 rounded-lg backdrop-blur-sm hover:bg-white/20 transition">
            <p class="text-4xl font-bold mb-2">5</p>
            <p class="text-indigo-100 text-sm font-semibold">Therapeutic Games</p>
          </div>
          <div class="text-center p-4 bg-white/10 rounded-lg backdrop-blur-sm hover:bg-white/20 transition">
            <p class="text-4xl font-bold mb-2">100+</p>
            <p class="text-indigo-100 text-sm font-semibold">Resources & Articles</p>
          </div>
          <div class="text-center p-4 bg-white/10 rounded-lg backdrop-blur-sm hover:bg-white/20 transition">
            <p class="text-4xl font-bold mb-2">24/7</p>
            <p class="text-indigo-100 text-sm font-semibold">Platform Uptime</p>
          </div>
        </div>
      </div>

      <!-- System Features -->
      <div>
        <h3 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="text-4xl">🛠️</span> System Features & Capabilities
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-3">
            <div class="flex items-start gap-3 p-4 bg-blue-50 border-l-4 border-blue-600 rounded-lg">
              <span class="text-2xl flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-gray-900">Real-time Notifications</p>
                <p class="text-sm text-gray-600">Instant updates via Socket.io</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-green-50 border-l-4 border-green-600 rounded-lg">
              <span class="text-2xl flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-gray-900">Multi-device Sync</p>
                <p class="text-sm text-gray-600">Seamless experience across devices</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-purple-50 border-l-4 border-purple-600 rounded-lg">
              <span class="text-2xl flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-gray-900">Advanced Analytics</p>
                <p class="text-sm text-gray-600">Data-driven wellness insights</p>
              </div>
            </div>
          </div>
          <div class="space-y-3">
            <div class="flex items-start gap-3 p-4 bg-amber-50 border-l-4 border-amber-600 rounded-lg">
              <span class="text-2xl flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-gray-900">Gamification System</p>
                <p class="text-sm text-gray-600">Badges, streaks, and achievements</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-red-50 border-l-4 border-red-600 rounded-lg">
              <span class="text-2xl flex-shrink-0">✓</span>
              <div>
                <p class="font-bold text-gray-900">Offline Support</p>
                <p class="text-sm text-gray-600">Works without internet connection</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-teal-50 border-l-4 border-teal-600 rounded-lg">
