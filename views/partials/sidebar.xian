            <button onclick="closeAboutModal(); openInfoModal('features');" class="w-full bg-gradient-to-r from-purple-600 to-purple-700 text-white font-bold py-3 rounded-lg hover:from-purple-700 hover:to-purple-800 transition transform hover:scale-105">
