      <!-- Disclaimer -->
      <div class="bg-gradient-to-r from-amber-50 to-yellow-50 border-2 border-amber-300 rounded-xl p-6">
        <p class="text-sm text-gray-800 flex items-start gap-3">
          <span class="text-3xl flex-shrink-0">⚠️</span>
