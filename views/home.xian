<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tell 'n Grow - Guidance & Counseling Platform</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }

    @keyframes glow {
      0%, 100% { box-shadow: 0 0 20px rgba(22, 163, 74, 0.3); }
      50% { box-shadow: 0 0 40px rgba(22, 163, 74, 0.5); }
    }

    @keyframes glowIntense {
      0%, 100% { box-shadow: 0 0 30px rgba(16, 185, 129, 0.4), 0 0 60px rgba(5, 150, 105, 0.2); }
      50% { box-shadow: 0 0 50px rgba(16, 185, 129, 0.6), 0 0 80px rgba(5, 150, 105, 0.3); }
    }

    @keyframes slideInDown {
      from {
        opacity: 0;
        transform: translateY(-30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes shimmer {
      0% { background-position: -1000px 0; }
      100% { background-position: 1000px 0; }
    }

    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.8; }
    }

    .float-animation {
      animation: float 4s ease-in-out infinite;
    }

    .animate-slide-down {
      animation: slideInDown 0.8s ease-out;
    }

    .animate-slide-up {
      animation: slideInUp 0.8s ease-out;
    }

    .animate-fade-in {
      animation: fadeIn 0.8s ease-out;
    }

    .glow-effect {
      animation: glow 3s ease-in-out infinite;
    }

    .glow-intense {
      animation: glowIntense 3s ease-in-out infinite;
    }

    .gradient-text {
      background: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .gradient-light {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.15));
    }

    .gradient-animated {
      background: linear-gradient(-45deg, #10b981, #059669, #047857, #06b6d4);
      background-size: 400% 400%;
      animation: gradientShift 15s ease infinite;
    }

    /* Glass morphism */
    .glass {
      background: rgba(255, 255, 255, 0.5);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .glass-green {
      background: rgba(16, 185, 129, 0.08);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(16, 185, 129, 0.2);
    }

    /* Feature card enhancements */
    .feature-card {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(240, 253, 244, 0.7));
      border: 2px solid rgba(16, 185, 129, 0.2);
      position: relative;
      overflow: hidden;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), transparent);
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .feature-card::after {
      content: '';
      position: absolute;
      top: -50%;
      right: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.2) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .feature-card:hover {
      transform: translateY(-12px);
      box-shadow: 0 20px 50px rgba(16, 185, 129, 0.3);
      border-color: rgba(16, 185, 129, 0.5);
      background: linear-gradient(135deg, rgba(240, 253, 244, 1), rgba(236, 253, 245, 1));
    }

    .feature-card:hover::before {
      opacity: 1;
    }

    .feature-card:hover::after {
      opacity: 1;
    }

    .feature-icon {
      width: 60px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      font-size: 32px;
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.15));
      border: 2px solid rgba(16, 185, 129, 0.3);
      transition: all 0.3s ease;
      position: relative;
    }

    .feature-card:hover .feature-icon {
      transform: scale(1.15) rotate(5deg);
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(5, 150, 105, 0.3));
      border-color: rgba(16, 185, 129, 0.5);
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.2);
    }

    /* Button enhancements */
    .btn-primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%);
      background-size: 200% 200%;
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.5s ease;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 40px rgba(16, 185, 129, 0.5);
      background-position: 200% center;
    }

    .btn-primary:hover::before {
      left: 100%;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(10px);
      border: 2px solid #10b981;
      color: #10b981;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-secondary:hover {
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.25);
      border-color: #059669;
      color: #059669;
    }

    /* Stat box enhancement */
    .stat-box {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(5, 150, 105, 0.08) 100%);
      border: 2px solid rgba(16, 185, 129, 0.25);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .stat-box::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .stat-box:hover {
      transform: translateY(-4px);
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(5, 150, 105, 0.15) 100%);
      box-shadow: 0 15px 35px rgba(16, 185, 129, 0.2);
      border-color: rgba(16, 185, 129, 0.4);
    }

    .stat-box:hover::before {
      opacity: 1;
    }

    /* Navigation link animation */
    .nav-link {
      position: relative;
      transition: color 0.3s ease;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, #10b981, #059669);
      transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-link:hover::after {
      width: 100%;
    }

    /* Section spacing */
    .bg-gradient-premium {
      background: linear-gradient(135deg, #065f46 0%, #047857 25%, #059669 50%, #10b981 75%, #059669 100%);
      background-size: 200% 200%;
      animation: gradientShift 20s ease infinite;
    }

    .bg-gradient-hero {
      background: linear-gradient(135deg, rgba(255,255,255,0.65) 0%, rgba(240,253,244,0.60) 50%, rgba(240,253,244,0.65) 100%),
                  url('/images/image.jpg');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    /* Decorative gradients */
    .decoration-gradient {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.1));
      position: relative;
    }

    /* Scrollbar styling */
    ::-webkit-scrollbar {
      width: 10px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #10b981, #059669);
      border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, #059669, #047857);
    }

    /* Enhanced shadows and glows */
    .shadow-glow-green {
      box-shadow: 0 10px 30px rgba(16, 185, 129, 0.2), 0 0 20px rgba(16, 185, 129, 0.1);
    }

    .shadow-glow-green-intense {
      box-shadow: 0 15px 40px rgba(16, 185, 129, 0.3), 0 0 30px rgba(16, 185, 129, 0.15);
    }

    /* Background with image and overlay */
    body {
      background-image: 
        linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(5, 150, 105, 0.08) 50%, rgba(4, 120, 87, 0.1) 100%),
        url('/images/image.jpg');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      background-color: white;
    }
    
    /* Sections with semi-transparent backgrounds */
    .section-container {
      background: linear-gradient(180deg, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.65) 50%, rgba(255,255,255,0.7) 100%);
    }
  </style>
</head>
<body class="bg-white">
  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-white backdrop-blur-xl border-b border-gray-200 shadow-lg">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
      <!-- Logo with Seal and Images -->
      <div class="flex items-center gap-3">
        <img src="/images/logo.jpg" alt="Tell 'n Grow" class="w-10 h-10 rounded-full border-2 border-green-600 shadow-md">
        <img src="/images/minsulogo.jpg" alt="Mindoro State University" class="w-10 h-10 rounded-full border-2 border-green-600 shadow-md">
        <div class="border-l border-gray-300 pl-3">
          <h1 class="text-xl font-bold text-gray-900">Tell 'n Grow</h1>
          <p class="text-xs text-gray-600">Guidance & Counseling Office</p>
        </div>
      </div>

      <!-- Links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#features" class="nav-link text-gray-700 hover:text-green-700 font-medium text-sm transition">Features</a>
        <a href="#how-it-works" class="nav-link text-gray-700 hover:text-green-700 font-medium text-sm transition">How It Works</a>
        <a href="#about" class="nav-link text-gray-700 hover:text-green-700 font-medium text-sm transition">About</a>
      </div>

      <!-- Auth buttons -->
      <div class="flex items-center gap-3">
        <a href="/login" class="text-gray-700 hover:text-green-700 font-semibold transition text-sm">Login</a>
        <a href="/register" class="btn-primary text-white px-6 py-2 rounded-lg font-semibold text-sm bg-gradient-to-r from-green-700 to-emerald-700 hover:shadow-lg transition">
          Get Started
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-hero text-gray-900 pt-20 pb-32">
    <!-- Decorative gradient overlays -->
    <div class="absolute top-0 left-0 w-full h-full pointer-events-none overflow-hidden">
      <div class="absolute top-10 left-10 w-96 h-96 bg-gradient-to-br from-emerald-300 to-transparent opacity-10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-gradient-to-tl from-green-300 to-transparent opacity-10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 right-1/4 w-80 h-80 bg-gradient-to-bl from-cyan-300 to-transparent opacity-5 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center pt-12">
        <!-- Left Column -->
        <div class="animate-fade-in">
          <!-- Main Heading -->
          <h1 class="text-5xl lg:text-6xl font-bold mb-8 leading-tight text-gray-900">
            Welcome to<br /><span class="text-6xl lg:text-7xl font-bold bg-gradient-to-r from-green-700 to-emerald-700 bg-clip-text text-transparent">Tell 'n Grow!</span>
          </h1>

          <!-- Subheading -->
          <p class="text-xl text-gray-800 mb-10 leading-relaxed font-semibold">
            Empowering mental health guidance, protecting student wellness, and streamlining counseling services—all in one secure, professional platform.
          </p>

          <!-- Features List -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
            <div class="flex items-start gap-3 bg-green-100 backdrop-blur-md rounded-lg p-3 border border-green-400 hover:bg-green-200 transition-all">
              <span class="text-green-700 font-bold text-xl">✓</span>
              <div>
                <p class="font-semibold text-gray-900">Professional Tools</p>
                <p class="text-sm text-gray-700">Counselor-grade features</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-green-100 backdrop-blur-md rounded-lg p-3 border border-green-400 hover:bg-green-200 transition-all">
              <span class="text-green-700 font-bold text-xl">✓</span>
              <div>
                <p class="font-semibold text-gray-900">Student Wellness</p>
                <p class="text-sm text-gray-700">Mental health tracking</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-green-100 backdrop-blur-md rounded-lg p-3 border border-green-400 hover:bg-green-200 transition-all">
              <span class="text-green-700 font-bold text-xl">✓</span>
              <div>
                <p class="font-semibold text-gray-900">Secure & Private</p>
                <p class="text-sm text-gray-700">Enterprise encryption</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-green-100 backdrop-blur-md rounded-lg p-3 border border-green-400 hover:bg-green-200 transition-all">
              <span class="text-green-700 font-bold text-xl">✓</span>
              <div>
                <p class="font-semibold text-gray-900">Real-Time Analytics</p>
                <p class="text-sm text-gray-700">Track progress instantly</p>
              </div>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/register" class="bg-gradient-to-r from-emerald-300 to-cyan-300 text-green-900 px-8 py-4 rounded-lg font-bold text-lg hover:from-emerald-200 hover:to-cyan-200 transition-all shadow-xl hover:shadow-2xl transform hover:scale-105">
              Create Account
            </a>
            <a href="/login" class="border-2 border-green-600 text-gray-900 px-8 py-4 rounded-lg font-bold text-lg hover:bg-green-100 transition-all backdrop-blur-sm hover:border-green-700">
              Login
            </a>
          </div>
        </div>

        <!-- Right Column -->
        <div class="animate-fade-in flex flex-col items-end justify-center gap-8 pr-12">
          <!-- MSU Logo -->
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-green-100 to-emerald-100 rounded-3xl blur-2xl opacity-50"></div>
            <img src="/images/minsulogo.jpg" alt="Mindoro State University" class="relative w-72 h-72 rounded-3xl border-4 border-green-600 shadow-2xl object-cover">
          </div>

          <!-- Institutional Info -->
          <div class="text-center">
            <h3 class="text-3xl font-bold text-gray-900 mb-2">Mindoro State University</h3>
            <p class="text-xl text-gray-700 font-semibold">Guidance and Counseling Office</p>
          </div>
        </div>

  </section>

  <!-- Features Section - Modern Card Design -->
  <section id="features" class="py-28 bg-gradient-premium relative">
    <!-- Decorative gradients -->
    <div class="absolute top-0 left-0 w-full h-full pointer-events-none overflow-hidden">
      <div class="absolute top-20 right-20 w-72 h-72 bg-gradient-to-bl from-emerald-200 to-transparent opacity-10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-10 w-80 h-80 bg-gradient-to-tr from-green-200 to-transparent opacity-10 rounded-full blur-3xl"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 relative">
      <!-- Section Header -->
      <div class="text-center mb-20">
        <div class="inline-flex items-center bg-green-100 border-2 border-green-400 rounded-full px-4 py-2 mb-4 shadow-md">
          <span class="text-sm font-semibold text-green-700">🚀 CORE FEATURES</span>
        </div>
        <h2 class="text-5xl font-bold text-gray-900 mb-6">
          Everything You Need for <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-600 via-emerald-600 to-cyan-600">Professional Counseling</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Designed by educators and counselors for real-world mental health support
        </p>
      </div>

      <!-- Features Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Feature Card 1 -->
        <div class="feature-card rounded-2xl p-8 shadow-lg hover:shadow-2xl">
          <div class="w-14 h-14 bg-gradient-to-br from-green-100 to-emerald-100 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-md">
            <span class="text-3xl">🎮</span>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Therapeutic Games</h3>
          <p class="text-gray-600 mb-6">Evidence-based interactive games designed to improve focus, emotional regulation, and stress management for students.</p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Clinically validated</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Progress tracking</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Personalized content</span>
            </li>
          </ul>
        </div>

        <!-- Feature Card 2 -->
        <div class="feature-card rounded-2xl p-8 shadow-lg hover:shadow-2xl">
          <div class="w-14 h-14 bg-gradient-to-br from-cyan-100 to-blue-100 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-md">
            <span class="text-3xl">📚</span>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Expert Materials</h3>
          <p class="text-gray-600 mb-6">Comprehensive reading materials and professional articles curated by licensed counselors and health experts.</p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Licensed review</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">CBT-based content</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Regularly updated</span>
            </li>
          </ul>
        </div>

        <!-- Feature Card 3 -->
        <div class="feature-card rounded-2xl p-8 shadow-lg hover:shadow-2xl">
          <div class="w-14 h-14 bg-gradient-to-br from-purple-100 to-pink-100 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-md">
            <span class="text-3xl">📔</span>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Secure Journaling</h3>
          <p class="text-gray-600 mb-6">Private encrypted journal space for students to safely document emotions, thoughts, and personal growth journey.</p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">End-to-end encrypted</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Privacy guaranteed</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Analytics included</span>
            </li>
          </ul>
        </div>

        <!-- Feature Card 4 -->
        <div class="feature-card rounded-2xl p-8 shadow-lg hover:shadow-2xl">
          <div class="w-14 h-14 bg-gradient-to-br from-yellow-100 to-orange-100 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-md">
            <span class="text-3xl">📊</span>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Mood Tracking</h3>
          <p class="text-gray-600 mb-6">Real-time mood analytics and emotional health metrics with detailed insights for both counselors and students.</p>
          <ul class="space-y-3">
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Real-time insights</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Trend analysis</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></span>
              <span class="text-sm text-gray-700">Export reports</span>
            </li>
          </ul>
        </div>

        <!-- Feature Card 5 -->
        <div class="feature-card rounded-2xl p-8 shadow-lg hover:shadow-2xl">
          <div class="w-14 h-14 bg-gradient-to-br from-red-100 to-pink-100 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-md">
            <span class="text-3xl">💬</span>
          </div>
