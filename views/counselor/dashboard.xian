<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in-down { animation: fadeInDown 0.6s ease-out; }
    .animate-fade-in-up { animation: fadeInUp 0.6s ease-out; }

    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s ease-in-out;
    }
    .sidebar.open {
      transform: translateX(0);
    }
    .overlay {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease-in-out;
    }
    .overlay.show {
      opacity: 1;
      pointer-events: auto;
    }
    
    .stat-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      transition: all 0.3s ease;
    }
    
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px rgba(22, 163, 74, 0.1);
      border-color: #16a34a;
    }

    .progress-bar {
      background: linear-gradient(90deg, #16a34a 0%, #10b981 100%);
      border-radius: 8px;
      height: 6px;
      overflow: hidden;
    }

    .action-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      transition: all 0.3s ease;
    }

    .action-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px rgba(22, 163, 74, 0.1);
      border-color: #16a34a;
    }

    .quick-link {
      background: #ffffff;
      border-left: 4px solid #16a34a;
      transition: all 0.3s ease;
    }

    .quick-link:hover {
      transform: translateX(4px);
      box-shadow: 0 8px 15px rgba(22, 163, 74, 0.1);
    }

    .navbar-clean {
      background: #ffffff;
      border-bottom: 2px solid #16a34a;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .stat-value {
      font-size: 2.5rem;
      font-weight: 700;
      color: #1f2937;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Overlay -->
  <div id="overlay" class="overlay fixed inset-0 bg-black bg-opacity-50 z-40" onclick="closeSidebar()"></div>

  <!-- Sidebar -->
  {{> sidebar}}

  <!-- Top Navigation -->
  <nav class="navbar-clean sticky top-0 z-30">
    <div class="container mx-auto flex justify-between items-center px-6 py-3">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-green-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <img src="/images/logo.jpg" alt="Tell 'n Grow" class="h-10 w-10">
        <h1 class="text-2xl font-bold text-green-600">Tellngrow</h1>
      </div>
      <div class="flex items-center space-x-4">
        <div class="hidden md:block text-right">
          <p class="text-sm font-semibold text-gray-900">{{user.name}}</p>
          <p class="text-xs text-gray-500">Counselor</p>
        </div>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6 md:p-8">
    <!-- Welcome Header -->
    <div class="mb-12 animate-fade-in-down">
      <h1 class="text-5xl md:text-5xl font-bold text-gray-900 mb-2">Welcome back, <span class="text-green-600">{{user.name}}</span></h1>
      <p class="text-lg text-gray-600">Manage your educational materials and track student engagement</p>
    </div>

    <!-- Main Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <!-- Total Materials Card -->
      <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.1s;">
        <div class="mb-4">
          <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Total Materials</p>
          <p class="text-4xl font-bold text-gray-900 mt-2" data-stat="total">{{stats.totalMaterials}}</p>
        </div>
        <div class="text-gray-500 text-xs font-medium">Created for students</div>
        <div class="progress-bar mt-3" style="width: 60%;"></div>
      </div>

      <!-- Published Materials Card -->
      <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="mb-4">
          <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Published</p>
          <p class="text-4xl font-bold text-gray-900 mt-2" data-stat="published">{{stats.publishedMaterials}}</p>
        </div>
        <div class="text-gray-500 text-xs font-medium">Ready for students</div>
        <div class="progress-bar mt-3" style="width: 70%;"></div>
      </div>

      <!-- Total Views Card -->
      <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.3s;">
        <div class="mb-4">
          <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Total Views</p>
          <p class="text-4xl font-bold text-gray-900 mt-2" data-stat="views">{{stats.totalViews}}</p>
        </div>
        <div class="text-gray-500 text-xs font-medium">Student engagement</div>
        <div class="progress-bar mt-3" style="width: 45%;"></div>
      </div>

      <!-- Total Comments Card -->
      <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.4s;">
        <div class="mb-4">
          <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Total Comments</p>
          <p class="text-4xl font-bold text-gray-900 mt-2" id="totalComments" data-stat="comments">{{stats.totalComments}}</p>
        </div>
        <div class="text-gray-500 text-xs font-medium">Student feedback & engagement</div>
        <div class="progress-bar mt-3" style="width: 65%;"></div>
      </div>
    </div>

    <!-- Main Content Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <!-- Left Column - Materials & Actions -->
      <div class="lg:col-span-2">
        <!-- Quick Actions Section -->
        <div class="mb-12">
          <div class="mb-8 animate-fade-in-down">
            <h2 class="text-3xl font-bold text-gray-900">Quick Actions</h2>
            <p class="text-gray-600 text-lg mt-2">Manage your content and communications</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <a href="/counselor/materials/new" class="action-card rounded-xl p-6 block group">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-lg text-gray-900 group-hover:text-green-600 transition">Create Material</h3>
                <span class="text-2xl">➕</span>
              </div>
              <p class="text-sm text-gray-600 mb-5">Add new educational content for your students</p>
              <div class="text-green-600 font-medium text-sm">Create Now →</div>
            </a>

            <a href="/counselor/materials" class="action-card rounded-xl p-6 block group">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-lg text-gray-900 group-hover:text-green-600 transition">Manage Materials</h3>
                <span class="text-2xl">📚</span>
              </div>
              <p class="text-sm text-gray-600 mb-5">View, edit, or publish your materials</p>
              <div class="text-green-600 font-medium text-sm">Manage Now →</div>
            </a>

            <a href="/counselor/messages" class="action-card rounded-xl p-6 block group">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-lg text-gray-900 group-hover:text-green-600 transition">Messages</h3>
                <span class="text-2xl">💬</span>
              </div>
              <p class="text-sm text-gray-600 mb-5">Connect with students in real-time</p>
              <div class="text-green-600 font-medium text-sm">Open Messages →</div>
            </a>

            <a href="/counselor/analytics" class="action-card rounded-xl p-6 block group">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-lg text-gray-900 group-hover:text-green-600 transition">Analytics</h3>
                <span class="text-2xl">📊</span>
              </div>
              <p class="text-sm text-gray-600 mb-5">Review performance insights and trends</p>
              <div class="text-green-600 font-medium text-sm">View Analytics →</div>
            </a>

            <a href="/counselor/students" class="action-card rounded-xl p-6 block group">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-lg text-gray-900 group-hover:text-green-600 transition">Students Info</h3>
                <span class="text-2xl">👥</span>
              </div>
              <p class="text-sm text-gray-600 mb-5">View all student information and details</p>
              <div class="text-green-600 font-medium text-sm">View Students →</div>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column - Resources and Info -->
      <div class="lg:col-span-1">

        <!-- Student Engagement -->
        <div class="mb-8">
          <div class="mb-4 animate-fade-in-down">
            <h2 class="text-2xl font-bold text-gray-900">Engagement Overview</h2>
          </div>
          <div class="action-card rounded-xl p-6 border border-green-600 border-t-4 border-t-green-600 animate-fade-in-up">
            <div class="space-y-6">
              <div>
                <div class="flex justify-between text-sm mb-3">
                  <span class="text-gray-900 font-bold">Material Completion</span>
                  <span class="text-green-600 font-bold">{{engagement.materialCompletion}}%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full" style="width: {{engagement.materialCompletion}}%;"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-sm mb-3">
                  <span class="text-gray-900 font-bold">Student Participation</span>
                  <span class="text-green-600 font-bold">{{engagement.studentParticipation}}%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full" style="width: {{engagement.studentParticipation}}%;"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-sm mb-3">
                  <span class="text-gray-900 font-bold">Comments & Reactions</span>
                  <span class="text-green-600 font-bold">{{engagement.commentsAndReactions}}</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full" style="width: {{#if (gt engagement.commentsAndReactions 0)}}65{{else}}0{{/if}}%;"></div>
                </div>
              </div>

              <div class="border-t border-gray-200 pt-6">
                <h3 class="font-bold text-gray-900 mb-3">This Week</h3>
                <div class="space-y-3 text-sm">
                  <div class="flex justify-between">
                    <span class="text-gray-600">New Messages</span>
                    <span class="font-bold text-green-600">{{engagement.newMessagesThisWeek}}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600">Material Views</span>
                    <span class="font-bold text-green-600">{{engagement.materialViewsThisWeek}}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600">Active Students</span>
                    <span class="font-bold text-green-600">{{engagement.activeStudentsThisWeek}}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>


      </div>
    </div>
  </div>

  <script>

    function openSidebar() {
      document.querySelector('.sidebar').classList.add('open');
      document.getElementById('overlay').classList.add('show');
    }

    function closeSidebar() {
      document.querySelector('.sidebar').classList.remove('open');
      document.getElementById('overlay').classList.remove('show');
    }

    // Auto-open sidebar when cursor moves to left edge
    let sidebarOpenTimeout;
    document.addEventListener('mousemove', function(e) {
      // If cursor is within 30px from left edge, open sidebar
      if (e.clientX < 30) {
        if (!sidebarOpenTimeout) {
          sidebarOpenTimeout = setTimeout(() => {
            const sidebar = document.querySelector('.sidebar');
            if (sidebar && !sidebar.classList.contains('open')) {
              openSidebar();
            }
          }, 300); // 300ms delay to prevent accidental triggers
        }
      } else {
        // Clear timeout if cursor moves away
        if (sidebarOpenTimeout) {
          clearTimeout(sidebarOpenTimeout);
          sidebarOpenTimeout = null;
        }
      }
    });

    // Page initialization
    document.addEventListener('DOMContentLoaded', () => {
      // Initialization code here
    });
  </script>
</body>
</html>
