<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Counselor</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/counselor/dashboard" class="text-2xl font-bold text-emerald-600 hover:text-emerald-700">🌱 Tellngrow Counselor</a>
      </div>
      <div class="space-x-4 flex items-center">
        <a href="/counselor/dashboard" class="text-gray-600 hover:text-gray-800">Dashboard</a>
        <span class="text-gray-700">👨‍💼 {{user.name}}</span>
        <a href="/logout" class="text-gray-600 hover:text-gray-800 font-medium">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6 max-w-4xl">
    <div class="mb-6">
      <h2 class="text-3xl font-bold text-gray-900">Add New Reading Material</h2>
      <p class="text-gray-600 mt-1">Create educational content for students</p>
    </div>

    <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
      <form action="/counselor/materials/create" method="POST" enctype="multipart/form-data">
        <!-- Material Type -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Material Type</label>
          <select name="fileType" id="fileType" required onchange="toggleContentType()"
                  class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">
            <option value="article">Article (Text Content)</option>
            <option value="pdf">PDF Document</option>
            <option value="document">Other Document</option>
          </select>
        </div>

        <!-- Title -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Title</label>
          <input type="text" name="title" required
                 class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500"
                 placeholder="e.g., Understanding Stress Management">
        </div>

        <!-- Category -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Category</label>
          <select name="category" required
                  class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">
            <option value="">Select a category</option>
            <option value="Mental Health">Mental Health</option>
            <option value="Stress Management">Stress Management</option>
            <option value="Anxiety">Anxiety</option>
            <option value="Wellness">Wellness</option>
            <option value="Self-Care">Self-Care</option>
            <option value="Mindfulness">Mindfulness</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <!-- Excerpt -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Short Description</label>
          <textarea name="excerpt" rows="3" required
                    class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500"
                    placeholder="Brief summary of the material (2-3 sentences)"></textarea>
        </div>

        <!-- File Upload (for PDF/Document) -->
        <div id="fileUploadSection" class="mb-6 hidden">
          <label class="block text-gray-700 font-semibold mb-2">Upload File</label>
          <input type="file" name="materialFile" accept=".pdf,.doc,.docx"
                 class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">
          <p class="text-sm text-gray-500 mt-1">Accepted formats: PDF, DOC, DOCX (Max 10MB)</p>
        </div>

        <!-- Content (for Article) -->
        <div id="contentSection" class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Content</label>
          <textarea name="content" rows="15"
                    class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500"
                    placeholder="Write your full article content here..."></textarea>
          <p class="text-sm text-gray-500 mt-1">You can use paragraphs, lists, and basic formatting</p>
        </div>

        <!-- Reading Time -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Estimated Reading Time (minutes)</label>
          <input type="number" name="readingTime" min="1" max="60" value="5" required
                 class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">
        </div>

        <!-- Publish Status -->
        <div class="mb-6">
          <label class="flex items-center cursor-pointer">
            <input type="checkbox" name="isPublished" value="true"
                   class="w-5 h-5 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500">
            <span class="ml-3 text-gray-700 font-semibold">Publish immediately</span>
          </label>
          <p class="text-sm text-gray-500 mt-1">If unchecked, material will be saved as draft</p>
        </div>

        <!-- Buttons -->
        <div class="flex gap-4">
          <button type="submit"
                  class="flex-1 bg-emerald-600 text-white py-3 rounded-lg font-semibold hover:bg-emerald-700 transition">
            Create Material
          </button>
          <a href="/counselor/dashboard"
             class="flex-1 bg-gray-200 text-gray-700 py-3 rounded-lg font-semibold hover:bg-gray-300 transition text-center">
            Cancel
          </a>
        </div>
      </form>
    </div>

    <!-- Tips -->
    <div class="mt-6 bg-blue-50 border-2 border-blue-200 rounded-lg p-4">
      <h3 class="font-bold text-blue-900 mb-2">💡 Tips for Creating Great Content:</h3>
      <ul class="text-sm text-blue-800 space-y-1">
        <li>• <strong>Articles:</strong> Write directly in the content area</li>
        <li>• <strong>PDFs:</strong> Upload existing documents, books, or guides</li>
        <li>• <strong>Documents:</strong> Upload Word files or other formats</li>
        <li>• Use clear, simple language that students can understand</li>
        <li>• Keep file sizes under 10MB for faster loading</li>
      </ul>
    </div>
  </div>

  <script>
    function toggleContentType() {
      const fileType = document.getElementById('fileType').value;
      const fileUploadSection = document.getElementById('fileUploadSection');
      const contentSection = document.getElementById('contentSection');
      const contentTextarea = contentSection.querySelector('textarea');
      const fileInput = fileUploadSection.querySelector('input[type="file"]');
      
      if (fileType === 'article') {
        fileUploadSection.classList.add('hidden');
        contentSection.classList.remove('hidden');
        contentTextarea.required = true;
        fileInput.required = false;
      } else {
        fileUploadSection.classList.remove('hidden');
        contentSection.classList.add('hidden');
        contentTextarea.required = false;
        fileInput.required = true;
      }
    }
  </script>
</body>
</html>
