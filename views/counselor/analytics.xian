<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Counselor</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/counselor/dashboard" class="text-2xl font-bold text-emerald-600 hover:text-emerald-700">🌱 Tellngrow Counselor</a>
      </div>
      <div class="space-x-4 flex items-center">
        <a href="/counselor/dashboard" class="text-gray-600 hover:text-gray-800">Dashboard</a>
        <span class="text-gray-700">👨‍💼 {{user.name}}</span>
        <a href="/logout" class="text-gray-600 hover:text-gray-800 font-medium">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <div class="mb-6">
      <h2 class="text-3xl font-bold text-gray-900">Analytics</h2>
      <p class="text-gray-600 mt-1">View statistics about your materials</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
        <div class="text-4xl mb-2">📚</div>
        <div class="text-3xl font-bold text-gray-900">{{stats.totalMaterials}}</div>
        <div class="text-sm text-gray-600">Total Materials</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
        <div class="text-4xl mb-2">✅</div>
        <div class="text-3xl font-bold text-gray-900">{{stats.publishedMaterials}}</div>
        <div class="text-sm text-gray-600">Published</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
        <div class="text-4xl mb-2">👁️</div>
        <div class="text-3xl font-bold text-gray-900">{{stats.totalViews}}</div>
        <div class="text-sm text-gray-600">Total Views</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
        <div class="text-4xl mb-2">⭐</div>
        <div class="text-3xl font-bold text-gray-900">{{stats.avgRating}}</div>
        <div class="text-sm text-gray-600">Avg. Rating</div>
      </div>
    </div>

    <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
      {{#if stats.totalMaterials}}
      <div class="text-center text-gray-700 py-8">
        <div class="text-5xl mb-4">📊</div>
        <h3 class="text-xl font-bold mb-2">Analytics Dashboard</h3>
        <p class="text-gray-600 mb-4">Your materials have been viewed {{stats.totalViews}} times</p>
        <a href="/counselor/materials" class="inline-block bg-emerald-600 text-white px-6 py-2 rounded-lg hover:bg-emerald-700 transition">
          View All Materials
        </a>
      </div>
      {{else}}
      <div class="text-center text-gray-500 py-12">
        <div class="text-6xl mb-4">📊</div>
        <h3 class="text-xl font-bold text-gray-700 mb-2">No Data Yet</h3>
        <p class="text-gray-600 mb-6">Create and publish materials to see analytics</p>
        <a href="/counselor/materials/new" class="inline-block bg-emerald-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-emerald-700 transition">
          Create Material
        </a>
      </div>
      {{/if}}
    </div>
  </div>
</body>
</html>
