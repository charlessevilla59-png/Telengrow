<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Counselor</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-fade-in-down { animation: fadeInDown 0.6s ease-out; }
    .animate-fade-in-up { animation: fadeInUp 0.6s ease-out; }
    
    .material-card {
      animation: fadeInUp 0.6s ease-out backwards;
      transition: all 0.3s ease;
    }
    .material-card:nth-child(1) { animation-delay: 0.1s; }
    .material-card:nth-child(2) { animation-delay: 0.2s; }
    .material-card:nth-child(3) { animation-delay: 0.3s; }
    .material-card:nth-child(4) { animation-delay: 0.4s; }
    .material-card:nth-child(5) { animation-delay: 0.5s; }
    .material-card:nth-child(n+6) { animation-delay: 0.6s; }
    
    .material-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
    }
    
    .material-card:hover {
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      border-color: #d1d5db;
    }

    .stat-mini {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(16, 185, 129, 0.02) 100%);
      border-left: 4px solid #10b981;
      padding: 1rem;
      border-radius: 0.5rem;
    }

    /* Modal Styles */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 50;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease-out;
    }

    .modal-overlay.active {
      display: flex !important;
      opacity: 1;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .modal-content {
      background: white;
      border-radius: 0.75rem;
      max-width: 800px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      animation: slideUp 0.3s ease-out;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .reaction-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background-color: #f3f4f6;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .reaction-badge:hover {
      background-color: #e5e7eb;
      transform: scale(1.05);
    }

    .comment-item {
      border-left: 3px solid #10b981;
      padding: 1rem;
      background-color: #f9fafb;
      border-radius: 0.5rem;
      transition: all 0.2s ease;
    }

    .comment-item:hover {
      background-color: #f3f4f6;
      border-left-color: #059669;
    }

    .engagement-stats {
      display: flex;
      gap: 1rem;
      padding: 1rem;
      background-color: #f3f4f6;
      border-radius: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .engagement-stat {
      flex: 1;
      text-align: center;
      border-right: 1px solid #d1d5db;
    }

    .engagement-stat:last-child {
      border-right: none;
    }

    .engagement-stat-value {
      font-size: 1.5rem;
      font-weight: bold;
      color: #10b981;
    }

    .engagement-stat-label {
      font-size: 0.75rem;
      color: #6b7280;
      text-transform: uppercase;
      margin-top: 0.25rem;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">
  <!-- Navigation -->
  <nav class="navbar sticky top-0 z-50">
    <div class="container mx-auto flex justify-between items-center px-6 py-4">
      <div class="flex items-center space-x-4">
        <a href="/counselor/dashboard" class="text-2xl font-bold text-emerald-600 hover:text-emerald-700 transition">📚 Tellngrow Counselor</a>
      </div>
      <div class="space-x-6 flex items-center text-gray-700">
        <a href="/counselor/dashboard" class="hover:text-emerald-600 transition font-medium">Dashboard</a>
        <a href="/counselor/analytics" class="hover:text-emerald-600 transition font-medium">Analytics</a>
        <span class="text-gray-500">|</span>
        <span>👨‍💼 <span class="font-semibold">{{user.name}}</span></span>
        <a href="/logout" class="text-red-600 hover:text-red-700 transition font-medium">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="container mx-auto px-6 py-12">
    <!-- Header Section -->
    <div class="mb-10 animate-fade-in-down">
      <div class="flex justify-between items-start gap-6 mb-8">
        <div>
          <h1 class="text-5xl font-bold text-gray-900 mb-2">📚 Your Materials</h1>
          <p class="text-lg text-gray-600">Manage and share educational content with students</p>
          <div class="w-24 h-1 bg-gradient-to-r from-emerald-500 to-green-500 rounded-full mt-4"></div>
        </div>
        <a href="/counselor/materials/new" class="bg-gradient-to-r from-emerald-600 to-green-600 text-white px-8 py-4 rounded-lg font-bold hover:shadow-lg transition flex items-center gap-2 duration-300 flex-shrink-0">
          <span>➕</span> Create Material
        </a>
      </div>

      <!-- Stats Overview -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="stat-mini">
          <p class="text-xs font-semibold text-gray-600 uppercase">Total Materials</p>
          <p class="text-2xl font-bold text-gray-900 mt-1">{{totalCount}}</p>
        </div>
        <div class="stat-mini">
          <p class="text-xs font-semibold text-gray-600 uppercase">Published</p>
          <p class="text-2xl font-bold text-green-600 mt-1">{{publishedCount}}</p>
        </div>
        <div class="stat-mini">
          <p class="text-xs font-semibold text-gray-600 uppercase">Videos</p>
          <p class="text-2xl font-bold text-blue-600 mt-1">{{videoCount}}</p>
        </div>
        <div class="stat-mini">
          <p class="text-xs font-semibold text-gray-600 uppercase">PDFs</p>
          <p class="text-2xl font-bold text-red-600 mt-1">{{pdfCount}}</p>
        </div>
      </div>
    </div>

    {{#if materials.length}}
      <!-- Filter Section -->
      <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-8 animate-fade-in-up">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-bold text-lg text-gray-900">🔍 Filter Materials</h3>
          <button onclick="window.resetFilters()" class="text-sm text-emerald-600 hover:text-emerald-700 font-semibold">Reset Filters</button>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Status Filter -->
          <div>
            <label class="text-sm font-semibold text-gray-700 block mb-2">Status</label>
            <div class="flex gap-2">
              <button class="filter-btn active flex-1 px-3 py-2 rounded-lg" onclick="window.filterByStatus('all')">
                All
              </button>
              <button class="filter-btn flex-1 px-3 py-2 rounded-lg" onclick="window.filterByStatus('published')">
                Published
              </button>
              <button class="filter-btn flex-1 px-3 py-2 rounded-lg" onclick="window.filterByStatus('draft')">
                Draft
              </button>
            </div>
          </div>

          <!-- Type Filter -->
          <div>
            <label class="text-sm font-semibold text-gray-700 block mb-2">Content Type</label>
            <div class="flex gap-2">
              <button class="filter-btn active flex-1 px-3 py-2 rounded-lg" onclick="window.filterByType('all')">
                All
              </button>
              <button class="filter-btn flex-1 px-3 py-2 rounded-lg" onclick="window.filterByType('video')">
                🎥 Video
              </button>
              <button class="filter-btn flex-1 px-3 py-2 rounded-lg" onclick="window.filterByType('pdf')">
                📄 PDF
              </button>
              <button class="filter-btn flex-1 px-3 py-2 rounded-lg" onclick="window.filterByType('article')">
                📝 Article
              </button>
            </div>
          </div>

          <!-- Category Filter -->
          <div>
            <label class="text-sm font-semibold text-gray-700 block mb-2">Category</label>
            <select id="categoryFilter" onchange="window.filterByCategory()" class="w-full px-3 py-2 border border-gray-300 rounded-lg font-medium text-gray-700 focus:outline-none focus:border-emerald-600">
              <option value="all">All Categories</option>
              {{#each categories}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </div>

          <!-- Search Filter -->
          <div>
            <label class="text-sm font-semibold text-gray-700 block mb-2">Search</label>
            <input type="text" id="searchInput" placeholder="Search materials..." onkeyup="window.filterBySearch()" class="w-full px-3 py-2 border border-gray-300 rounded-lg font-medium text-gray-700 focus:outline-none focus:border-emerald-600">
          </div>
        </div>
      </div>

      <!-- Materials Grid -->
      <div id="materialsContainer" class="space-y-4">
        {{#each materials}}
        <div class="material-card material-item rounded-lg p-6 border" 
             data-status="{{#if this.isPublished}}published{{else}}draft{{/if}}"
             data-type="{{this.fileType}}"
             data-category="{{this.category}}"
             data-title="{{this.title}}">
          
          <!-- Card Header -->
          <div class="flex items-center gap-3 flex-1 mb-4">
            <!-- File Type Icon -->
            <div class="text-3xl flex-shrink-0">
              {{#if this.fileType}}
                {{#eq this.fileType 'video'}}🎥{{else}}{{#eq this.fileType 'pdf'}}📄{{else}}📝{{/eq}}{{/eq}}
              {{else}}
                📝
              {{/if}}
            </div>
            <!-- Title -->
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-gray-900 text-lg break-words">{{this.title}}</h3>
              <p class="text-sm text-gray-600 mt-1">{{this.category}}</p>
            </div>
          </div>

          <!-- Excerpt -->
          {{#if this.excerpt}}
          <p class="text-sm text-gray-700 mb-4 line-clamp-2">{{this.excerpt}}</p>
          {{/if}}

          <!-- Engagement Stats -->
          <div class="engagement-stats mb-4">
            <div class="engagement-stat">
              <div class="engagement-stat-value">{{this.views}}</div>
              <div class="engagement-stat-label">Views</div>
            </div>
            <div class="engagement-stat">
              <div class="engagement-stat-value comment-count" data-id="{{this.id}}">0</div>
              <div class="engagement-stat-label">Comments</div>
            </div>
            <div class="engagement-stat">
              <div class="engagement-stat-value">{{this.savedCount}}</div>
              <div class="engagement-stat-label">Saved</div>
            </div>
            <div class="engagement-stat">
              <div class="engagement-stat-value">⭐ {{this.avgRating}}</div>
              <div class="engagement-stat-label">Rating</div>
            </div>
          </div>

          <!-- Reactions Preview -->
          <div class="mb-4 pb-4 border-b border-gray-200">
            <p class="text-xs font-semibold text-gray-700 mb-2">👍 Reactions Preview:</p>
            <div id="reactionsPreview-{{this.id}}" class="flex gap-1 flex-wrap">
              <span class="text-xs text-gray-500">Loading...</span>
            </div>
          </div>

          <!-- Metadata -->
          <div class="flex items-center gap-2 text-xs text-gray-500 mb-4 pb-4 border-b border-gray-200">
            <span>⏱️ {{this.readingTime}} min read</span>
            <span>•</span>
            <span>📅 {{formatDate this.createdAt}}</span>
          </div>

          <!-- Action Buttons -->
          <div class="flex gap-2">
            <button onclick="window.openViewPostModal('{{this.id}}')" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-semibold text-sm transition">
              👁️ View Post
            </button>
            <a href="/counselor/materials/edit/{{this.id}}" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg font-semibold text-sm transition text-center">
              ✏️ Edit
            </a>
            <button onclick="window.confirmDelete('{{this.id}}')" class="flex-1 bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-semibold text-sm transition">
              🗑️ Delete
            </button>
          </div>
        </div>
        {{/each}}
      </div>

      <!-- No Results Message -->
      <div id="noResultsMessage" class="text-center py-12 hidden">
        <div class="text-5xl mb-4">🔍</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">No Materials Found</h3>
        <p class="text-gray-600 mb-6">Try adjusting your filters to find what you're looking for</p>
        <button onclick="window.resetFilters()" class="inline-block bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-3 rounded-lg font-semibold transition">
          Reset Filters
        </button>
      </div>
    {{else}}
      <!-- Empty State -->
      <div class="bg-white rounded-lg shadow-md border border-gray-200 p-12 text-center animate-fade-in-up">
        <div class="text-6xl mb-6 inline-block">📚</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">No Materials Yet</h3>
        <p class="text-gray-600 mb-8 text-lg">Start creating educational content to manage and share with students</p>
        <a href="/counselor/materials/new" class="inline-block bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-4 rounded-lg font-bold transition shadow-lg">
          ➕ Create Your First Material
        </a>
      </div>
    {{/if}}
  </div>

  <!-- View Post Modal -->
  <div id="postModal" class="modal-overlay" onclick="if(event.target.id === 'postModal') window.closeViewPostModal(event)">
    <div class="modal-content" onclick="event.stopPropagation()">
      <!-- Modal Header -->
      <div class="flex justify-between items-center border-b border-gray-200 p-6">
        <h2 class="text-2xl font-bold text-gray-900">Post Details</h2>
        <button type="button" onclick="window.closeViewPostModal()" class="close-modal text-gray-500 hover:text-gray-700 text-2xl w-8 h-8 flex items-center justify-center">
          ✕
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6">
        <!-- Material Header -->
        <div id="modalTitle" class="mb-2">
          <h3 class="text-xl font-bold text-gray-900"></h3>
        </div>
        <p id="modalCategory" class="text-sm text-gray-600 mb-4"></p>

        <!-- Engagement Stats -->
        <div class="engagement-stats mb-6">
          <div class="engagement-stat">
            <div class="engagement-stat-value" id="modalViews">0</div>
            <div class="engagement-stat-label">Views</div>
          </div>
          <div class="engagement-stat">
            <div class="engagement-stat-value" id="modalCommentCount">0</div>
            <div class="engagement-stat-label">Comments</div>
          </div>
          <div class="engagement-stat">
            <div class="engagement-stat-value" id="modalSaved">0</div>
            <div class="engagement-stat-label">Saved</div>
          </div>
          <div class="engagement-stat">
            <div class="engagement-stat-value" id="modalRating">0</div>
            <div class="engagement-stat-label">Rating</div>
          </div>
        </div>

        <!-- Reactions Section -->
        <div class="mb-6">
          <h4 class="font-bold text-gray-900 mb-3">👍 Reactions</h4>
          <div id="modalReactions" class="flex flex-wrap gap-2">
            <span class="text-sm text-gray-500">No reactions yet</span>
          </div>
        </div>

        <!-- Comments Section -->
        <div>
          <h4 class="font-bold text-gray-900 mb-4">💬 Comments</h4>
          <div id="modalCommentsList" class="space-y-4">
            <div class="text-sm text-gray-500 text-center py-8">Loading comments...</div>
          </div>

          <!-- Empty State -->
          <div id="modalNoComments" class="hidden text-center py-8">
            <div class="text-4xl mb-3">🦗</div>
            <p class="text-gray-600">No comments yet. Start a conversation!</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ============================================
    // IMMEDIATE: Define all global functions first
    // ============================================
    window.openViewPostModal = function(materialId) {
      console.log('openViewPostModal called with:', materialId);
    };
    window.closeViewPostModal = function(event) {
      console.log('closeViewPostModal called');
    };
    window.loadPostDetails = function(materialId) {
      console.log('loadPostDetails called with:', materialId);
    };
    window.loadCommentCounts = function() {
      console.log('loadCommentCounts called');
    };
    window.loadReactionsPreview = function() {
      console.log('loadReactionsPreview called');
    };
    window.filterByStatus = function(status) {
      console.log('filterByStatus called:', status);
    };
    window.filterByType = function(type) {
      console.log('filterByType called:', type);
    };
    window.filterByCategory = function(category) {
      console.log('filterByCategory called:', category);
    };
    window.filterBySearch = function() {
      console.log('filterBySearch called');
    };
    window.resetFilters = function() {
      console.log('resetFilters called');
    };
    window.confirmDelete = function(materialId) {
      console.log('confirmDelete called with:', materialId);
    };
    window.deleteMaterial = function(materialId) {
      console.log('deleteMaterial called with:', materialId);
    };
    
    // ============================================
    // Initialize variables and data
    // ============================================
    let materials = [];
    try {
      const rawMaterials = {{{materialsJson}}};
      materials = Array.isArray(rawMaterials) ? rawMaterials : [];
    } catch (e) {
      console.error('Error parsing materials:', e);
      materials = [];
    }
    
    let currentPostId = null;
    let commentRefreshInterval = null;
    let currentFilters = { status: 'all', type: 'all', category: 'all', search: '' };

    // Load comment counts
    window.loadCommentCounts = async function() {
      try {
        const response = await fetch('/api/counselor/materials/comments-summary');
        const data = await response.json();
        if (data.success && data.summary) {
          data.summary.forEach(material => {
            const el = document.querySelector(`.comment-count[data-id="${material.id}"]`);
            if (el) el.textContent = material.totalComments || 0;
          });
        }
      } catch (error) {
        console.error('Error loading comment counts:', error);
      }
    };

    // Load reactions preview
    window.loadReactionsPreview = async function() {
      try {
        const cards = document.querySelectorAll('.material-item');
        for (const card of cards) {
          const countEl = card.querySelector('.comment-count');
          if (!countEl) continue;
          const id = countEl.dataset.id;
          try {
            const response = await fetch(`/api/counselor/materials/${id}/comments-details`);
            const data = await response.json();
            if (data.success && data.reactions) {
              const preview = card.querySelector(`#reactionsPreview-${id}`);
              if (preview) {
                if (Object.keys(data.reactions).length > 0) {
                  preview.innerHTML = Object.entries(data.reactions).slice(0, 5).map(([r, c]) => `
                    <span class="inline-flex items-center gap-1 text-xs bg-gray-100 px-2 py-1 rounded">
                      <span class="text-sm">${r}</span><span class="font-semibold">${c}</span>
                    </span>`).join('');
                  if (Object.keys(data.reactions).length > 5) {
                    preview.innerHTML += `<span class="text-xs text-gray-500">+${Object.keys(data.reactions).length - 5}</span>`;
                  }
                } else {
                  preview.innerHTML = '<span class="text-xs text-gray-500">No reactions yet</span>';
                }
              }
            }
          } catch (err) {
            console.error('Error loading reactions:', err);
          }
        }
      } catch (error) {
        console.error('Error in loadReactionsPreview:', error);
      }
    };

    // Load post details
    window.loadPostDetails = async function(materialId) {
      try {
        const material = materials.find(m => m.id === materialId);
        if (!material) return;

        document.getElementById('modalTitle').innerHTML = `<h3 class="text-xl font-bold text-gray-900">${material.title}</h3>`;
        document.getElementById('modalCategory').textContent = `Category: ${material.category}`;
        document.getElementById('modalViews').textContent = material.views || 0;
        document.getElementById('modalSaved').textContent = material.savedCount || 0;
        document.getElementById('modalRating').textContent = material.avgRating ? `⭐ ${material.avgRating}` : '0';

        const response = await fetch(`/api/counselor/materials/${materialId}/comments-details`);
        if (!response.ok) throw new Error(`API error: ${response.status}`);
        const data = await response.json();

        if (data.success) {
          const comments = data.comments || [];
          const reactions = data.reactions || {};

          document.getElementById('modalCommentCount').textContent = comments.length;

          const reactionsContainer = document.getElementById('modalReactions');
          if (Object.keys(reactions).length > 0) {
            reactionsContainer.innerHTML = Object.entries(reactions)
              .map(([reaction, count]) => `<span class="reaction-badge">${reaction} <span class="font-bold">${count}</span></span>`)
              .join('');
          } else {
            reactionsContainer.innerHTML = '<span class="text-sm text-gray-500">No reactions yet</span>';
          }

          const commentsList = document.getElementById('modalCommentsList');
          const noComments = document.getElementById('modalNoComments');

          if (comments.length > 0) {
            noComments.classList.add('hidden');
            commentsList.innerHTML = comments.map(comment => `
              <div class="comment-item">
                <div class="flex justify-between items-start gap-2 mb-2">
                  <div class="flex-1">
                    <p class="font-semibold text-gray-900 text-sm">${comment.studentName || 'Anonymous'}</p>
                    <p class="text-xs text-gray-500 mt-1">
                      ${new Date(comment.createdAt).toLocaleDateString()} at ${new Date(comment.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
                    </p>
                  </div>
                  ${comment.rating ? `<span class="text-lg">${'⭐'.repeat(comment.rating)}</span>` : ''}
                </div>
                <p class="text-gray-700 text-sm mb-3">${comment.text || ''}</p>
                ${comment.reactions && Object.keys(comment.reactions).length > 0 ? `
                  <div class="flex gap-2 flex-wrap">
                    ${Object.entries(comment.reactions).map(([reaction, count]) => `
                      <span class="text-xs bg-gray-100 border border-gray-300 px-2 py-1 rounded">
                        ${reaction} ${count}
                      </span>
                    `).join('')}
                  </div>
                ` : ''}
              </div>
            `).join('');
          } else {
            noComments.classList.remove('hidden');
            commentsList.innerHTML = '';
          }
        }
      } catch (error) {
        console.error('Error loading post details:', error);
      }
    };

    // Open modal
    window.openViewPostModal = async function(materialId) {
      try {
        currentPostId = materialId;
        const modal = document.getElementById('postModal');
        if (!modal) return;
        modal.style.display = 'flex';
        modal.classList.add('active');
        await window.loadPostDetails(materialId);
        if (commentRefreshInterval) clearInterval(commentRefreshInterval);
        commentRefreshInterval = setInterval(() => {
          if (currentPostId === materialId) window.loadPostDetails(materialId);
        }, 5000);
      } catch (error) {
        console.error('Error in openViewPostModal:', error);
      }
    };

    // Close modal
    window.closeViewPostModal = function(event) {
      if (event && event.target) {
        const modalContent = document.querySelector('.modal-content');
        if (modalContent && event.target !== document.getElementById('postModal')) {
          if (modalContent.contains(event.target) && !event.target.classList.contains('close-modal')) {
            return;
          }
        }
      }
      const modal = document.getElementById('postModal');
      if (modal) {
        modal.classList.remove('active');
        setTimeout(() => { modal.style.display = 'none'; }, 300);
      }
      currentPostId = null;
      if (commentRefreshInterval) clearInterval(commentRefreshInterval);
      window.loadReactionsPreview();
    };

    // Filter functions
    window.applyFilters = function() {
      const items = document.querySelectorAll('.material-item');
      let visibleCount = 0;
      items.forEach(item => {
        let show = true;
        if (currentFilters.status !== 'all') show = show && item.dataset.status === currentFilters.status;
        if (currentFilters.type !== 'all') show = show && item.dataset.type === currentFilters.type;
        if (currentFilters.category !== 'all') show = show && item.dataset.category === currentFilters.category;
        if (currentFilters.search) show = show && item.dataset.title.toLowerCase().includes(currentFilters.search.toLowerCase());
        item.style.display = show ? 'block' : 'none';
        if (show) visibleCount++;
      });
      const noResults = document.getElementById('noResultsMessage');
      if (visibleCount === 0) noResults.classList.remove('hidden');
      else noResults.classList.add('hidden');
    };

    window.filterByStatus = function(status) {
      currentFilters.status = status;
      window.applyFilters();
    };

    window.filterByType = function(type) {
      currentFilters.type = type;
      window.applyFilters();
    };

    window.filterByCategory = function() {
      currentFilters.category = document.getElementById('categoryFilter').value;
      window.applyFilters();
    };

    window.filterBySearch = function() {
      currentFilters.search = document.getElementById('searchInput').value;
      window.applyFilters();
    };

    window.resetFilters = function() {
      currentFilters = { status: 'all', type: 'all', category: 'all', search: '' };
      document.getElementById('searchInput').value = '';
      document.getElementById('categoryFilter').value = 'all';
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('active');
        if (btn.textContent.trim() === 'All') btn.classList.add('active');
      });
      window.applyFilters();
    };

    window.confirmDelete = function(materialId) {
      if (confirm('Are you sure you want to delete this material?')) window.deleteMaterial(materialId);
    };

    window.deleteMaterial = async function(materialId) {
      try {
        const response = await fetch(`/api/counselor/materials/${materialId}`, { method: 'DELETE' });
        if (response.ok) {
          alert('Material deleted successfully!');
          location.reload();
        } else alert('Error deleting material');
      } catch (error) {
        console.error('Error:', error);
        alert('Error deleting material');
      }
    };

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
      window.loadCommentCounts();
      window.loadReactionsPreview();
      setInterval(() => window.loadCommentCounts(), 3000);
      setInterval(() => window.loadReactionsPreview(), 10000);
    });

    // Ensure functions are available immediately
    setTimeout(() => {
      if (!window.openViewPostModal) {
        console.error('openViewPostModal not defined!');
        window.openViewPostModal = () => alert('Please refresh the page');
      }
      if (!window.closeViewPostModal) {
        window.closeViewPostModal = () => {};
      }
      if (!window.confirmDelete) {
        window.confirmDelete = () => alert('Please refresh the page');
      }
    }, 100);

    // Close modal with Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && currentPostId) window.closeViewPostModal();
    });
  </script>

  <!-- Fallback to ensure functions are always available -->
  <script>
    // Create placeholder functions immediately if they don't exist
    window.openViewPostModal = window.openViewPostModal || function(id) { console.log('openViewPostModal called with:', id); };
    window.closeViewPostModal = window.closeViewPostModal || function() { console.log('closeViewPostModal called'); };
    window.loadCommentCounts = window.loadCommentCounts || function() {};
    window.loadReactionsPreview = window.loadReactionsPreview || function() {};
    window.filterByStatus = window.filterByStatus || function() {};
    window.filterByType = window.filterByType || function() {};
    window.filterByCategory = window.filterByCategory || function() {};
    window.filterBySearch = window.filterBySearch || function() {};
    window.resetFilters = window.resetFilters || function() {};
    window.confirmDelete = window.confirmDelete || function() {};
    window.deleteMaterial = window.deleteMaterial || function() {};
  </script>
