<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Counselor</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/counselor/dashboard" class="text-2xl font-bold text-emerald-600 hover:text-emerald-700">🌱 Tellngrow Counselor</a>
      </div>
      <div class="space-x-4 flex items-center">
        <a href="/counselor/dashboard" class="text-gray-600 hover:text-gray-800">Dashboard</a>
        <a href="/counselor/materials" class="text-gray-600 hover:text-gray-800">Materials</a>
        <span class="text-gray-700">👨‍💼 {{user.name}}</span>
        <a href="/logout" class="text-gray-600 hover:text-gray-800 font-medium">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6 max-w-4xl">
    <div class="mb-6">
      <h2 class="text-3xl font-bold text-gray-900">Edit Reading Material</h2>
      <p class="text-gray-600 mt-1">Update your educational content</p>
    </div>

    <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
      <form action="/counselor/materials/update/{{material.id}}" method="POST">
        <!-- Title -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Title</label>
          <input type="text" name="title" required value="{{material.title}}"
                 class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">
        </div>

        <!-- Category -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Category</label>
          <select name="category" required
                  class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">
            <option value="Mental Health" {{#if (eq material.category 'Mental Health')}}selected{{/if}}>Mental Health</option>
            <option value="Stress Management" {{#if (eq material.category 'Stress Management')}}selected{{/if}}>Stress Management</option>
            <option value="Self-Care" {{#if (eq material.category 'Self-Care')}}selected{{/if}}>Self-Care</option>
            <option value="Mindfulness" {{#if (eq material.category 'Mindfulness')}}selected{{/if}}>Mindfulness</option>
            <option value="Wellness" {{#if (eq material.category 'Wellness')}}selected{{/if}}>Wellness</option>
            <option value="Other" {{#if (eq material.category 'Other')}}selected{{/if}}>Other</option>
          </select>
        </div>

        <!-- Excerpt -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Short Description</label>
          <textarea name="excerpt" rows="3" required
                    class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">{{material.excerpt}}</textarea>
        </div>

        <!-- Content -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Content</label>
          <textarea name="content" rows="15" required
                    class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">{{material.content}}</textarea>
        </div>

        <!-- Reading Time -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">Estimated Reading Time (minutes)</label>
          <input type="number" name="readingTime" min="1" max="60" value="{{material.readingTime}}" required
                 class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-emerald-500">
        </div>

        <!-- Publish Status -->
        <div class="mb-6">
          <label class="flex items-center cursor-pointer">
            <input type="checkbox" name="isPublished" value="true" {{#if material.isPublished}}checked{{/if}}
                   class="w-5 h-5 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500">
            <span class="ml-3 text-gray-700 font-semibold">Published</span>
          </label>
        </div>

        <!-- Buttons -->
        <div class="flex gap-4">
          <button type="submit"
                  class="flex-1 bg-emerald-600 text-white py-3 rounded-lg font-semibold hover:bg-emerald-700 transition">
            Update Material
          </button>
          <a href="/counselor/materials"
             class="flex-1 bg-gray-200 text-gray-700 py-3 rounded-lg font-semibold hover:bg-gray-300 transition text-center">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
