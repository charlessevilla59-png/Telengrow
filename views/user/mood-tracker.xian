<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64,">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulse-ring {
      0% { transform: scale(1); opacity: 1; }
      100% { transform: scale(1.2); opacity: 0; }
    }

    .animate-fade-in-down { animation: fadeInDown 0.6s ease-out; }
    .animate-fade-in-up { animation: fadeInUp 0.6s ease-out; }
    .animate-pulse-ring { animation: pulse-ring 2s infinite; }

    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s ease-in-out;
    }
    .sidebar.open {
      transform: translateX(0);
    }
    .overlay {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease-in-out;
    }
    .overlay.show {
      opacity: 1;
      pointer-events: auto;
    }

    #camera-feed {
      border-radius: 12px;
      object-fit: cover;
      transform: scaleX(-1);
      background: #000;
      width: 100% !important;
      height: 100% !important;
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
    }

    #camera-feed::-webkit-media-controls {
      display: none !important;
    }

    .emotion-badge {
      background: linear-gradient(135deg, #16a34a 0%, #10b981 100%);
      border-radius: 12px;
      padding: 16px;
      color: white;
      text-align: center;
      animation: fadeInUp 0.5s ease-out;
    }

    .emotion-card {
      background: #ffffff;
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 20px;
      transition: all 0.3s ease;
    }

    .emotion-card.happy {
      border-color: #fbbf24;
      background-color: #fef3c7;
    }

    .emotion-card.sad {
      border-color: #60a5fa;
      background-color: #dbeafe;
    }

    .emotion-card.angry {
      border-color: #ef4444;
      background-color: #fee2e2;
    }

    .emotion-card.anxious {
      border-color: #f97316;
      background-color: #ffedd5;
    }

    .emotion-card.neutral {
      border-color: #9ca3af;
      background-color: #f3f4f6;
    }

    .emotion-icon {
      font-size: 3rem;
      margin-bottom: 10px;
    }

    /* Mood button styling */
    .mood-button {
      transition: all 0.3s ease;
      background-color: transparent;
      border-color: #e5e7eb;
    }

    .mood-button:hover {
      transform: scale(1.05);
    }

    .mood-button.selected {
      transform: scale(1.1);
      background-color: #f0fdf4;
      border-color: #16a34a;
      box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.1);
    }

    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.7);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 50;
    }

    .modal-overlay.show {
      display: flex;
    }

    .modal-content {
      background: white;
      border-radius: 16px;
      padding: 32px;
      max-width: 500px;
      width: 90%;
      animation: fadeInUp 0.4s ease-out;
    }

    /* Suggestions Container Styles */
    #suggestions-container {
      display: none;
    }

    #suggestions-container.show {
      display: block;
    }

    .suggestion-item {
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
      border: 1px solid #d1fae5;
      border-radius: 12px;
      padding: 16px;
      transition: all 0.3s ease;
      animation: slideInUp 0.3s ease-out;
    }

    .suggestion-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
    }

    .suggestion-title {
      font-weight: 600;
      color: #047857;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 1.1rem;
    }

    .suggestion-desc {
      color: #059669;
      font-size: 0.95rem;
      margin-bottom: 8px;
    }

    .suggestion-link {
      color: #0891b2;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s ease;
    }

    .suggestion-link:hover {
      color: #0e7490;
    }

    #loading-state {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      padding: 16px;
      color: #059669;
    }

    .loading-spinner {
      border: 4px solid #e5e7eb;
      border-top: 4px solid #16a34a;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      animation: spin 1s linear infinite;
      margin: 0 auto;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .navbar-clean {
      background: #ffffff;
      border-bottom: 2px solid #16a34a;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    #confirmation-modal {
      transition: all 0.3s ease-in-out;
      max-height: 500px;
      overflow-y: auto;
    }

    #confirmation-modal.shown {
      animation: slideInUp 0.4s ease-out;
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Overlay -->
  <div id="overlay" class="overlay fixed inset-0 bg-black bg-opacity-50 z-40" onclick="closeSidebar()"></div>

  <!-- Sidebar -->
  {{> sidebar}}

  <!-- Top Navigation -->
  <nav class="navbar-clean sticky top-0 z-30">
    <div class="container mx-auto flex justify-between items-center px-6 py-3">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-green-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <img src="/images/logo.jpg" alt="Tell 'n Grow" class="h-10 w-10">
        <h1 class="text-2xl font-bold text-green-600">Tellngrow</h1>
      </div>
      <div class="flex items-center space-x-4">
        <div class="hidden md:block text-right">
          <p class="text-sm font-semibold text-gray-900">{{user.name}}</p>
          <p class="text-xs text-gray-500">{{user.email}}</p>
        </div>
        <a href="/user/profile" class="text-gray-700 hover:text-green-600 transition p-2 rounded-lg hover:bg-gray-100">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6 md:p-8">
    <!-- Back Button -->
    <div class="mb-4">
      <a href="/user/dashboard" class="inline-flex items-center text-green-600 hover:text-green-700 transition">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span class="font-medium">Back</span>
      </a>
    </div>

    <!-- Header -->
    <div class="mb-8 animate-fade-in-down">
      <h1 class="text-5xl md:text-5xl font-bold text-gray-900 mb-2">Mood Tracker</h1>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Mood Selection Section -->
      <div class="lg:col-span-2">
        <div class="animate-fade-in-up" style="animation-delay: 0.1s;">
          <div class="bg-white rounded-xl shadow-lg p-8 mb-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">How are you feeling?</h2>
            
            <!-- Mood Selection Grid -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
              <button onclick="selectMood('happy')" class="mood-button p-6 rounded-xl border-2 border-gray-200 hover:border-yellow-400 transition text-center" data-emotion="happy">
                <div class="text-4xl mb-2">😊</div>
                <span class="font-semibold text-gray-700">Happy</span>
              </button>
              <button onclick="selectMood('sad')" class="mood-button p-6 rounded-xl border-2 border-gray-200 hover:border-blue-400 transition text-center" data-emotion="sad">
                <div class="text-4xl mb-2">😢</div>
                <span class="font-semibold text-gray-700">Sad</span>
              </button>
              <button onclick="selectMood('angry')" class="mood-button p-6 rounded-xl border-2 border-gray-200 hover:border-red-400 transition text-center" data-emotion="angry">
                <div class="text-4xl mb-2">😠</div>
                <span class="font-semibold text-gray-700">Angry</span>
              </button>
              <button onclick="selectMood('anxious')" class="mood-button p-6 rounded-xl border-2 border-gray-200 hover:border-orange-400 transition text-center" data-emotion="anxious">
                <div class="text-4xl mb-2">😰</div>
                <span class="font-semibold text-gray-700">Anxious</span>
              </button>
              <button onclick="selectMood('neutral')" class="mood-button p-6 rounded-xl border-2 border-gray-200 hover:border-gray-400 transition text-center" data-emotion="neutral">
                <div class="text-4xl mb-2">😐</div>
                <span class="font-semibold text-gray-700">Neutral</span>
              </button>
              <button onclick="selectMood('disgusted')" class="mood-button p-6 rounded-xl border-2 border-gray-200 hover:border-green-400 transition text-center" data-emotion="disgusted">
                <div class="text-4xl mb-2">🤢</div>
                <span class="font-semibold text-gray-700">Disgusted</span>
              </button>
              <button onclick="selectMood('fearful')" class="mood-button p-6 rounded-xl border-2 border-gray-200 hover:border-purple-400 transition text-center" data-emotion="fearful">
                <div class="text-4xl mb-2">😨</div>
                <span class="font-semibold text-gray-700">Fearful</span>
              </button>
              <button onclick="selectMood('surprised')" class="mood-button p-6 rounded-xl border-2 border-gray-200 hover:border-pink-400 transition text-center" data-emotion="surprised">
                <div class="text-4xl mb-2">😲</div>
                <span class="font-semibold text-gray-700">Surprised</span>
              </button>
            </div>

            <!-- Notes Section -->
            <div class="mb-6">
              <label class="block text-gray-700 font-semibold mb-2">Additional Notes (Optional)</label>
              <textarea 
                id="mood-notes" 
                placeholder="What's on your mind? Share any thoughts or feelings..."
                class="w-full p-4 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-emerald-600 resize-none"
                rows="4"
              ></textarea>
            </div>

            <!-- Confidence/Accuracy Slider (Optional) -->
            <div class="mb-8">
              <label class="block text-gray-700 font-semibold mb-2">How confident are you with this mood? <span class="text-emerald-600" id="confidence-value">75</span>%</label>
              <input 
                type="range" 
                id="mood-confidence" 
                min="0" 
                max="100" 
                value="75"
                class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
                oninput="document.getElementById('confidence-value').textContent = this.value"
              >
            </div>

            <!-- Mood Trend Alert -->
            <div id="mood-alert" class="mb-6 p-4 rounded-lg border-l-4 border-green-500 bg-green-50 hidden animate-fade-in-up">
              <p id="mood-alert-message" class="text-green-800 font-medium"></p>
            </div>

            <!-- Suggestions Container -->
            <div id="suggestions-container" class="mb-6 p-6 rounded-xl bg-white border-2 border-emerald-200 hidden animate-fade-in-up">
              <h3 class="text-xl font-bold text-gray-900 mb-2">💡 <span id="suggestion-intro">Great choice!</span></h3>
              <div id="loading-state" class="flex justify-center items-center gap-2">
                <div class="loading-spinner"></div>
                <p class="text-gray-600">Loading personalized activities...</p>
              </div>
              <div id="suggestions-list" class="space-y-3 mt-4">
                <!-- Suggestions will be populated here -->
              </div>
            </div>

            <!-- Submit Button -->
            <button 
              id="save-mood-btn"
              onclick="saveMoodEntry()"
              class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 px-6 rounded-lg transition duration-200 flex items-center justify-center gap-2 text-lg"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Save My Mood
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Mood History -->
      <!-- History & Info Sidebar -->
      <div class="animate-fade-in-up" style="animation-delay: 0.2s;">
        <!-- Current Emotion Display -->
        <div id="emotion-display" class="emotion-card hidden mb-6">
          <div class="emotion-icon" id="emotion-icon">😊</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2" id="emotion-label">Analyzing...</h3>
          <div class="mb-4">
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-semibold text-gray-700">Confidence</span>
              <span class="text-sm font-bold" id="confidence-score">0%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div id="confidence-bar" class="bg-green-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>

        <!-- Confirmation Modal -->
        <div id="confirmation-modal" class="hidden bg-white rounded-xl shadow-lg p-6 mb-6 border-l-4 border-green-600 animate-fade-in-up">
          <h3 class="text-xl font-bold text-gray-900 mb-4">✅ We Detected Your Mood</h3>
          <div class="mb-6 p-4 bg-green-50 rounded-lg border-l-4 border-green-600">
            <div class="flex items-start gap-3">
              <span class="text-3xl" id="detected-emotion-icon">😊</span>
              <div>
                <p class="text-lg font-semibold text-gray-900">Our system detected that you're <span id="detected-emotion-text" class="text-green-600 font-bold">analyzing</span></p>
                <p class="text-sm text-gray-600 mt-1">Confidence Score: <span id="detected-confidence" class="font-bold text-green-600">0%</span></p>
              </div>
            </div>
          </div>
          <p class="text-gray-600 mb-6">Is this accurate? Let us know so we can better understand your mood and provide better suggestions.</p>
          <div class="flex gap-3">
            <button 
              onclick="confirmEmotion('yes')"
              class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-lg transition transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2"
            >
              <span>✓</span> Yes, That's Right
            </button>
            <button 
              onclick="confirmEmotion('no')"
              class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-900 font-bold py-3 px-4 rounded-lg transition transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2"
            >
              <span>✕</span> No, Not Right
            </button>
          </div>
        </div>

        <!-- Suggested Activities -->
        <div id="activities-container" class="hidden bg-white rounded-xl shadow-lg p-6 mb-6 border-t-4 border-green-600 animate-fade-in-up">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl">💡</span>
            <h3 class="text-xl font-bold text-gray-900">Personalized Suggestions for You</h3>
          </div>
          <p class="text-sm text-gray-600 mb-4">Based on your detected mood, here are activities tailored to support your wellbeing:</p>
          <ul id="activities-list" class="space-y-3">
            <!-- Activities will be inserted here with action buttons -->
          </ul>
          <div class="mt-6 p-4 bg-blue-50 rounded-lg border-l-4 border-blue-600">
            <p class="text-sm text-blue-900">
              <strong>💡 Tip:</strong> Click any "Go Now" button to jump directly to that feature. These activities are specifically chosen to help with your current mood.
            </p>
          </div>
        </div>

        <!-- Info Card -->
        <div class="bg-blue-50 rounded-xl shadow-lg p-6 border-l-4 border-blue-600">
          <h3 class="text-lg font-bold text-gray-900 mb-3">How to Use</h3>
          <ul class="space-y-3 text-sm text-gray-700">
            <li class="flex gap-3">
              <span class="text-blue-600 font-bold flex-shrink-0">1</span>
              <span>Select the emotion that best matches how you're feeling</span>
            </li>
            <li class="flex gap-3">
              <span class="text-blue-600 font-bold flex-shrink-0">2</span>
              <span>Optionally add notes about what's on your mind</span>
            </li>
            <li class="flex gap-3">
              <span class="text-blue-600 font-bold flex-shrink-0">3</span>
              <span>Adjust your confidence level with the slider</span>
            </li>
            <li class="flex gap-3">
              <span class="text-blue-600 font-bold flex-shrink-0">4</span>
              <span>Click "Save My Mood" to log your entry</span>
            </li>
            <li class="flex gap-3">
              <span class="text-blue-600 font-bold flex-shrink-0">5</span>
              <span>Track your mood patterns over time</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Recent Mood History -->
    <div class="mt-12 animate-fade-in-up" style="animation-delay: 0.3s;">
      <div class="bg-white rounded-xl shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Your Mood History</h2>
        <div id="mood-history" class="space-y-4">
          <!-- History items will be loaded here -->
        </div>
        <div id="no-history" class="text-center py-12 text-gray-500">
          <p class="text-lg">No mood entries yet. Start scanning to build your mood history!</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Script: Manual Mood Tracker (No Face Recognition) - External File -->
  <script src="/js/mood-tracker-v2.js?v=2"></script>
  <!-- Script: Unified Mood Tracker Module - Must load AFTER v2 to override functions -->
  <script src="/js/mood-tracker-unified.js?v=1"></script>
  <script>
    // Sidebar functions
    function openSidebar() {
      document.getElementById('sidebar').classList.add('open');
      document.getElementById('overlay').classList.add('show');
    }

    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('overlay').classList.remove('show');
    }

    // Auto-open sidebar when cursor moves to left edge
    let sidebarOpenTimeout;
    document.addEventListener('mousemove', function(e) {
      if (e.clientX < 30) {
        if (!sidebarOpenTimeout) {
          sidebarOpenTimeout = setTimeout(() => {
            const sidebar = document.getElementById('sidebar');
            if (sidebar && !sidebar.classList.contains('open')) {
              openSidebar();
            }
          }, 300);
        }
      } else {
        if (sidebarOpenTimeout) {
          clearTimeout(sidebarOpenTimeout);
          sidebarOpenTimeout = null;
        }
      }
    });

  </script>
</body>
</html>
