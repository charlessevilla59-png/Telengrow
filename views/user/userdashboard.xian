<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }
    @keyframes glow {
      0%, 100% { box-shadow: 0 0 20px rgba(16, 185, 129, 0.3); }
      50% { box-shadow: 0 0 30px rgba(16, 185, 129, 0.6); }
    }
    @keyframes pulse-scale {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    @keyframes shimmer {
      0% { background-position: -1000px 0; }
      100% { background-position: 1000px 0; }
    }
    @keyframes bounce-gentle {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
    @keyframes slide-in-right {
      from { opacity: 0; transform: translateX(30px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .animate-fade-in-down { animation: fadeInDown 0.6s ease-out; }
    .animate-fade-in-up { animation: fadeInUp 0.6s ease-out; }
    .animate-float { animation: float 3s ease-in-out infinite; }
    .animate-glow { animation: glow 3s ease-in-out infinite; }
    .animate-pulse-scale { animation: pulse-scale 2s ease-in-out infinite; }
    .animate-bounce-gentle { animation: bounce-gentle 2s ease-in-out infinite; }
    .animate-slide-in-right { animation: slide-in-right 0.6s ease-out; }

    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s ease-in-out;
    }
    .sidebar.open {
      transform: translateX(0);
    }
    .overlay {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease-in-out;
    }
    .overlay.show {
      opacity: 1;
      pointer-events: auto;
    }
    
    .stat-card {
      background: linear-gradient(135deg, #ffffff 0%, #f8fafb 100%);
      border: 1px solid #e5e7eb;
      backdrop-filter: blur(10px);
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
    }
    
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
      transition: left 0.5s;
    }
    
    .stat-card:hover::before {
      left: 100%;
    }
    
    .stat-card:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 20px 40px rgba(22, 163, 74, 0.15);
      border-color: #16a34a;
      background: linear-gradient(135deg, #f0fdf4 0%, #f8fafb 100%);
    }
    
    .stat-icon {
      width: 60px;
      height: 60px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      transition: all 0.3s ease;
    }
    
    .stat-card:hover .stat-icon {
      transform: scale(1.1) rotate(5deg);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .progress-bar {
      background: linear-gradient(90deg, #16a34a 0%, #10b981 100%);
      border-radius: 8px;
      height: 6px;
      overflow: hidden;
    }

    .game-card {
      background: linear-gradient(135deg, #ffffff 0%, #f9fafb 100%);
      border: 2px solid #e5e7eb;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
    }

    .game-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      transform: translateX(-100%);
      transition: transform 0.6s;
    }

    .game-card:hover::after {
      transform: translateX(100%);
    }

    .game-card:hover {
      transform: translateY(-12px) scale(1.03);
      box-shadow: 0 25px 50px rgba(22, 163, 74, 0.2);
      border-color: #16a34a;
    }

    .game-emoji {
      display: inline-block;
      transition: all 0.3s ease;
      animation: float 3s ease-in-out infinite;
    }

    .game-card:hover .game-emoji {
      transform: scale(1.2) rotateY(360deg);
      animation: none;
    }

    .quick-link {
      background: linear-gradient(135deg, #ffffff 0%, #f9fafb 100%);
      border-left: 4px solid #16a34a;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
    }

    .quick-link::before {
      content: '';
      position: absolute;
      right: -30px;
      top: -30px;
      width: 60px;
      height: 60px;
      background: rgba(16, 185, 129, 0.1);
      border-radius: 50%;
      transition: all 0.3s ease;
    }

    .quick-link:hover {
      transform: translateX(6px);
      box-shadow: 0 12px 30px rgba(22, 163, 74, 0.15);
      border-left-width: 6px;
      background: linear-gradient(135deg, #f0fdf4 0%, #f9fafb 100%);
    }

    .quick-link:hover::before {
      right: -10px;
      top: -10px;
      background: rgba(16, 185, 129, 0.2);
    }

    .navbar-clean {
      background: linear-gradient(135deg, #ffffff 0%, #f8fafb 100%);
      border-bottom: 2px solid #16a34a;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      backdrop-filter: blur(10px);
      position: relative;
    }

    .navbar-clean::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #16a34a, transparent);
      box-shadow: 0 0 20px rgba(22, 163, 74, 0.5);
    }

    .stat-value {
      font-size: 2.5rem;
      font-weight: 700;
      color: #1f2937;
      transition: all 0.3s ease;
    }

    .stat-card:hover .stat-value {
      transform: scale(1.05) translateY(-2px);
    }

    /* Enhanced Progress Bar */
    .progress-bar {
      background: linear-gradient(90deg, #16a34a 0%, #10b981 50%, #06b6d4 100%);
      border-radius: 8px;
      height: 6px;
      overflow: hidden;
      position: relative;
    }

    .progress-bar::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      animation: shimmer 2s infinite;
    }
    .edge-trigger {
      position: fixed;
      left: 0;
      top: 0;
      width: 30px;
      height: 100vh;
      z-index: 45;
      cursor: pointer;
    }

    /* Section Headers Enhancement */
    .section-header {
      position: relative;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 24px;
    }

    .section-header::before {
      content: '';
      position: absolute;
      left: 0;
      bottom: -8px;
      width: 60px;
      height: 4px;
      background: linear-gradient(90deg, #16a34a, #10b981);
      border-radius: 2px;
    }

    /* Enhanced Button Hover */
    button:not(:disabled) {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    button:not(:disabled):hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(22, 163, 74, 0.3);
    }

    button:not(:disabled):active {
      transform: translateY(0);
    }

    /* Modal Hidden State */
    .modal-hidden {
      display: none !important;
      visibility: hidden;
      pointer-events: none;
      opacity: 0;
    }

    /* Modal Visible State */
    #infoModal:not(.modal-hidden) {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    /* ===== MOOD PICKER STYLES ===== */
    .emotion-picker {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
      gap: 12px;
      margin: 20px 0;
    }

    .emotion-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 16px 12px;
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      background: white;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      font-size: 32px;
      font-weight: 600;
      color: #6b7280;
    }

    .emotion-btn:hover {
      transform: translateY(-8px) scale(1.05);
      box-shadow: 0 12px 30px rgba(22, 163, 74, 0.2);
      border-color: #16a34a;
    }

    .emotion-btn.selected {
      border-color: #16a34a;
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
      color: #16a34a;
      box-shadow: 0 12px 30px rgba(22, 163, 74, 0.3);
    }

    .emotion-label {
      font-size: 11px;
      text-align: center;
      line-height: 1.2;
      color: inherit;
    }

    .suggestions-container {
      margin-top: 24px;
      padding: 20px;
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
      border: 2px solid #86efac;
      border-radius: 12px;
      display: none;
      animation: slideInUp 0.5s ease-out;
    }

    .suggestions-container.show {
      display: block;
    }

    .suggestion-item {
      background: white;
      padding: 16px;
      border-radius: 8px;
      margin-bottom: 12px;
      border-left: 4px solid #16a34a;
      transition: all 0.3s ease;
    }

    .suggestion-item:last-child {
      margin-bottom: 0;
    }

    .suggestion-item:hover {
      transform: translateX(4px);
      box-shadow: 0 8px 20px rgba(22, 163, 74, 0.15);
    }

    .suggestion-title {
      font-weight: 600;
      color: #1f2937;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .suggestion-desc {
      font-size: 0.875rem;
      color: #6b7280;
      line-height: 1.4;
    }

    .suggestion-link {
      display: inline-block;
      margin-top: 8px;
      padding: 6px 12px;
      background: #16a34a;
      color: white;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .suggestion-link:hover {
      background: #15803d;
      transform: scale(1.05);
    }

    .mood-loading {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #16a34a;
      font-weight: 600;
    }

    .spinner {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid #e5e7eb;
      border-top: 2px solid #16a34a;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Left Edge Trigger Zone (invisible) -->
  <div class="edge-trigger" id="edgeTrigger" onmouseenter="openSidebar()" title="Hover to open sidebar"></div>
  <!-- Overlay -->
  <div id="overlay" class="overlay fixed inset-0 bg-black bg-opacity-50 z-40" onclick="closeSidebar()"></div>

  <!-- Sidebar -->
  {{> sidebar}}

  <!-- Top Navigation -->
  <nav class="navbar-clean sticky top-0 z-30">
    <div class="container mx-auto flex justify-between items-center px-6 py-3">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-green-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <img src="/images/logo.jpg" alt="Tell 'n Grow" class="h-10 w-10">
        <h1 class="text-2xl font-bold text-green-600">Tellngrow</h1>
      </div>

      <div class="flex items-center space-x-4">
        <div class="hidden md:block text-right">
          <p class="text-sm font-semibold text-gray-900">{{user.name}}</p>
          <p class="text-xs text-gray-500">{{user.email}}</p>
        </div>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6 md:p-8">
    <!-- Welcome Header -->
    <div class="mb-12 animate-fade-in-down">
      <div class="relative">
        <div class="absolute -top-4 -left-4 w-72 h-72 bg-gradient-to-r from-green-100 to-emerald-100 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-float"></div>
        <div class="absolute -bottom-8 -right-4 w-72 h-72 bg-gradient-to-r from-blue-100 to-cyan-100 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-bounce-gentle"></div>
        <div class="relative z-10">
          <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-2">Welcome, <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-600 via-emerald-600 to-teal-600 animate-pulse">{{user.name}}</span></h1>
          <p class="text-lg text-gray-600">Track your wellness progress and access your mental health resources</p>
        </div>
      </div>
    </div>

    <!-- Mood Greeting Card -->
    <div id="mood-greeting-card" class="mb-8 animate-fade-in-up" style="animation-delay: 0.05s;">
      <div class="bg-gradient-to-r from-emerald-50 via-teal-50 to-cyan-50 rounded-xl shadow-md border-2 border-emerald-200 p-8">
        <div class="flex items-start gap-6 flex-col md:flex-row">
          <!-- Greeting Emoji -->
          <div class="text-5xl flex-shrink-0" id="mood-emoji">👋</div>
          
          <!-- Greeting Content -->
          <div class="flex-grow">
            <div id="mood-greeting-text" class="text-xl font-semibold text-gray-800 mb-3 leading-relaxed">
              Loading your mood greeting...
            </div>
            
            <!-- Mood Status/Alert -->
            <div id="mood-alert" class="hidden mb-4 p-3 rounded-lg bg-white border-l-4 border-emerald-500">
              <p id="mood-alert-message" class="text-sm text-gray-700 font-medium"></p>
            </div>

            <!-- Quick Actions -->
            <div class="flex flex-wrap gap-3 pt-2">
              <a 
                href="/user/mood-tracker"
                class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-6 rounded-lg transition transform hover:scale-105 active:scale-95"
              >
                <span>📱</span> Check My Mood
              </a>
              <a 
                href="/journal"
                class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg transition transform hover:scale-105 active:scale-95"
              >
                <span>📝</span> Journal Today
              </a>
            </div>
          </div>

          <!-- Close Button -->
          <button 
            onclick="document.getElementById('mood-greeting-card').style.display='none';"
            class="text-gray-400 hover:text-gray-600 flex-shrink-0"
            title="Close greeting"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- 🎯 Emotion Picker Section - Select Your Mood! -->
    <div id="mood-picker-section" class="mb-8 animate-fade-in-up" style="animation-delay: 0.1s;">
      <div class="bg-white rounded-xl shadow-md border-2 border-blue-200 p-8">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-2 flex items-center gap-2">
            <span class="text-3xl">🧠</span> How's Your Day?
          </h2>
          <p class="text-gray-600">Pick an emoji to tell us how you're feeling right now</p>
        </div>

        <!-- Emotion Picker Grid -->
        <div class="emotion-picker" id="emotion-picker">
          <button class="emotion-btn" data-emotion="happy" onclick="selectEmotion('happy', this)" title="Happy">
            <span>😊</span>
            <span class="emotion-label">Happy</span>
          </button>
          <button class="emotion-btn" data-emotion="sad" onclick="selectEmotion('sad', this)" title="Sad">
            <span>😢</span>
            <span class="emotion-label">Sad</span>
          </button>
          <button class="emotion-btn" data-emotion="angry" onclick="selectEmotion('angry', this)" title="Angry">
            <span>😠</span>
            <span class="emotion-label">Angry</span>
          </button>
          <button class="emotion-btn" data-emotion="fearful" onclick="selectEmotion('fearful', this)" title="Anxious">
            <span>😨</span>
            <span class="emotion-label">Anxious</span>
          </button>
          <button class="emotion-btn" data-emotion="neutral" onclick="selectEmotion('neutral', this)" title="Neutral">
            <span>😐</span>
            <span class="emotion-label">Neutral</span>
          </button>
          <button class="emotion-btn" data-emotion="disgusted" onclick="selectEmotion('disgusted', this)" title="Disgusted">
            <span>🤢</span>
            <span class="emotion-label">Disgusted</span>
          </button>
          <button class="emotion-btn" data-emotion="surprised" onclick="selectEmotion('surprised', this)" title="Surprised">
            <span>😮</span>
            <span class="emotion-label">Surprised</span>
          </button>
          <button class="emotion-btn" data-emotion="anxious" onclick="selectEmotion('anxious', this)" title="Anxious">
            <span>😰</span>
            <span class="emotion-label">Worried</span>
          </button>
        </div>

        <!-- System Suggestions Container -->
        <div id="suggestions-container" class="suggestions-container">
          <div class="mb-4">
            <h3 class="text-lg font-bold text-gray-900 mb-2 flex items-center gap-2">
              <span id="suggestion-emoji">💡</span> System Suggestions for You
            </h3>
            <p class="text-sm text-gray-600" id="suggestion-intro"></p>
          </div>

          <!-- Loading State -->
          <div id="loading-state" class="mood-loading" style="display: none;">
            <span class="spinner"></span>
            <span>Loading suggestions...</span>
          </div>

          <!-- Suggestions List -->
          <div id="suggestions-list"></div>
        </div>

        <!-- Save Mood Button - Always Visible -->
        <div class="mt-6 flex gap-3">
          <button 
            id="save-mood-btn"
            onclick="saveMoodEntry()"
            class="flex-1 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white font-bold py-3 px-6 rounded-lg transition transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2"
          >
            <span>✅</span> Save My Mood
          </button>
          <button 
            onclick="clearMoodSelection()"
            class="bg-gray-300 hover:bg-gray-400 text-gray-700 font-semibold py-3 px-6 rounded-lg transition"
          >
            ✕ Clear
          </button>
        </div>
      </div>
    </div>

    <!-- Main Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <!-- Total Points Card -->
      <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.1s;">
        <div class="flex items-start justify-between mb-4">
          <div class="stat-icon bg-gradient-to-br from-amber-100 to-orange-100">⭐</div>
          <div class="text-xs font-semibold text-green-600 bg-green-50 px-3 py-1 rounded-full">+12%</div>
        </div>
        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Total Points</p>
        <p class="text-4xl font-bold text-gray-900 mt-3" data-stat="points">{{progress.totalPoints}}</p>
        <div class="mt-4">
          <div class="text-gray-500 text-xs font-medium mb-2">Progress to Next Level</div>
          <div class="progress-bar mt-2" style="width: 60%;"></div>
        </div>
      </div>

      <!-- Mood Tracker Score Card -->
      <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="flex items-start justify-between mb-4">
          <div class="stat-icon bg-gradient-to-br from-purple-100 to-pink-100">🎮</div>
          <div class="text-xs font-semibold text-purple-600 bg-purple-50 px-3 py-1 rounded-full">Play Games</div>
        </div>
        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Games Played</p>
        <p class="text-4xl font-bold text-gray-900 mt-3">{{gamesPlayedCount}}</p>
        <div class="mt-4">
          <div class="text-gray-500 text-xs font-medium mb-2">Therapeutic games played</div>
          <div class="progress-bar mt-2" style="width: {{gamesPlayedCount}}%;"></div>
        </div>
      </div>

      <!-- Wellness Check-ins Card -->
      <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.3s;">
        <div class="flex items-start justify-between mb-4">
          <div class="stat-icon bg-gradient-to-br from-cyan-100 to-blue-100">📝</div>
          <div class="text-xs font-semibold text-cyan-600 bg-cyan-50 px-3 py-1 rounded-full">Journal</div>
        </div>
        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Times Journaled</p>
        <p class="text-4xl font-bold text-gray-900 mt-3">{{journalCount}}</p>
        <div class="mt-4">
          <div class="text-gray-500 text-xs font-medium mb-2">Reflective journaling entries</div>
          <div class="progress-bar mt-2" style="width: {{journalCount}}%;"></div>
        </div>
      </div>

      <!-- Games Played Card -->
      <div class="stat-card rounded-xl p-6 animate-fade-in-up" style="animation-delay: 0.4s;">
        <div class="flex items-start justify-between mb-4">
          <div class="stat-icon bg-gradient-to-br from-blue-100 to-indigo-100">📚</div>
          <div class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">Reading</div>
        </div>
        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wide">Materials Viewed</p>
        <p class="text-4xl font-bold text-gray-900 mt-3">{{readingSessionCount}}</p>
        <div class="mt-4">
          <div class="text-gray-500 text-xs font-medium mb-2">Reading materials & videos watched</div>
          <div class="progress-bar mt-2" style="width: {{readingSessionCount}}%;"></div>
        </div>
      </div>
    </div>



    <!-- Main Content Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <!-- Left Column - Games -->
      <div class="lg:col-span-2">
        <!-- Available Games Section -->
        <div class="mb-12">
          <div class="mb-8 animate-fade-in-down">
            <h2 class="text-4xl font-bold text-gray-900 section-header">🎮 Therapeutic Games</h2>
            <p class="text-gray-600 text-lg mt-6">Science-backed games to support your mental wellness</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <a href="/games/breathing-bubble" class="game-card rounded-xl p-8 block group bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 hover:border-green-400 shadow-md hover:shadow-xl">
              <div class="mb-4">
                <span class="text-6xl game-emoji">🫁</span>
              </div>
              <h3 class="font-bold text-xl text-gray-900 group-hover:text-green-600 transition mb-2">Breathing Bubble</h3>
              <p class="text-sm text-gray-600 mb-5 line-clamp-2">Calm your mind with guided breathing exercises and deep relaxation</p>
              <div class="flex justify-between items-center text-xs mt-4">
                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full font-semibold">Beginner</span>
                <span class="text-gray-500 font-medium">5 min</span>
              </div>
            </a>

            <a href="/games/color-tap" class="game-card rounded-xl p-8 block group bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-blue-200 hover:border-blue-400 shadow-md hover:shadow-xl">
              <div class="mb-4">
                <span class="text-6xl game-emoji">🎨</span>
              </div>
              <h3 class="font-bold text-xl text-gray-900 group-hover:text-blue-600 transition mb-2">Color Tap</h3>
              <p class="text-sm text-gray-600 mb-5 line-clamp-2">Quick focus game that tests mental clarity and reaction time</p>
              <div class="flex justify-between items-center text-xs mt-4">
                <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full font-semibold">Intermediate</span>
                <span class="text-gray-500 font-medium">3 min</span>
              </div>
            </a>

            <a href="/games/grid-memory" class="game-card rounded-xl p-8 block group bg-gradient-to-br from-purple-50 to-pink-50 border-2 border-purple-200 hover:border-purple-400 shadow-md hover:shadow-xl">
              <div class="mb-4">
                <span class="text-6xl game-emoji">🧩</span>
              </div>
              <h3 class="font-bold text-xl text-gray-900 group-hover:text-purple-600 transition mb-2">Grid Memory</h3>
              <p class="text-sm text-gray-600 mb-5 line-clamp-2">Train memory and concentration with pattern recognition</p>
              <div class="flex justify-between items-center text-xs mt-4">
                <span class="bg-purple-100 text-purple-700 px-3 py-1 rounded-full font-semibold">Intermediate</span>
                <span class="text-gray-500 font-medium">5 min</span>
              </div>
            </a>

            <a href="/games" class="game-card rounded-xl p-8 block group border-3 border-dashed border-green-400 bg-green-50 hover:bg-green-100 shadow-md hover:shadow-xl">
              <div class="mb-4">
                <span class="text-6xl game-emoji">⭐</span>
              </div>
              <h3 class="font-bold text-xl text-gray-900 group-hover:text-green-600 transition mb-2">View All Games</h3>
              <p class="text-sm text-gray-600 mb-5">Discover our complete library of therapeutic games</p>
              <div class="text-right">
                <span class="text-green-600 font-bold text-sm">View All →</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Information Section Removed - Now Available via Modal Buttons Above -->
      </div>

      <!-- Right Column - Resources and Quick Access -->
      <div class="lg:col-span-1">

        <!-- Quick Navigation -->
        <div class="mb-8">
          <div class="mb-4 animate-fade-in-down">
            <h2 class="text-2xl font-bold text-gray-900">Quick Access</h2>
          </div>
          <div class="space-y-3">
            <a href="/journal" class="quick-link bg-white rounded-lg p-4 block animate-fade-in-up" style="animation-delay: 0.1s;">
              <p class="font-bold text-gray-900">📔 Personal Journal</p>
              <p class="text-xs text-gray-600 mt-1">Track emotions & wellness</p>
            </a>
            
            <a href="/reading" class="quick-link bg-white rounded-lg p-4 border-l-emerald-600 block animate-fade-in-up" style="animation-delay: 0.2s;">
              <p class="font-bold text-gray-900">📚 Reading Materials</p>
              <p class="text-xs text-gray-600 mt-1">Expert wellness articles</p>
            </a>
            
            <a href="/saved" class="quick-link bg-white rounded-lg p-4 border-l-teal-600 block animate-fade-in-up" style="animation-delay: 0.3s;">
              <p class="font-bold text-gray-900">💾 Saved Materials</p>
              <p class="text-xs text-gray-600 mt-1">Your bookmarked content</p>
            </a>

            <a href="/fitness-guide" class="quick-link bg-white rounded-lg p-4 border-l-green-500 block animate-fade-in-up" style="animation-delay: 0.4s;">
              <p class="font-bold text-gray-900">💪 Fitness Guide</p>
              <p class="text-xs text-gray-600 mt-1">Exercise & wellness videos</p>
            </a>
          </div>
        </div>

        <!-- 💪 Fitness Videos Section -->
        <div class="mt-8 animate-fade-in-up" style="animation-delay: 0.5s;">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-2xl font-bold text-gray-900">💪 Recommended Fitness Videos</h2>
            <a href="/fitness-guide" class="text-sm text-green-600 font-semibold hover:text-green-700 transition">View all →</a>
          </div>
          
          {{#if fitnessVideos}}
            {{#if (gt fitnessVideos.length 0)}}
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                {{#each fitnessVideos}}
                  <div class="bg-white border-2 border-green-100 rounded-lg overflow-hidden shadow-md hover:shadow-lg hover:border-green-400 transition-all duration-300 transform hover:scale-105">
                    <!-- Video Thumbnail -->
                    <div class="relative bg-gray-900 aspect-video flex items-center justify-center overflow-hidden">
                      {{#if this.videoUrl}}
                        <iframe 
                          src="{{this.videoUrl}}" 
                          class="w-full h-full border-none pointer-events-none" 
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                          allowfullscreen>
                        </iframe>
                      {{else if this.filePath}}
                        <div class="absolute inset-0 bg-gradient-to-br from-green-400 to-emerald-600 flex items-center justify-center">
                          <div class="text-6xl">🎬</div>
                        </div>
                        <div class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-30 hover:bg-opacity-50 transition">
                          <div class="text-5xl">▶️</div>
                        </div>
                      {{/if}}
                      
                      <!-- Duration Badge -->
                      {{#if this.videoDuration}}
                        <div class="absolute top-2 right-2 bg-black bg-opacity-75 text-white text-xs font-bold px-2 py-1 rounded">
                          {{#if (gt this.videoDuration 3600)}}
                            {{divide this.videoDuration 3600 roundUp}}h {{remainder (divide this.videoDuration 60) 60}}m
                          {{else}}
                            {{divide this.videoDuration 60 roundUp}}m
                          {{/if}}
                        </div>
                      {{/if}}
                    </div>
                    
                    <!-- Video Info -->
                    <div class="p-3">
                      <h3 class="font-bold text-gray-800 text-sm line-clamp-2 mb-2">{{this.title}}</h3>
                      
                      <div class="flex items-center gap-1 text-xs text-gray-600 mb-3">
                        <span>👤</span>
                        <span class="truncate">{{this.counselor.name}}</span>
                      </div>
                      
                      <p class="text-xs text-gray-600 line-clamp-2 mb-3">{{this.excerpt}}</p>
                      
                      <!-- Action Button -->
                      <a href="/reading/{{this.slug}}" class="w-full inline-block bg-green-500 hover:bg-green-600 text-white text-center text-xs font-bold py-2 rounded transition">
                        🎥 Watch Video
                      </a>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-lg p-8 text-center">
                <div class="text-5xl mb-3">💪</div>
                <p class="text-gray-700 font-semibold mb-2">No Fitness Videos Yet</p>
                <p class="text-sm text-gray-600">Check back soon for new workout and wellness videos from your counselors!</p>
              </div>
            {{/if}}
          {{else}}
            <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-lg p-8 text-center">
              <div class="text-5xl mb-3">💪</div>
              <p class="text-gray-700 font-semibold mb-2">Loading Fitness Videos...</p>
              <p class="text-sm text-gray-600">Please wait while we fetch your personalized fitness content.</p>
            </div>
          {{/if}}
        </div>


      </div>
    </div>



  </div>

  <!-- Info Modal -->
  <div id="infoModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 backdrop-blur-sm modal-hidden">
    <div class="bg-white rounded-2xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto transform transition-all duration-300 scale-100 hover:shadow-3xl">
      <!-- Modal Header with Enhanced Gradient -->
      <div class="sticky top-0 bg-gradient-to-r from-green-600 via-emerald-600 to-teal-600 text-white p-8 flex justify-between items-start gap-4">
        <div class="flex-1">
          <div class="inline-flex items-center gap-2 mb-3">
            <div id="modalIcon" class="text-3xl">📚</div>
            <span class="px-3 py-1 bg-white bg-opacity-20 rounded-full text-xs font-semibold uppercase tracking-wider">Tellngrow Info</span>
          </div>
          <h2 id="modalTitle" class="text-3xl font-bold leading-tight">How Tellngrow Works</h2>
          <p class="mt-2 text-emerald-50 text-sm">Learn about our platform and start your wellness journey</p>
        </div>
        <button onclick="closeInfoModal()" class="text-white hover:bg-white hover:bg-opacity-20 rounded-lg p-2 transition flex-shrink-0 hover:scale-110">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal Content with Enhanced Styling -->
      <div class="p-8 space-y-8">
        <!-- How Works Section -->
        <div id="how-works-content" class="space-y-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-xl p-6 hover:shadow-lg transition">
              <div class="flex items-start gap-4">
                <div class="text-4xl">🎯</div>
                <div>
                  <h4 class="text-lg font-bold text-gray-900 mb-2">Science-Backed Approach</h4>
                  <p class="text-gray-700 text-sm">Tellngrow is built on evidence-based research by licensed mental health professionals. Every feature is designed to support your psychological well-being.</p>
                </div>
              </div>
            </div>
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-xl p-6 hover:shadow-lg transition">
              <div class="flex items-start gap-4">
                <div class="text-4xl">🎮</div>
                <div>
                  <h4 class="text-lg font-bold text-gray-900 mb-2">Engaging Games</h4>
                  <p class="text-gray-700 text-sm">Play therapeutic games designed to reduce anxiety, improve focus, and boost mental clarity while having fun and earning points.</p>
                </div>
              </div>
            </div>
            <div class="bg-gradient-to-br from-purple-50 to-pink-50 border-2 border-purple-200 rounded-xl p-6 hover:shadow-lg transition">
