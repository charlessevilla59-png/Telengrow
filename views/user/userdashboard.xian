            <!-- Step 2 -->
            <div class="relative z-10">
              <div class="text-center">
                <div class="w-16 h-16 rounded-full mx-auto mb-4 bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg hover:shadow-xl transition transform hover:scale-110">
                  2
