                  1
                </div>
                <div class="bg-green-50 border-2 border-green-200 rounded-lg p-4">
                  <p class="font-bold text-gray-900 text-sm">Play Games</p>
                  <p class="text-xs text-gray-600 mt-2">Earn points and build streaks with therapeutic games</p>
                </div>
              </div>
