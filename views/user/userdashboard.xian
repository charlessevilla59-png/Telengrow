        </div>

        <!-- Path to Wellness Section -->
        <div id="path-content" class="hidden space-y-8">
          <h3 class="text-2xl font-bold text-gray-900 text-center mb-8 flex items-center justify-center gap-2">
            <span class="text-3xl">🚀</span> Your Path to Wellness
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 relative">
            <!-- Connection Line -->
