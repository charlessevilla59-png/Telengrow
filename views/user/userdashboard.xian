            <div class="relative z-10">
              <div class="text-center">
                <div class="w-16 h-16 rounded-full mx-auto mb-4 bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg hover:shadow-xl transition transform hover:scale-110">
                  3
                </div>
                <div class="bg-purple-50 border-2 border-purple-200 rounded-lg p-4">
                  <p class="font-bold text-gray-900 text-sm">Learn & Grow</p>
