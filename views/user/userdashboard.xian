                </div>
              </div>
            </div>
            <div class="bg-gradient-to-br from-amber-50 to-orange-50 border-2 border-amber-200 rounded-xl p-6 hover:shadow-lg transition">
              <div class="flex items-start gap-4">
                <div class="text-4xl">📚</div>
                <div>
                  <h4 class="text-lg font-bold text-gray-900 mb-2">Expert Resources</h4>
                  <p class="text-gray-700 text-sm">Access curated articles and guides from professional counselors covering mental health, wellness tips, and coping strategies.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Features Section -->
        <div id="features-content" class="hidden space-y-6">
          <h3 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="text-3xl">✨</span> Key Features
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="border-l-4 border-green-600 bg-green-50 p-4 rounded-r-lg hover:shadow-md transition">
              <div class="flex gap-3">
                <span class="text-2xl flex-shrink-0">🎮</span>
                <div>
                  <h4 class="font-bold text-gray-900 mb-1">Interactive Therapeutic Games</h4>
                  <p class="text-sm text-gray-700">5+ scientifically-designed games for mental wellness including breathing exercises, memory games, and focus training.</p>
                </div>
              </div>
            </div>
            <div class="border-l-4 border-blue-600 bg-blue-50 p-4 rounded-r-lg hover:shadow-md transition">
              <div class="flex gap-3">
                <span class="text-2xl flex-shrink-0">📖</span>
                <div>
                  <h4 class="font-bold text-gray-900 mb-1">Expert Articles & Guides</h4>
                  <p class="text-sm text-gray-700">Curated mental health content reviewed by professional counselors covering stress, anxiety, depression, and wellness.</p>
                </div>
              </div>
            </div>
            <div class="border-l-4 border-purple-600 bg-purple-50 p-4 rounded-r-lg hover:shadow-md transition">
              <div class="flex gap-3">
                <span class="text-2xl flex-shrink-0">📔</span>
                <div>
                  <h4 class="font-bold text-gray-900 mb-1">Personal Journaling</h4>
                  <p class="text-sm text-gray-700">Express yourself with daily journaling, emotion tracking, and reflect on your wellness journey with detailed insights.</p>
                </div>
              </div>
            </div>
            <div class="border-l-4 border-amber-600 bg-amber-50 p-4 rounded-r-lg hover:shadow-md transition">
              <div class="flex gap-3">
                <span class="text-2xl flex-shrink-0">🏆</span>
                <div>
                  <h4 class="font-bold text-gray-900 mb-1">Gamified Achievements</h4>
                  <p class="text-sm text-gray-700">Earn badges, build streaks, and level up as you progress. Stay motivated with rewards and milestones.</p>
                </div>
              </div>
            </div>
            <div class="border-l-4 border-red-600 bg-red-50 p-4 rounded-r-lg hover:shadow-md transition">
              <div class="flex gap-3">
                <span class="text-2xl flex-shrink-0">🔒</span>
                <div>
                  <h4 class="font-bold text-gray-900 mb-1">Secure & Private</h4>
                  <p class="text-sm text-gray-700">HIPAA-compliant with end-to-end encryption. Your mental health data is protected with military-grade security.</p>
                </div>
              </div>
            </div>
            <div class="border-l-4 border-teal-600 bg-teal-50 p-4 rounded-r-lg hover:shadow-md transition">
              <div class="flex gap-3">
                <span class="text-2xl flex-shrink-0">📊</span>
                <div>
                  <h4 class="font-bold text-gray-900 mb-1">Progress Analytics</h4>
                  <p class="text-sm text-gray-700">Get detailed wellness reports, mood trends, and insights to understand your mental health patterns better.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Path to Wellness Section -->
        <div id="path-content" class="hidden space-y-8">
          <h3 class="text-2xl font-bold text-gray-900 text-center mb-8 flex items-center justify-center gap-2">
            <span class="text-3xl">🚀</span> Your Path to Wellness
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 relative">
            <!-- Connection Line -->
            <div class="hidden md:block absolute top-20 left-0 right-0 h-1 bg-gradient-to-r from-green-400 via-blue-400 to-purple-400 z-0"></div>
            
            <!-- Step 1 -->
            <div class="relative z-10">
              <div class="text-center">
                <div class="w-16 h-16 rounded-full mx-auto mb-4 bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg hover:shadow-xl transition transform hover:scale-110">
                  1
                </div>
                <div class="bg-green-50 border-2 border-green-200 rounded-lg p-4">
                  <p class="font-bold text-gray-900 text-sm">Play Games</p>
                  <p class="text-xs text-gray-600 mt-2">Earn points and build streaks with therapeutic games</p>
                </div>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="relative z-10">
              <div class="text-center">
                <div class="w-16 h-16 rounded-full mx-auto mb-4 bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg hover:shadow-xl transition transform hover:scale-110">
                  2
                </div>
                <div class="bg-blue-50 border-2 border-blue-200 rounded-lg p-4">
                  <p class="font-bold text-gray-900 text-sm">Track Progress</p>
                  <p class="text-xs text-gray-600 mt-2">Monitor your wellness data with detailed analytics</p>
                </div>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="relative z-10">
              <div class="text-center">
                <div class="w-16 h-16 rounded-full mx-auto mb-4 bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg hover:shadow-xl transition transform hover:scale-110">
                  3
                </div>
                <div class="bg-purple-50 border-2 border-purple-200 rounded-lg p-4">
                  <p class="font-bold text-gray-900 text-sm">Learn & Grow</p>
                  <p class="text-xs text-gray-600 mt-2">Access expert resources and wellness guides</p>
                </div>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="relative z-10">
              <div class="text-center">
                <div class="w-16 h-16 rounded-full mx-auto mb-4 bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg hover:shadow-xl transition transform hover:scale-110">
                  4
                </div>
                <div class="bg-amber-50 border-2 border-amber-200 rounded-lg p-4">
                  <p class="font-bold text-gray-900 text-sm">Achieve Goals</p>
                  <p class="text-xs text-gray-600 mt-2">Reach wellness milestones and celebrate wins</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Additional Info -->
          <div class="bg-gradient-to-r from-indigo-50 to-blue-50 border-2 border-indigo-200 rounded-xl p-6 mt-6">
            <h4 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
              <span class="text-2xl">💡</span> Tips for Success
            </h4>
            <ul class="space-y-2 text-sm text-gray-700">
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold flex-shrink-0 mt-0.5">✓</span>
                <span><strong>Play daily:</strong> Consistency is key to building wellness habits and maintaining your streak</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold flex-shrink-0 mt-0.5">✓</span>
                <span><strong>Journal regularly:</strong> Reflect on your emotions and track patterns in your wellness journey</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold flex-shrink-0 mt-0.5">✓</span>
                <span><strong>Read articles:</strong> Expand your knowledge with expert-reviewed mental health content</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold flex-shrink-0 mt-0.5">✓</span>
                <span><strong>Set goals:</strong> Define wellness goals and track your progress toward them</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Enhanced Modal Footer -->
      <div class="sticky bottom-0 bg-gradient-to-r from-gray-50 to-gray-100 border-t-2 border-gray-200 p-6 flex justify-between items-center gap-4">
        <div id="footerInfo" class="text-sm text-gray-600 font-medium">
          <span id="footerText">Ready to start your wellness journey?</span>
        </div>
        <div class="flex gap-3">
          <button onclick="closeInfoModal()" class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition font-semibold hover:shadow-md">Close</button>
          <button id="actionBtn" onclick="handleModalAction()" class="px-6 py-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg hover:from-green-700 hover:to-emerald-700 transition font-semibold shadow-md hover:shadow-lg flex items-center gap-2 hover:-translate-y-0.5">
            <span id="actionBtnText">Get Started</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ===== EMOTION TO EMOJI MAPPING - GLOBAL =====
    const emotionEmojis = {
      'happy': '😊',
      'sad': '😢',
      'angry': '😠',
      'fearful': '😨',
      'neutral': '😐',
      'disgusted': '🤢',
      'surprised': '😮',
      'anxious': '😰'
    };

    // Info Modal Functions
    function openInfoModal(section = 'how-works') {
      const modal = document.getElementById('infoModal');
      
      if (!modal) return;

      const modalTitle = document.getElementById('modalTitle');
      const modalIcon = document.getElementById('modalIcon');
      const actionBtnText = document.getElementById('actionBtnText');
      const footerText = document.getElementById('footerText');
      
      // Hide all sections
      const howWorksContent = document.getElementById('how-works-content');
      const featuresContent = document.getElementById('features-content');
      const pathContent = document.getElementById('path-content');

      if (howWorksContent) howWorksContent.classList.add('hidden');
      if (featuresContent) featuresContent.classList.add('hidden');
      if (pathContent) pathContent.classList.add('hidden');

      // Show selected section and update title, icon, and action button
      switch(section) {
        case 'features':
          if (featuresContent) featuresContent.classList.remove('hidden');
          if (modalTitle) modalTitle.textContent = 'Key Features';
          if (modalIcon) modalIcon.textContent = '✨';
          if (actionBtnText) actionBtnText.textContent = 'Explore Features';
          if (footerText) footerText.textContent = 'Discover what makes Tellngrow special';
          break;
        case 'path':
          if (pathContent) pathContent.classList.remove('hidden');
          if (modalTitle) modalTitle.textContent = 'Your Path to Wellness';
          if (modalIcon) modalIcon.textContent = '🚀';
          if (actionBtnText) actionBtnText.textContent = 'Start Now';
          if (footerText) footerText.textContent = 'Your wellness journey starts here!';
          break;
        default:
          if (howWorksContent) howWorksContent.classList.remove('hidden');
          if (modalTitle) modalTitle.textContent = 'How Tellngrow Works';
          if (modalIcon) modalIcon.textContent = '📚';
          if (actionBtnText) actionBtnText.textContent = 'Get Started';
          if (footerText) footerText.textContent = 'Ready to start your wellness journey?';
      }

      modal.classList.remove('modal-hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeInfoModal() {
      const modal = document.getElementById('infoModal');
      if (modal) {
        modal.classList.add('modal-hidden');
        document.body.style.overflow = 'auto';
      }
    }

    function handleModalAction() {
      // Scroll to games section or navigate to appropriate page
      closeInfoModal();
      const gameCard = document.querySelector('.game-card');
      if (gameCard) {
        gameCard.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // Initialize modal event listeners when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOMContentLoaded - Setting up modal listeners');
      
      // Load mood greeting on dashboard
      loadMoodGreetingOnDashboard();
      
      const infoModal = document.getElementById('infoModal');
      if (infoModal) {
        infoModal.addEventListener('click', function(e) {
          if (e.target === this) {
            closeInfoModal();
          }
        });
      }

      // Close modal with ESC key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          const modal = document.getElementById('infoModal');
          if (modal && !modal.classList.contains('modal-hidden')) {
            closeInfoModal();
          }
        }
      });

      // Load comment/reaction counts on page load
      const materials = document.querySelectorAll('[id^="comment-count-"]');
      materials.forEach(el => {
        const match = el.className.match(/comment-count-(\d+)/);
        if (match) {
          const materialId = match[1];
          loadMaterialStats(materialId);
        }
      });
    });

    // Load material stats (comment count and reaction count)
    async function loadMaterialStats(materialId) {
      try {
        const [commentsRes, reactionsRes] = await Promise.all([
          fetch(`/api/reading/${materialId}/comments?limit=1`),
          fetch(`/api/reading/${materialId}/reactions`)
        ]);

        if (commentsRes.ok) {
          const commentData = await commentsRes.json();
          const commentCount = document.querySelector(`.comment-count-${materialId}`);
          if (commentCount) {
            commentCount.textContent = commentData.pagination?.total || 0;
          }
        }

        if (reactionsRes.ok) {
          const reactionData = await reactionsRes.json();
          const reactionCount = document.querySelector(`.reaction-count-${materialId}`);
          if (reactionCount) {
            reactionCount.textContent = reactionData.total || 0;
          }
        }
      } catch (error) {
        console.error('Error loading material stats:', error);
      }
    }

    // Sidebar functionality with auto-close
    function openSidebar() {
      document.getElementById('sidebar').classList.add('open');
      document.getElementById('overlay').classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('overlay').classList.remove('show');
      document.body.style.overflow = 'auto';
    }

    // Auto-close sidebar when moving away from left edge
    let sidebarHoverTimeout;
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');
    const edgeTrigger = document.getElementById('edgeTrigger');

    if (sidebar) {
      sidebar.addEventListener('mouseenter', function() {
        clearTimeout(sidebarHoverTimeout);
      });

      sidebar.addEventListener('mouseleave', function() {
        sidebarHoverTimeout = setTimeout(() => {
          closeSidebar();
        }, 300);
      });
    }

    if (overlay) {
      overlay.addEventListener('mouseenter', function() {
        clearTimeout(sidebarHoverTimeout);
      });

      overlay.addEventListener('mouseleave', function() {
        sidebarHoverTimeout = setTimeout(() => {
          closeSidebar();
        }, 300);
      });
    }

    // Close sidebar on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeSidebar();
      }
    });

    // Auto-open sidebar when cursor moves to left edge
    let sidebarOpenTimeout;
    document.addEventListener('mousemove', function(e) {
      // If cursor is within 30px from left edge, open sidebar
      if (e.clientX < 30) {
        if (!sidebarOpenTimeout) {
          sidebarOpenTimeout = setTimeout(() => {
            const sidebar = document.getElementById('sidebar');
            if (sidebar && !sidebar.classList.contains('open')) {
              openSidebar();
            }
          }, 300); // 300ms delay to prevent accidental triggers
        }
      } else {
        // Clear timeout if cursor moves away
        if (sidebarOpenTimeout) {
          clearTimeout(sidebarOpenTimeout);
          sidebarOpenTimeout = null;
        }
      }
    });



    // Fetch and update user progress - Real-time updates
    async function updateUserProgress() {
      try {
        const response = await fetch('/api/user/progress');
        
        if (!response.ok) {
          console.error('API Error:', response.status, response.statusText);
          return;
        }
        
        const progress = await response.json();
        console.log('Progress:', progress);
        
        if (progress) {
          // Update points
          const pointsElement = document.querySelector('[data-stat="points"]');
          if (pointsElement) {
            const newPoints = (progress.totalPoints || 0).toLocaleString();
            if (pointsElement.textContent !== newPoints) {
              pointsElement.textContent = newPoints;
              pointsElement.classList.add('text-green-600', 'font-bold');
              setTimeout(() => {
                pointsElement.classList.remove('text-green-600', 'font-bold');
              }, 1500);
            }
          }
          
          // Update level
          const levelElement = document.querySelector('[data-stat="level"]');
          if (levelElement) {
            levelElement.textContent = progress.level || 'beginner';
          }
          
          // Update streak
          const streakElement = document.querySelector('[data-stat="streak"]');
          if (streakElement) {
            streakElement.textContent = progress.currentStreak || 0;
          }

          // Update longest streak
          const longestElement = document.querySelector('[data-stat="longest-streak"]');
          if (longestElement) {
            longestElement.textContent = progress.longestStreak || 0;
          }
          
          // Update games
          const gamesElement = document.querySelector('[data-stat="games"]');
          if (gamesElement) {
            gamesElement.textContent = progress.totalGamesPlayed || 0;
          }
        }
      } catch (error) {
        console.error('Error fetching progress:', error);
      }
    }

    // Update on page load
    document.addEventListener('DOMContentLoaded', () => {
      updateUserProgress();
    });

    // Real-time update every 2 seconds
    let updateInterval = setInterval(updateUserProgress, 2000);

    // Listen for storage changes when games are saved
    window.addEventListener('storage', function(e) {
      if (e.key === 'gameCompleted' || e.key === 'pointsUpdated') {
        updateUserProgress();
      }
    });

    // Update when page becomes visible (after playing a game)
    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) {
        updateUserProgress();
        clearInterval(updateInterval);
        updateInterval = setInterval(updateUserProgress, 1500);
      } else {
        clearInterval(updateInterval);
        updateInterval = setInterval(updateUserProgress, 5000);
      }
    });

    // Fast update on window focus
    window.addEventListener('focus', function() {
      updateUserProgress();
    });
  </script>

  <!-- Feedback Modal -->
  <div id="feedbackModal" class="fixed inset-0 z-50 overflow-y-auto backdrop-blur-sm modal-hidden">
    <div class="flex items-center justify-center w-full min-h-screen px-4 py-6 text-center">
      <!-- Background overlay with animation -->
      <div class="fixed inset-0 bg-gradient-to-b from-gray-500 to-gray-900 bg-opacity-50 transition-opacity hover:bg-opacity-60" onclick="closeFeedbackModal()"></div>

      <!-- Modal panel with enhanced styling -->
      <div class="relative bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all duration-300 max-w-lg w-full hover:shadow-3xl">
        <!-- Header with Gradient Background -->
        <div class="bg-gradient-to-r from-green-600 via-emerald-600 to-teal-600 px-6 pt-6 pb-4 sm:p-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-white bg-opacity-20 animate-pulse">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">Share Your Feedback</h3>
              <p class="mt-1 text-sm text-emerald-50">Help us improve Tellngrow by sharing your thoughts</p>
            </div>
          </div>
        </div>

        <!-- Form Content -->
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
          <form id="feedbackForm" class="space-y-6">
            <!-- Feedback Type -->
            <div>
              <label for="feedbackType" class="block text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">
                <span class="text-lg">📋</span>
                Type of Feedback
                <span class="text-red-600">*</span>
              </label>
              <select id="feedbackType" name="type" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600 transition font-medium bg-white hover:border-green-400">
                <option value="">-- Select a Category --</option>
                <option value="feedback">💭 General Feedback</option>
                <option value="feature_request">💡 Feature Request</option>
                <option value="bug_report">🐛 Bug Report</option>
                <option value="complaint">⚠️ Complaint</option>
                <option value="other">❓ Other</option>
              </select>
              <p class="mt-2 text-xs text-gray-600">Choose the category that best describes your feedback</p>
            </div>

            <!-- Subject -->
            <div>
              <label for="feedbackSubject" class="block text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">
                <span class="text-lg">🎯</span>
                Subject
                <span class="text-red-600">*</span>
              </label>
              <input type="text" id="feedbackSubject" name="subject" required placeholder="Brief summary of your feedback" maxlength="255" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600 transition font-medium">
              <p class="mt-2 text-xs text-gray-600">Max 255 characters</p>
            </div>

            <!-- Message -->
            <div>
              <label for="feedbackMessage" class="block text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">
                <span class="text-lg">💬</span>
                Message
                <span class="text-red-600">*</span>
              </label>
              <div class="relative">
                <textarea id="feedbackMessage" name="message" required placeholder="Please provide detailed feedback or describe the issue..." rows="5" minlength="10" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600 transition font-medium resize-none"></textarea>
                <div class="absolute bottom-3 right-3 text-xs font-semibold text-gray-500">
                  <span id="charCount">0</span>/500
                </div>
              </div>
              <p class="mt-2 text-xs text-gray-600">Minimum 10 characters, maximum 500 characters</p>
            </div>

            <!-- Tips Section -->
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-lg p-4">
              <p class="text-xs font-bold text-gray-900 mb-2 flex items-center gap-2">
                <span class="text-lg">💡</span>
                Tips for Better Feedback
              </p>
              <ul class="text-xs text-gray-700 space-y-1">
                <li>✓ Be specific and clear about what you're experiencing</li>
                <li>✓ Include steps to reproduce if reporting a bug</li>
                <li>✓ Tell us about your use case for feature requests</li>
              </ul>
            </div>

            <!-- Status Message -->
            <div id="feedbackStatus" class="hidden px-4 py-3 rounded-lg text-sm font-medium border-2"></div>

            <!-- Buttons -->
            <div class="mt-8 sm:flex sm:flex-row-reverse gap-3">
              <button type="submit" id="feedbackSubmitBtn" class="w-full inline-flex justify-center items-center rounded-lg border border-transparent shadow-md px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-base font-bold text-white hover:from-green-700 hover:to-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-600 sm:w-auto sm:text-sm transition transform hover:scale-105 active:scale-95">
                <span id="submitBtnText" class="flex items-center gap-2">
                  <span>Send Feedback</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                </span>
                <span id="submitBtnLoader" class="hidden ml-2 flex items-center gap-1">
                  <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span>Sending...</span>
                </span>
              </button>
              <button type="button" onclick="closeFeedbackModal()" class="w-full inline-flex justify-center rounded-lg border-2 border-gray-300 shadow-md px-6 py-3 bg-white text-base font-bold text-gray-700 hover:bg-gray-50 hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 sm:w-auto sm:text-sm transition">
                Cancel
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Feedback Modal Functions
    function openFeedbackModal() {
      const modal = document.getElementById('feedbackModal');
      if (modal) {
        modal.classList.remove('modal-hidden');
      }
      const form = document.getElementById('feedbackForm');
      if (form) form.reset();
      const statusDiv = document.getElementById('feedbackStatus');
      if (statusDiv) statusDiv.classList.add('hidden');
    }

    function closeFeedbackModal() {
      const modal = document.getElementById('feedbackModal');
      if (modal) {
        modal.classList.add('modal-hidden');
      }
      const form = document.getElementById('feedbackForm');
      if (form) form.reset();
      const statusDiv = document.getElementById('feedbackStatus');
      if (statusDiv) statusDiv.classList.add('hidden');
      const charCount = document.getElementById('charCount');
      if (charCount) charCount.textContent = '0';
    }

    // Handle feedback form submission and setup listeners on DOM ready
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Setting up feedback modal listeners');
      
      // Character counter for feedback message
      const feedbackMessage = document.getElementById('feedbackMessage');
      if (feedbackMessage) {
        feedbackMessage.addEventListener('input', function() {
          const charCount = document.getElementById('charCount');
          if (charCount) {
            charCount.textContent = this.value.length;
            
            // Add visual feedback based on character count
            if (this.value.length < 10) {
              this.classList.remove('border-green-500', 'focus:border-green-600');
              this.classList.add('border-red-300');
            } else if (this.value.length > 450) {
              this.classList.remove('border-green-500', 'focus:border-green-600');
              this.classList.add('border-amber-300');
            } else {
              this.classList.remove('border-red-300', 'border-amber-300');
              this.classList.add('border-green-500', 'focus:border-green-600');
            }
          }
        });
      }

      // Close modal when clicking outside
      const feedbackModal = document.getElementById('feedbackModal');
      if (feedbackModal) {
        feedbackModal.addEventListener('click', function(e) {
          if (e.target === this) {
            closeFeedbackModal();
          }
        });
      }

      // Handle feedback form submission
      const feedbackForm = document.getElementById('feedbackForm');
      if (feedbackForm) {
        feedbackForm.addEventListener('submit', async function(e) {
      e.preventDefault();

      const submitBtn = document.getElementById('feedbackSubmitBtn');
      const submitBtnText = document.getElementById('submitBtnText');
      const submitBtnLoader = document.getElementById('submitBtnLoader');
      const statusDiv = document.getElementById('feedbackStatus');
      const form = document.getElementById('feedbackForm');

      // Validate form
      const feedbackType = document.getElementById('feedbackType').value;
      const subject = document.getElementById('feedbackSubject').value.trim();
      const message = document.getElementById('feedbackMessage').value.trim();

      if (!feedbackType) {
        showStatusMessage('Please select a feedback type', 'error', statusDiv);
        form.classList.add('shake');
        setTimeout(() => form.classList.remove('shake'), 600);
        return;
      }

      if (message.length < 10) {
        showStatusMessage('Message must be at least 10 characters', 'error', statusDiv);
        document.getElementById('feedbackMessage').focus();
        return;
      }

      if (message.length > 500) {
        showStatusMessage('Message cannot exceed 500 characters', 'error', statusDiv);
        document.getElementById('feedbackMessage').focus();
        return;
      }

      // Disable button
      submitBtn.disabled = true;
      submitBtnText.classList.add('hidden');
      submitBtnLoader.classList.remove('hidden');

      try {
        const response = await fetch('/user/feedback', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            type: feedbackType,
            subject: subject,
            message: message
          })
        });

        const data = await response.json();

        if (data.success) {
          // Show success message with animation
          showStatusMessage('✨ Thank you! Your feedback has been sent successfully. We appreciate your input!', 'success', statusDiv);
          
          // Add success animation
          statusDiv.classList.add('animate-pulse');
          
          // Clear form and close after delay
          setTimeout(() => {
            closeFeedbackModal();
          }, 2500);
        } else {
          // Show error message
          const errorMsg = data.error || 'An error occurred while sending your feedback';
          showStatusMessage('⚠️ ' + errorMsg + '. Please try again.', 'error', statusDiv);
          form.classList.add('shake');
          setTimeout(() => form.classList.remove('shake'), 600);
        }
      } catch (error) {
        console.error('Feedback submission error:', error);
        showStatusMessage('🌐 Network error. Please check your connection and try again.', 'error', statusDiv);
        form.classList.add('shake');
        setTimeout(() => form.classList.remove('shake'), 600);
      } finally {
        // Re-enable button
        submitBtn.disabled = false;
        submitBtnText.classList.remove('hidden');
        submitBtnLoader.classList.add('hidden');
      }
        });
      }
    });

    // Helper function to show status messages with styling
    function showStatusMessage(message, type, statusDiv) {
      if (type === 'success') {
        statusDiv.className = 'px-6 py-4 rounded-lg text-sm font-semibold bg-gradient-to-r from-green-50 to-emerald-50 text-green-900 border-2 border-green-400 shadow-md';
      } else {
        statusDiv.className = 'px-6 py-4 rounded-lg text-sm font-semibold bg-gradient-to-r from-red-50 to-pink-50 text-red-900 border-2 border-red-400 shadow-md';
      }
      statusDiv.textContent = message;
      statusDiv.classList.remove('hidden');
    }

    // Add shake animation CSS
    const style = document.createElement('style');
    style.textContent = `
      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-10px); }
        75% { transform: translateX(10px); }
      }
      .shake {
        animation: shake 0.6s ease-in-out;
      }
    `;
    document.head.appendChild(style);

    // ===== LOAD MOOD GREETING ON DASHBOARD =====
    async function loadMoodGreetingOnDashboard() {
      try {
        console.log('📊 Loading mood greeting data...');
        const response = await fetch('/api/user/mood/dashboard');
        
        if (!response.ok) {
          throw new Error(`API error: ${response.status}`);
        }
        
        const data = await response.json();
        console.log('📊 Mood greeting data received:', data);
        
        if (data.success) {
          // Update greeting message
          const greetingText = document.getElementById('mood-greeting-text');
          if (greetingText && data.greeting) {
            greetingText.innerHTML = data.greeting
              .split('\n')
              .map(line => line.replace(/Hello Student/g, 'Hello') + '<br>')
              .join('')
              .slice(0, -4); // Remove last <br>
          }

          // Get DOM elements
          const moodEmojiElement = document.getElementById('mood-emoji');
          const moodAlert = document.getElementById('mood-alert');
          const moodAlertMessage = document.getElementById('mood-alert-message');
          
          console.log('🔍 DOM Elements found:', { moodEmojiElement: !!moodEmojiElement, moodAlert: !!moodAlert, moodAlertMessage: !!moodAlertMessage });
          
          if (data.moodData && data.moodData.trend) {
            const moodData = data.moodData;
            const lastEmotion = moodData.trend?.lastEmotion; // Get last mood entry emotion from trend
            const trend = moodData.trend;
            
            console.log('📈 Mood data:', { lastEmotion, trend });
            
            // ===== UPDATE: Display emoji from last mood entry =====
            if (moodEmojiElement) {
              if (lastEmotion) {
                // We have a mood entry - show it
                const emoji = emotionEmojis[lastEmotion] || '😐';
                moodEmojiElement.textContent = emoji;
                moodEmojiElement.style.cursor = 'pointer';
                moodEmojiElement.style.transition = 'transform 0.3s ease, filter 0.3s ease';
                moodEmojiElement.title = `Your last mood: ${lastEmotion} - Click to view details`;
                
                // Add click handler to view mood entry details
                moodEmojiElement.onclick = function() {
                  showLastMoodEntryModal(lastEmotion, trend);
                };
                
                // Add hover effect
                moodEmojiElement.onmouseenter = function() {
                  this.style.transform = 'scale(1.2) rotate(10deg)';
                  this.style.filter = 'drop-shadow(0 4px 8px rgba(22, 163, 74, 0.3))';
                };
                
                moodEmojiElement.onmouseleave = function() {
                  this.style.transform = 'scale(1)';
                  this.style.filter = 'none';
                };
                
                console.log('✅ Mood emoji displayed:', emoji);
              } else {
                // No mood entry yet - show default and add click to record mood
                moodEmojiElement.textContent = '🎯';
                moodEmojiElement.style.cursor = 'pointer';
                moodEmojiElement.title = 'Click to record your first mood';
                moodEmojiElement.onclick = function() {
                  document.querySelector('#mood-picker-section')?.scrollIntoView({ behavior: 'smooth' });
                };
                console.log('ℹ️ No mood data yet - showing default emoji');
              }
            }
            
            // ===== Display mood trend alert =====
            if (moodAlert && moodAlertMessage) {
              // Define emotion-specific messages WITH EMOJI
              const emotionMessages = {
                'happy': { 
                  msg: '<span class="text-2xl mr-2 inline-block">😊</span> 💪 Keep it up! You\'re doing amazing! Your positive energy is inspiring.',
                  color: 'bg-green-50 border-green-500'
                },
                'surprised': {
                  msg: '<span class="text-2xl mr-2 inline-block">😮</span> ✨ That\'s exciting! Embrace this new experience with openness!',
                  color: 'bg-green-50 border-green-500'
                },
                'neutral': {
                  msg: '<span class="text-2xl mr-2 inline-block">😐</span> 🎯 Take a moment to reflect on what might lift your mood today.',
                  color: 'bg-blue-50 border-blue-500'
                },
                'sad': {
                  msg: '<span class="text-2xl mr-2 inline-block">😢</span> 💙 We\'re here for you. Talk to your counselor or try some activities to feel better.',
                  color: 'bg-yellow-50 border-yellow-500'
                },
                'angry': {
                  msg: '<span class="text-2xl mr-2 inline-block">😠</span> 🔥 Your feelings are valid. Talk to your counselor or do activities to channel this energy.',
                  color: 'bg-yellow-50 border-yellow-500'
                },
                'fearful': {
                  msg: '<span class="text-2xl mr-2 inline-block">😨</span> 🤝 Remember, you\'re not alone. Talk to your counselor for support.',
                  color: 'bg-yellow-50 border-yellow-500'
                },
                'anxious': {
                  msg: '<span class="text-2xl mr-2 inline-block">😰</span> 🌊 Let\'s ease that anxiety. Talk to your counselor or try calming activities.',
                  color: 'bg-yellow-50 border-yellow-500'
                },
                'disgusted': {
                  msg: '<span class="text-2xl mr-2 inline-block">🤢</span> 💚 Process these feelings with support. Talk to your counselor or do helpful activities.',
                  color: 'bg-yellow-50 border-yellow-500'
                }
              };
              
              let alertMessage = '';
              let alertClass = '';
              
              // If there's a last mood entry, show that emotion's message WITH EMOJI
              if (lastEmotion && emotionMessages[lastEmotion]) {
                alertMessage = emotionMessages[lastEmotion].msg;
                alertClass = emotionMessages[lastEmotion].color;
                console.log('📌 Showing mood alert for emotion:', lastEmotion);
              } else if (trend && trend.isDeclining) {
                // Fallback to trend-based message if no last emotion
                alertMessage = `
                  <span class="text-yellow-700 font-bold">⚠️ Mood Trend Alert:</span><br>
                  Your mood has been trending lower recently (Score: ${trend.averageScore}/100).
                  We recommend talking to your counselor or trying some wellness activities.
                `;
                alertClass = 'bg-yellow-50 border-yellow-500';
                console.log('📌 Showing trend alert - declining');
              } else if (trend && trend.trend === 'improving') {
                alertMessage = `
                  <span class="text-green-700 font-bold">✨ Great Progress:</span><br>
                  Your mood has been improving! Keep up the great work!
                `;
                alertClass = 'bg-green-50 border-green-500';
                console.log('📌 Showing trend alert - improving');
              } else if (trend && trend.trend === 'stable') {
                alertMessage = `
                  <span class="text-blue-700 font-bold">😌 Mood Status:</span><br>
                  Your mood has been stable. Keep taking care of yourself!
                `;
                alertClass = 'bg-blue-50 border-blue-500';
                console.log('📌 Showing trend alert - stable');
              }
              
              if (alertMessage) {
                moodAlertMessage.innerHTML = alertMessage;
                moodAlert.classList.remove('hidden', 'bg-yellow-50', 'border-yellow-500', 'bg-green-50', 'border-green-500', 'bg-blue-50', 'border-blue-500', 'bg-emerald-50', 'border-emerald-500');
                
                // Apply appropriate styling
                alertClass.split(' ').forEach(cls => {
                  if (cls) moodAlert.classList.add(cls);
                });
                console.log('✅ Mood alert displayed');
              } else {
                console.log('⚠️ No alert message to display - may be first time');
                moodAlert.classList.add('hidden');
              }
            }
          } else {
            console.log('⚠️ No moodData in API response or trend missing');
            // Ensure elements are visible but indicate no data
            if (moodEmojiElement) {
              moodEmojiElement.textContent = '👋';
              console.log('ℹ️ Showing default greeting emoji');
            }
          }
        } else {
          console.error('❌ API returned success: false', data);
        }
      } catch (error) {
        console.error('❌ Error loading mood greeting:', error);
        // Fallback: show default emoji
        const moodEmojiElement = document.getElementById('mood-emoji');
        if (moodEmojiElement) {
          moodEmojiElement.textContent = '👋';
        }
      }
    }

    // ===== SHOW LAST MOOD ENTRY MODAL =====
    function showLastMoodEntryModal(emotion, trendData) {
      console.log('📊 Showing mood entry modal for:', emotion);
      
      const emotionEmoji = emotionEmojis[emotion] || '😐';
      const emotionLabel = emotion.charAt(0).toUpperCase() + emotion.slice(1);
      const confidence = trendData?.emotionConfidence || 0;
      const entryDate = trendData?.lastEntryDate ? new Date(trendData.lastEntryDate).toLocaleDateString() : 'Recently';
      
      // Create and show modal
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 backdrop-blur-sm';
      modal.innerHTML = `
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full transform transition-all duration-300 scale-100">
          <!-- Modal Header -->
          <div class="bg-gradient-to-r from-green-600 via-emerald-600 to-teal-600 text-white p-8 flex justify-between items-start gap-4">
            <div class="flex-1">
              <div class="text-6xl mb-4">${emotionEmoji}</div>
              <h2 class="text-3xl font-bold">Your Last Mood Entry</h2>
              <p class="mt-2 text-emerald-50 text-sm">Emotion: <strong>${emotionLabel}</strong></p>
            </div>
            <button onclick="this.closest('.fixed').remove();" class="text-white hover:bg-white hover:bg-opacity-20 rounded-lg p-2 transition flex-shrink-0 hover:scale-110">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Modal Content -->
          <div class="p-8 space-y-6">
            <!-- Emotion Details -->
            <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-lg p-6">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Emotion</p>
                  <p class="text-2xl font-bold text-gray-900 mt-2">${emotionLabel}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Confidence</p>
                  <p class="text-2xl font-bold text-gray-900 mt-2">${Math.round(confidence)}%</p>
                </div>
              </div>
            </div>

            <!-- Entry Date -->
            <div class="border-l-4 border-green-600 bg-green-50 p-4 rounded-r-lg">
              <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1">Recorded</p>
              <p class="text-sm text-gray-700 font-medium">${entryDate}</p>
            </div>

            <!-- Helpful Tips -->
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-lg p-4">
              <p class="text-xs font-bold text-gray-900 mb-3 flex items-center gap-2">
                <span class="text-lg">💡</span> Recommended Actions
              </p>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-start gap-2">
                  <span class="text-green-600 font-bold flex-shrink-0 mt-0.5">→</span>
                  <span>Track your mood regularly to understand patterns</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 font-bold flex-shrink-0 mt-0.5">→</span>
                  <span>Try therapeutic games to support your wellness</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 font-bold flex-shrink-0 mt-0.5">→</span>
                  <span>Journal your feelings for deeper insights</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="bg-gradient-to-r from-gray-50 to-gray-100 border-t-2 border-gray-200 p-6 flex justify-end gap-3">
            <a href="/user/mood-tracker" class="px-6 py-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg hover:from-green-700 hover:to-emerald-700 transition font-semibold shadow-md hover:shadow-lg">
              View Mood Tracker
            </a>
            <button onclick="this.closest('.fixed').remove();" class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition font-semibold">
              Close
            </button>
          </div>
        </div>
      `;
      
      // Close modal when clicking outside
      modal.addEventListener('click', function(e) {
        if (e.target === this) {
          this.remove();
        }
      });
      
      document.body.appendChild(modal);
    }

    // ===== MOOD PICKER FUNCTIONS =====
    let selectedEmotion = null;

    function selectEmotion(emotion, buttonElement) {
      console.log('🧠 Selected emotion:', emotion);
      
      // Update UI - highlight selected button ONLY
      document.querySelectorAll('.emotion-btn').forEach(btn => {
        btn.classList.remove('selected');
      });
      buttonElement.classList.add('selected');
      selectedEmotion = emotion;
      
      // Hide suggestions container - will show after save
      const suggestionsContainer = document.getElementById('suggestions-container');
      suggestionsContainer.classList.remove('show');
      
      console.log('✨ Emotion selected:', emotion, '- Click Save to see suggestions');
    }

    function clearMoodSelection() {
      console.log('🗑️ Clearing mood selection');
      
      // Reset UI
      document.querySelectorAll('.emotion-btn').forEach(btn => {
        btn.classList.remove('selected');
      });
      
      const suggestionsContainer = document.getElementById('suggestions-container');
      suggestionsContainer.classList.remove('show');
      
      selectedEmotion = null;
    }

    async function saveMoodEntry() {
      if (!selectedEmotion) {
        alert('Please select an emotion first!');
        return;
      }

      console.log('💾 Saving mood entry:', selectedEmotion);

      const saveBtn = document.getElementById('save-mood-btn');
      const originalText = saveBtn.innerHTML;
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<span class="spinner"></span> Saving...';

      try {
        const response = await fetch('/api/mood/save', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            detectedEmotion: selectedEmotion,
            emotionConfidence: 95,
            userResponse: 'yes',
            userConfirmed: true,
            userNote: 'Selected from dashboard'
          })
        });

        console.log('📡 API Response Status:', response.status, response.statusText);
        
        const data = await response.json();
        console.log('📦 API Response Data:', data);

        // Check if response is ok (status 200-299)
        if (!response.ok) {
          throw new Error(data.message || data.error || `Server error: ${response.statusText}`);
        }

        if (data.success) {
          console.log('✅ Mood saved successfully!', data);
          
          // Show success message
          saveBtn.innerHTML = '✅ Mood Saved!';
          saveBtn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
          
          // NOW fetch and show suggestions
          await displaySuggestionsAfterSave(selectedEmotion);
          
          // Update greeting card with emotion-based message
          await updateGreetingCardAfterMoodSave(selectedEmotion);
          
          // Reset after 3 seconds
          setTimeout(() => {
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalText;
            saveBtn.style.background = '';
            
            // Show success notification
            showMoodNotification(`Your ${selectedEmotion} mood has been recorded! 🎉`, 'success');
          }, 3000);
        } else {
          throw new Error(data.error || 'Failed to save mood');
        }
      } catch (error) {
        console.error('❌ Error saving mood:', error);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        showMoodNotification(`Error: ${error.message}`, 'error');
      }
    }

    async function displaySuggestionsAfterSave(emotion) {
      const suggestionsContainer = document.getElementById('suggestions-container');
      const loadingState = document.getElementById('loading-state');
      const suggestionsList = document.getElementById('suggestions-list');
      
      // Show suggestions container with loading
      suggestionsContainer.classList.add('show');
      loadingState.style.display = 'flex';
      suggestionsList.innerHTML = '';

      try {
        const response = await fetch('/api/mood/suggestions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ emotion: emotion })
        });

        if (!response.ok) {
          throw new Error('Failed to fetch suggestions');
        }

        const data = await response.json();
        console.log('💡 Suggestions received:', data);

        loadingState.style.display = 'none';

        // Update suggestion intro message based on emotion
        const introMessages = {
          'happy': '🌟 Keep riding this wave of positivity!',
          'sad': '💙 We\'re here to support you. Try one of these activities.',
          'angry': '🔥 Channel that energy into something constructive.',
          'fearful': '💜 Take a moment to calm yourself. These activities can help.',
          'anxious': '🌊 Let\'s ease that anxiety with some calming activities.',
          'neutral': '😐 Take a moment to reflect or try something new.',
          'disgusted': '🤢 Process these feelings with helpful activities.',
          'surprised': '😲 Process this new experience with care.'
        };

        const introEl = document.getElementById('suggestion-intro');
        if (introEl) {
          introEl.textContent = introMessages[emotion] || 'Check out these suggestions for you!';
        }

        // Display suggestions
        if (data.activities && Array.isArray(data.activities)) {
          data.activities.forEach((activity, index) => {
            const suggestionEl = document.createElement('div');
            suggestionEl.className = 'suggestion-item';
            suggestionEl.style.animationDelay = `${index * 0.1}s`;
            suggestionEl.innerHTML = `
              <div class="suggestion-title">
                <span>${activity.icon || '🎯'}</span>
                <span>${activity.name}</span>
              </div>
              <div class="suggestion-desc">${activity.description}</div>
              ${activity.link ? `<a href="${activity.link}" class="suggestion-link">Open Activity →</a>` : ''}
            `;
            suggestionsList.appendChild(suggestionEl);
          });
        } else {
          suggestionsList.innerHTML = '<p class="text-gray-600">No specific suggestions for this mood, but remember to reach out to your counselor anytime!</p>';
        }

      } catch (error) {
        console.error('Error fetching suggestions:', error);
        loadingState.style.display = 'none';
        suggestionsList.innerHTML = '<p class="text-red-600 font-semibold">⚠️ Unable to load suggestions. Please try again.</p>';
      }
    }

    async function updateGreetingCardAfterMoodSave(emotion) {
      try {
        console.log('🔄 Reloading mood greeting after save...');
        
        // Reload the full greeting from API to get updated mood trend
        await loadMoodGreetingOnDashboard();
        
        // Also show emotion-specific confirmation message
        const goodEmotions = ['happy', 'surprised', 'neutral'];
        const badEmotions = ['sad', 'angry', 'fearful', 'anxious', 'disgusted'];
        
        const emotionMessages = {
          'happy': '💪 Keep it up! You\'re doing amazing! Your positive energy is inspiring.',
          'surprised': '✨ That\'s exciting! Embrace this new experience with openness!',
          'neutral': '🎯 Take a moment to reflect on what might lift your mood today.',
          'sad': '💙 We\'re here for you. Talk to your counselor or try some activities to feel better.',
          'angry': '🔥 Your feelings are valid. Talk to your counselor or do activities to channel this energy.',
          'fearful': '🤝 Remember, you\'re not alone. Talk to your counselor for support.',
          'anxious': '🌊 Let\'s ease that anxiety. Talk to your counselor or try calming activities.',
          'disgusted': '💚 Process these feelings with support. Talk to your counselor or do helpful activities.'
        };

        const moodAlert = document.getElementById('mood-alert');
        const moodAlertMessage = document.getElementById('mood-alert-message');

        if (moodAlert && moodAlertMessage) {
          // Update with emotion-specific message
          moodAlertMessage.innerHTML = emotionMessages[emotion] || 'Your mood has been recorded. Great job!';
          moodAlert.classList.remove('hidden', 'bg-yellow-50', 'border-yellow-500', 'bg-green-50', 'border-green-500', 'bg-blue-50', 'border-blue-500');
          
          // Style based on emotion type
          if (goodEmotions.includes(emotion)) {
            moodAlert.classList.add('bg-green-50', 'border-green-500');
          } else if (badEmotions.includes(emotion)) {
            moodAlert.classList.add('bg-yellow-50', 'border-yellow-500');
          }
          
          // Scroll to greeting card to show the updated message
          document.getElementById('mood-greeting-card')?.scrollIntoView({ behavior: 'smooth' });
          console.log('✅ Greeting card updated with emotion:', emotion);
        }
      } catch (error) {
        console.error('Error updating greeting card:', error);
      }
    }

    function showMoodNotification(message, type) {
      const notif = document.createElement('div');
      notif.className = `fixed top-6 right-6 p-4 rounded-lg shadow-lg text-white font-semibold z-50 animate-bounce`;
      notif.style.background = type === 'success' ? 'linear-gradient(135deg, #10b981 0%, #059669 100%)' : 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)';
      notif.textContent = message;
      
      document.body.appendChild(notif);
      
      setTimeout(() => {
        notif.remove();
      }, 3000);
    }

    // Load mood greeting when page loads
    document.addEventListener('DOMContentLoaded', loadMoodGreetingOnDashboard);
  </script>
  
  <!-- Unified Mood Tracker Module for persistent state -->
  <script src="/js/mood-tracker-unified.js?v=1"></script>
</body>
</html>
