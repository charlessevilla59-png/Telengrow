<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .section-header {
      font-size: 1.125rem;
      font-weight: 600;
      color: #7c3aed;
      margin-top: 1.5rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #ddd6fe;
    }
    
    .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .form-row.full {
      grid-template-columns: 1fr;
    }

    .form-row.two-col {
      grid-template-columns: repeat(2, 1fr);
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
      margin-bottom: 0.25rem;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 0.5rem 0.75rem;
      border: 1px solid #d1d5db;
      border-radius: 0.375rem;
      font-size: 0.875rem;
      font-family: inherit;
      background-color: white;
      color: #333;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #7c3aed;
      background-color: #faf5ff;
      ring: 2px;
      ring-color: #ddd6fe;
    }

    .radio-group,
    .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .radio-item,
    .checkbox-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
    }

    .radio-item input,
    .checkbox-item input {
      accent-color: #7c3aed;
      cursor: pointer;
    }

    .education-table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.875rem;
    }

    .education-table th,
    .education-table td {
      border: 1px solid #e5e7eb;
      padding: 0.5rem;
      text-align: left;
    }

    .education-table th {
      background-color: #f3e8ff;
      font-weight: 600;
      color: #6b21a8;
    }

    .education-table input {
      width: 100%;
      border: none;
      padding: 0.25rem;
      font-size: 0.875rem;
      background: transparent;
    }

    .education-table input:focus {
      background: white;
      border: 1px solid #7c3aed;
      outline: none;
    }

    textarea {
      resize: vertical;
      min-height: 80px;
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">
  {{> sidebar}}
  
  <nav class="bg-white shadow-md p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-purple-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <h1 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h1>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <!-- Back Button -->
    <div class="mb-4">
      <a href="/user/dashboard" class="inline-flex items-center text-purple-600 hover:text-purple-700 transition">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span class="font-medium">Back to Dashboard</span>
      </a>
    </div>

    <h1 class="text-3xl font-bold text-gray-800 mb-6">👤 My Profile</h1>
    
    <div class="bg-white rounded-xl shadow-md p-8 max-w-5xl mx-auto">
      {{#if error_msg}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          {{error_msg}}
        </div>
      {{/if}}
      {{#if success_msg}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
          {{success_msg}}
        </div>
      {{/if}}

      <form action="/user/profile" method="POST" enctype="multipart/form-data" class="space-y-6">
        <!-- Profile Picture Section -->
        <div class="flex flex-col items-center mb-8">
          <div class="relative">
            <div id="profilePicturePreview" class="w-32 h-32 rounded-full overflow-hidden border-4 border-purple-200 bg-gray-200 flex items-center justify-center">
              {{#if user.profilePicture}}
                <img src="{{user.profilePicture}}" alt="Profile" class="w-full h-full object-cover" />
              {{else}}
                <span class="text-5xl text-gray-400">👤</span>
              {{/if}}
            </div>
            <label for="profilePictureInput" class="absolute bottom-0 right-0 bg-purple-600 text-white rounded-full p-2 cursor-pointer hover:bg-purple-700 transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </label>
            <input type="file" id="profilePictureInput" name="profilePicture" accept="image/*" class="hidden" onchange="previewProfilePicture(event)" />
          </div>
          <p class="text-sm text-gray-500 mt-2">Click the camera icon to upload a photo</p>
          
          <!-- Avatar Selection -->
          <div class="mt-4">
            <p class="text-sm font-medium text-gray-700 mb-2">Or choose an avatar:</p>
            <div class="flex gap-2 flex-wrap justify-center">
              <button type="button" onclick="selectAvatar('👤')" class="avatar-btn text-4xl p-2 rounded-full hover:bg-purple-100 transition">👤</button>
              <button type="button" onclick="selectAvatar('😊')" class="avatar-btn text-4xl p-2 rounded-full hover:bg-purple-100 transition">😊</button>
              <button type="button" onclick="selectAvatar('🙂')" class="avatar-btn text-4xl p-2 rounded-full hover:bg-purple-100 transition">🙂</button>
              <button type="button" onclick="selectAvatar('😎')" class="avatar-btn text-4xl p-2 rounded-full hover:bg-purple-100 transition">😎</button>
              <button type="button" onclick="selectAvatar('🤓')" class="avatar-btn text-4xl p-2 rounded-full hover:bg-purple-100 transition">🤓</button>
              <button type="button" onclick="selectAvatar('😇')" class="avatar-btn text-4xl p-2 rounded-full hover:bg-purple-100 transition">😇</button>
              <button type="button" onclick="selectAvatar('🥰')" class="avatar-btn text-4xl p-2 rounded-full hover:bg-purple-100 transition">🥰</button>
              <button type="button" onclick="selectAvatar('🌟')" class="avatar-btn text-4xl p-2 rounded-full hover:bg-purple-100 transition">🌟</button>
            </div>
            <input type="hidden" id="selectedAvatar" name="selectedAvatar" value="" />
          </div>
        </div>

        <!-- Personal Information Section -->
        <div class="border-t pt-6">
          <h3 class="section-header">Personal Information</h3>
          
          <div class="form-row">
            <div class="form-group">
              <label>Name *</label>
              <input type="text" name="name" required value="{{user.name}}" />
            </div>
            <div class="form-group">
              <label>Nickname</label>
              <input type="text" name="nickname" value="{{user.nickname}}" />
            </div>
            <div class="form-group">
              <label>Age</label>
              <input type="number" name="age" min="1" max="120" value="{{user.age}}" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Date of Birth</label>
              <input type="date" name="dateOfBirth" value="{{formatDateForInput user.dateOfBirth}}" />
            </div>
            <div class="form-group">
              <label>Place of Birth</label>
              <input type="text" name="placeOfBirth" value="{{user.placeOfBirth}}" />
            </div>
            <div class="form-group">
              <label>Nationality</label>
              <input type="text" name="nationality" value="{{user.nationality}}" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Sex</label>
              <select name="sex">
                <option value="">Select</option>
                <option value="male" {{#if (eq user.sex 'male')}}selected{{/if}}>Male</option>
                <option value="female" {{#if (eq user.sex 'female')}}selected{{/if}}>Female</option>
                <option value="other" {{#if (eq user.sex 'other')}}selected{{/if}}>Other</option>
              </select>
            </div>
            <div class="form-group">
              <label>Email *</label>
              <input type="email" name="email" required value="{{user.email}}" />
            </div>
            <div class="form-group">
              <label>Civil Status</label>
              <select name="civilStatus">
                <option value="">Select</option>
                <option value="single" {{#if (eq user.civilStatus 'single')}}selected{{/if}}>Single</option>
                <option value="married" {{#if (eq user.civilStatus 'married')}}selected{{/if}}>Married</option>
                <option value="widowed" {{#if (eq user.civilStatus 'widowed')}}selected{{/if}}>Widowed</option>
                <option value="separated" {{#if (eq user.civilStatus 'separated')}}selected{{/if}}>Separated</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Religion</label>
              <input type="text" name="religion" value="{{user.religion}}" />
            </div>
            <div class="form-group">
              <label>Contact Number</label>
              <input type="tel" name="contactNumber" value="{{user.contactNumber}}" />
            </div>
            <div class="form-group">
              <label>Alternate Email</label>
              <input type="email" name="emailAlternate" value="{{user.emailAlternate}}" />
            </div>
          </div>

          <!-- Academic Information -->
          <div class="form-row">
            <div class="form-group">
              <label>Course <span style="color: #ef4444; font-weight: bold;">*</span></label>
              <select name="course" required>
                <option value="">Select Course</option>
                <option value="CPE" {{#if (eq user.course 'CPE')}}selected{{/if}}>CPE (Computer Engineering)</option>
                <option value="IT" {{#if (eq user.course 'IT')}}selected{{/if}}>IT (Information Technology)</option>
                <option value="BSFI" {{#if (eq user.course 'BSFI')}}selected{{/if}}>BSFI (Business Administration - Finance)</option>
                <option value="BSENTREP" {{#if (eq user.course 'BSENTREP')}}selected{{/if}}>BSENTREP (Business Administration - Entrepreneurship)</option>
                <option value="BEED" {{#if (eq user.course 'BEED')}}selected{{/if}}>BEED (Bachelor of Elementary Education)</option>
                <option value="EDUC" {{#if (eq user.course 'EDUC')}}selected{{/if}}>EDUC (Bachelor of Secondary Education)</option>
                <option value="CRIM" {{#if (eq user.course 'CRIM')}}selected{{/if}}>CRIM (Criminology)</option>
                <option value="TOURISM" {{#if (eq user.course 'TOURISM')}}selected{{/if}}>TOURISM (Tourism)</option>
                <option value="HM" {{#if (eq user.course 'HM')}}selected{{/if}}>HM (Hospitality Management)</option>
              </select>
            </div>
            <div class="form-group">
              <label>Year Level <span style="color: #ef4444; font-weight: bold;">*</span></label>
              <select name="year" required>
                <option value="">Select Year</option>
                <option value="1st" {{#if (eq user.year '1st')}}selected{{/if}}>1st Year</option>
                <option value="2nd" {{#if (eq user.year '2nd')}}selected{{/if}}>2nd Year</option>
                <option value="3rd" {{#if (eq user.year '3rd')}}selected{{/if}}>3rd Year</option>
                <option value="4th" {{#if (eq user.year '4th')}}selected{{/if}}>4th Year</option>
              </select>
            </div>
            <div class="form-group">
              <label>Section</label>
              <input type="text" name="section" value="{{user.section}}" placeholder="e.g., A, B, C" />
            </div>
          </div>
        </div>

        <!-- Address Information -->
        <div class="border-t pt-6">
          <h3 class="section-header">Address Information</h3>
          
          <div class="form-row full">
            <div class="form-group">
              <label>Current Address</label>
              <input type="text" name="currentAddress" value="{{user.currentAddress}}" />
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Permanent Address</label>
              <input type="text" name="permanentAddress" value="{{user.permanentAddress}}" />
            </div>
          </div>
        </div>

        <!-- Status & Background -->
        <div class="border-t pt-6">
          <h3 class="section-header">Status & Background</h3>
          
          <div class="form-row full">
            <div class="form-group">
              <label>Are you a part of LGBTQIA+?</label>
              <div class="radio-group">
                <div class="radio-item">
                  <input type="radio" name="lgbtqia" value="yes" {{#if (eq user.lgbtqia 'yes')}}checked{{/if}}>
                  <label>Yes</label>
                </div>
                <div class="radio-item">
                  <input type="radio" name="lgbtqia" value="no" {{#if (eq user.lgbtqia 'no')}}checked{{/if}}>
                  <label>No</label>
                </div>
              </div>
              <input type="text" name="lgbtqiaSpecify" placeholder="If yes, please specify" value="{{user.lgbtqiaSpecify}}" class="mt-2" />
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Are you a member of Indigenous Group?</label>
              <div class="radio-group">
                <div class="radio-item">
                  <input type="radio" name="indigenousGroup" value="yes" {{#if (eq user.indigenousGroup 'yes')}}checked{{/if}}>
                  <label>Yes</label>
                </div>
                <div class="radio-item">
                  <input type="radio" name="indigenousGroup" value="no" {{#if (eq user.indigenousGroup 'no')}}checked{{/if}}>
                  <label>No</label>
                </div>
              </div>
              <input type="text" name="indigenousGroupName" placeholder="If yes, please specify tribe" value="{{user.indigenousGroupName}}" class="mt-2" />
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Are you a Person with Disability?</label>
              <div class="radio-group">
                <div class="radio-item">
                  <input type="radio" name="personWithDisability" value="yes" {{#if (eq user.personWithDisability 'yes')}}checked{{/if}}>
                  <label>Yes</label>
                </div>
                <div class="radio-item">
                  <input type="radio" name="personWithDisability" value="no" {{#if (eq user.personWithDisability 'no')}}checked{{/if}}>
                  <label>No</label>
                </div>
              </div>
              <input type="text" name="disabilityType" placeholder="If yes, please specify" value="{{user.disabilityType}}" class="mt-2" />
            </div>
          </div>
        </div>

        <!-- Parents Information -->
        <div class="border-t pt-6">
          <h3 class="section-header">Parents Information</h3>
          
          <div class="form-row">
            <div class="form-group">
              <label>Father's Name</label>
              <input type="text" name="fatherName" value="{{user.fatherName}}" />
            </div>
            <div class="form-group">
              <label>Mother's Name</label>
              <input type="text" name="motherName" value="{{user.motherName}}" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Father's Occupation</label>
              <input type="text" name="fatherOccupation" value="{{user.fatherOccupation}}" />
            </div>
            <div class="form-group">
              <label>Mother's Occupation</label>
              <input type="text" name="motherOccupation" value="{{user.motherOccupation}}" />
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Parents Status (Check all that apply)</label>
              <div class="checkbox-group">
                <div class="checkbox-item">
                  <input type="checkbox" name="parentsStatus" value="living_together" {{#if (includes user.parentsStatus 'living_together')}}checked{{/if}}>
                  <label>Living Together</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="parentsStatus" value="temporarily_separated" {{#if (includes user.parentsStatus 'temporarily_separated')}}checked{{/if}}>
                  <label>Temporarily Separated</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="parentsStatus" value="permanently_separated" {{#if (includes user.parentsStatus 'permanently_separated')}}checked{{/if}}>
                  <label>Permanently Separated</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="parentsStatus" value="marriage_annulled" {{#if (includes user.parentsStatus 'marriage_annulled')}}checked{{/if}}>
                  <label>Marriage Annulled/Legally Separated</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="parentsStatus" value="father_ofw" {{#if (includes user.parentsStatus 'father_ofw')}}checked{{/if}}>
                  <label>Father OFW</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="parentsStatus" value="mother_ofw" {{#if (includes user.parentsStatus 'mother_ofw')}}checked{{/if}}>
                  <label>Mother OFW</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="parentsStatus" value="father_another_partner" {{#if (includes user.parentsStatus 'father_another_partner')}}checked{{/if}}>
                  <label>Father with Another Partner</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="parentsStatus" value="mother_another_partner" {{#if (includes user.parentsStatus 'mother_another_partner')}}checked{{/if}}>
                  <label>Mother with Another Partner</label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Family Income -->
        <div class="border-t pt-6">
          <h3 class="section-header">Annual Family Income</h3>
          
          <div class="form-row full">
            <div class="form-group">
              <div class="checkbox-group">
                <div class="checkbox-item">
                  <input type="checkbox" name="familyIncome" value="no_income" {{#if (includes user.familyIncome 'no_income')}}checked{{/if}}>
                  <label>No income</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="familyIncome" value="below_50k" {{#if (includes user.familyIncome 'below_50k')}}checked{{/if}}>
                  <label>Not over P10,000</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="familyIncome" value="50k_100k" {{#if (includes user.familyIncome '50k_100k')}}checked{{/if}}>
                  <label>Over P10,000 to P30,000</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="familyIncome" value="100k_150k" {{#if (includes user.familyIncome '100k_150k')}}checked{{/if}}>
                  <label>Over P30,000 to P70,000</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="familyIncome" value="150k_250k" {{#if (includes user.familyIncome '150k_250k')}}checked{{/if}}>
                  <label>Over P70,000 to P150,000</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="familyIncome" value="over_350k" {{#if (includes user.familyIncome 'over_350k')}}checked{{/if}}>
                  <label>Over 500,000</label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Emergency Contact -->
        <div class="border-t pt-6">
          <h3 class="section-header">Person to Notify in Case of Emergency</h3>
          
          <div class="form-row">
            <div class="form-group">
              <label>Name</label>
              <input type="text" name="emergencyContactName" value="{{user.emergencyContactName}}" />
            </div>
            <div class="form-group">
              <label>Relationship</label>
              <input type="text" name="emergencyContactRelation" value="{{user.emergencyContactRelation}}" />
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Address</label>
              <input type="text" name="emergencyContactAddress" value="{{user.emergencyContactAddress}}" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Contact Number</label>
              <input type="tel" name="emergencyContactNumber" value="{{user.emergencyContactNumber}}" />
            </div>
            <div class="form-group">
              <label>Email</label>
              <input type="email" name="emergencyContactEmail" value="{{user.emergencyContactEmail}}" />
            </div>
          </div>
        </div>

        <!-- Educational Background -->
        <div class="border-t pt-6">
          <h3 class="section-header">Educational Background</h3>
          
          <table class="education-table">
            <thead>
              <tr>
                <th>Level</th>
                <th>School Attended</th>
                <th>Dates</th>
                <th>Honors/Scholarships</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Elementary</td>
                <td><input type="text" name="elementarySchool" value="{{user.elementarySchool}}" /></td>
                <td><input type="text" name="elementaryDates" value="{{user.elementaryDates}}" /></td>
                <td><input type="text" name="elementaryHonors" value="{{user.elementaryHonors}}" /></td>
              </tr>
              <tr>
                <td>Junior High School</td>
                <td><input type="text" name="juniorHighSchool" value="{{user.juniorHighSchool}}" /></td>
                <td><input type="text" name="juniorDates" value="{{user.juniorDates}}" /></td>
                <td><input type="text" name="juniorHonors" value="{{user.juniorHonors}}" /></td>
              </tr>
              <tr>
                <td>Senior High School</td>
                <td><input type="text" name="seniorHighSchool" value="{{user.seniorHighSchool}}" /></td>
                <td><input type="text" name="seniorDates" value="{{user.seniorDates}}" /></td>
                <td><input type="text" name="seniorHonors" value="{{user.seniorHonors}}" /></td>
              </tr>
              <tr>
                <td>Vocational/Trade</td>
                <td><input type="text" name="vocationalCourse" value="{{user.vocationalCourse}}" /></td>
                <td><input type="text" name="vocationalDates" value="{{user.vocationalDates}}" /></td>
                <td><input type="text" name="vocationalHonors" value="{{user.vocationalHonors}}" /></td>
              </tr>
              <tr>
                <td>College</td>
                <td><input type="text" name="collegeName" value="{{user.collegeName}}" /></td>
                <td><input type="text" name="collegeDates" value="{{user.collegeDates}}" /></td>
                <td><input type="text" name="collegeHonors" value="{{user.collegeHonors}}" /></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Health Information -->
        <div class="border-t pt-6">
          <h3 class="section-header">General State of Health</h3>
          
          <div class="form-row full">
            <div class="form-group">
              <label>Common Health Concerns (Check all that apply)</label>
              <div class="checkbox-group">
                <div class="checkbox-item">
                  <input type="checkbox" name="healthConcerns" value="headache" {{#if (includes user.healthConcerns 'headache')}}checked{{/if}}>
                  <label>Headache</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="healthConcerns" value="stomach_trouble" {{#if (includes user.healthConcerns 'stomach_trouble')}}checked{{/if}}>
                  <label>Stomach Trouble</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="healthConcerns" value="cold_flu" {{#if (includes user.healthConcerns 'cold_flu')}}checked{{/if}}>
                  <label>Cold/Flu</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="healthConcerns" value="throat_trouble" {{#if (includes user.healthConcerns 'throat_trouble')}}checked{{/if}}>
                  <label>Throat Trouble</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="healthConcerns" value="allergies" {{#if (includes user.healthConcerns 'allergies')}}checked{{/if}}>
                  <label>Allergies</label>
                </div>
                <div class="checkbox-item">
                  <input type="checkbox" name="healthConcerns" value="asthma" {{#if (includes user.healthConcerns 'asthma')}}checked{{/if}}>
                  <label>Asthma</label>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Vision</label>
              <div class="radio-group">
                <div class="radio-item">
                  <input type="radio" name="vision" value="normal" {{#if (eq user.vision 'normal')}}checked{{/if}}>
                  <label>Normal</label>
                </div>
                <div class="radio-item">
                  <input type="radio" name="vision" value="defective" {{#if (eq user.vision 'defective')}}checked{{/if}}>
                  <label>Defective</label>
                </div>
              </div>
            </div>
            <div class="form-group">
              <label>Hearing</label>
              <div class="radio-group">
                <div class="radio-item">
                  <input type="radio" name="hearing" value="normal" {{#if (eq user.hearing 'normal')}}checked{{/if}}>
                  <label>Normal</label>
                </div>
                <div class="radio-item">
                  <input type="radio" name="hearing" value="defective" {{#if (eq user.hearing 'defective')}}checked{{/if}}>
                  <label>Defective</label>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Accidents/Operations Experienced</label>
              <textarea name="accidentsOperations">{{user.accidentsOperations}}</textarea>
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Present Concerns/Problems</label>
              <textarea name="presentConcerns">{{user.presentConcerns}}</textarea>
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Present Fears</label>
              <textarea name="presentFears">{{user.presentFears}}</textarea>
            </div>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Any Health Problem/Illness</label>
              <textarea name="healthProblem">{{user.healthProblem}}</textarea>
            </div>
          </div>
        </div>

        <!-- Additional Information -->
        <div class="border-t pt-6">
          <h3 class="section-header">Additional Information</h3>
          
          <div class="form-row full">
            <div class="form-group">
              <label>Tell us about yourself - skills, talents, hobbies, dreams, favorite quote:</label>
              <textarea name="skillsHobbies">{{user.skillsHobbies}}</textarea>
            </div>
          </div>
        </div>

        <!-- Change Password Section -->
        <div class="border-t pt-6">
          <h3 class="section-header">Change Password (optional)</h3>
          <p class="text-sm text-gray-500 mb-4">Enter your current password to make a password change.</p>
          <div class="form-row">
            <div class="form-group">
              <label>Current Password</label>
              <input type="password" name="currentPassword" />
            </div>
            <div class="form-group">
              <label>New Password</label>
              <input type="password" name="newPassword" />
            </div>
            <div class="form-group">
              <label>Confirm New Password</label>
              <input type="password" name="confirmPassword" />
            </div>
          </div>
        </div>

        <div class="border-t pt-6 flex justify-end gap-4">
          <button type="reset" class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition">Reset</button>
          <button type="submit" class="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function previewProfilePicture(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('profilePicturePreview').innerHTML = 
            `<img src="${e.target.result}" alt="Profile" class="w-full h-full object-cover" />`;
        };
        reader.readAsDataURL(file);
        // Clear avatar selection
        document.getElementById('selectedAvatar').value = '';
      }
    }

    function selectAvatar(emoji) {
      document.getElementById('profilePicturePreview').innerHTML = 
        `<span class="text-6xl">${emoji}</span>`;
      document.getElementById('selectedAvatar').value = emoji;
      // Clear file input
      document.getElementById('profilePictureInput').value = '';
    }

    // Open/Close Sidebar
    function openSidebar() {
      document.getElementById('sidebar').classList.add('open');
      document.getElementById('overlay').classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('overlay').classList.remove('show');
      document.body.style.overflow = 'auto';
    }

    // Close sidebar on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeSidebar();
      }
    });

    // Auto-open sidebar when cursor moves to left edge
    let sidebarOpenTimeout;
    document.addEventListener('mousemove', function(e) {
      // If cursor is within 30px from left edge, open sidebar
      if (e.clientX < 30) {
        if (!sidebarOpenTimeout) {
          sidebarOpenTimeout = setTimeout(() => {
            const sidebar = document.getElementById('sidebar');
            if (sidebar && !sidebar.classList.contains('open')) {
              openSidebar();
            }
          }, 300); // 300ms delay to prevent accidental triggers
        }
      } else {
        // Clear timeout if cursor moves away
        if (sidebarOpenTimeout) {
          clearTimeout(sidebarOpenTimeout);
          sidebarOpenTimeout = null;
        }
      }
    });
  </script>
</body>
</html>
