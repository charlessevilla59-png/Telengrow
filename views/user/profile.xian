<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Student Profile</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #333;
      min-height: 100vh;
      padding: 20px;
    }

    html {
      scroll-behavior: smooth;
    }

    /* Main container */
    .profile-page {
      background: white;
      max-width: 850px;
      margin: 0 auto;
      border: 2px solid #000;
      padding: 30px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    /* Header */
    .form-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 1px solid #000;
    }

    .header-left {
      flex: 1;
    }

    .organization-title {
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 0.5px;
      margin-bottom: 3px;
      color: #333;
    }

    .form-title {
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 1px;
      color: #000;
      margin-bottom: 2px;
    }

    .form-subtitle {
      font-size: 10px;
      color: #666;
    }

    /* Logo styling */
    .logo {
      width: 60px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 20px;
      flex-shrink: 0;
    }

    .logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    /* Picture box */
    .picture-box {
      width: 120px;
      height: 120px;
      border: 2px solid #000;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      overflow: hidden;
    }

    .picture-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .picture-placeholder {
      text-align: center;
      color: #999;
      font-size: 11px;
      font-weight: normal;
    }

    /* Form content */
    .form-content {
      padding: 0;
    }

    /* Section header */
    .section-header {
      font-size: 12px;
      font-weight: bold;
      color: #000;
      margin-top: 18px;
      margin-bottom: 10px;
      padding-bottom: 0;
      border-bottom: none;
    }

    .section-header:first-child {
      margin-top: 0;
    }

    /* Form row */
    .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 20px;
      margin-bottom: 12px;
    }

    .form-row.full {
      grid-template-columns: 1fr;
    }

    .form-row.two-col {
      grid-template-columns: repeat(2, 1fr);
    }

    .form-row.three-col {
      grid-template-columns: repeat(3, 1fr);
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-size: 11px;
      font-weight: normal;
      color: #333;
      margin-bottom: 2px;
    }

    /* Display-only fields */
    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="tel"],
    .form-group input[type="date"],
    .form-group select,
    .form-group textarea {
      padding: 4px 0;
      border: none;
      border-bottom: 1px solid #000;
      border-radius: 0;
      font-size: 11px;
      font-family: Arial, sans-serif;
      background-color: transparent;
      color: #333;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-bottom-color: #333;
      background-color: #fafafa;
    }

    textarea {
      resize: vertical;
      min-height: 50px;
      padding: 4px;
      border: 1px solid #ccc;
    }

    /* Table styling */
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin: 8px 0;
      font-size: 11px;
    }

    .info-table th,
    .info-table td {
      border: 1px solid #000;
      padding: 6px;
      text-align: left;
    }

    .info-table th {
      background-color: #f5f5f5;
      font-weight: bold;
      color: #000;
    }

    .info-table input {
      width: 100%;
      border: none;
      padding: 3px;
      font-size: 11px;
      background: transparent;
    }

    /* Back button */
    .back-button {
      display: inline-block;
      margin-bottom: 15px;
      padding: 8px 15px;
      background: #000;
      color: white;
      text-decoration: none;
      font-size: 11px;
      font-weight: bold;
      border: 1px solid #000;
    }

    .back-button:hover {
      background: #333;
    }

    /* Edit button */
    .button-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-top: 25px;
    }

    .edit-btn,
    .cancel-btn {
      padding: 8px 20px;
      border: 1px solid #000;
      font-size: 12px;
      font-weight: bold;
      cursor: pointer;
      border-radius: 0;
    }

    .edit-btn {
      background-color: #000;
      color: white;
    }

    .edit-btn:hover {
      background-color: #333;
    }

    .cancel-btn {
      background-color: white;
      color: #000;
    }

    .cancel-btn:hover {
      background-color: #f5f5f5;
    }

    /* Print button */
    .print-btn {
      padding: 8px 20px;
      border: 1px solid #000;
      font-size: 12px;
      font-weight: bold;
      cursor: pointer;
      border-radius: 0;
      background-color: #f0f0f0;
      color: #000;
      transition: all 0.3s ease;
      display: block;
      width: 100%;
      text-align: center;
      margin-top: 15px;
    }

    .print-btn:hover {
      background-color: #333;
      color: white;
    }

    /* Footer */
    .form-footer {
      padding: 15px 0;
      margin-top: 20px;
      border-top: 1px solid #000;
      text-align: center;
      font-size: 10px;
      color: #666;
    }

    @media (max-width: 768px) {
      .form-header {
        flex-direction: column;
        gap: 15px;
      }

      .form-row.two-col,
      .form-row.three-col {
        grid-template-columns: 1fr;
      }

      .button-group {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <a href="/user/dashboard" class="back-button">← Back</a>

  <div class="profile-page">
    <!-- Header Section -->
    <div class="form-header">
      <div style="display: flex; align-items: center; gap: 15px;">
        <div class="logo">
          <img src="/images/logo.jpg" alt="Organization Logo">
        </div>
        <div class="header-left">
          <div class="organization-title">TELL 'N GROW</div>
          <div class="form-title">{{#ifEquals user.role 'counselor'}}COUNSELOR PROFILE{{else}}STUDENT PROFILE{{/ifEquals}}</div>
          <div class="form-subtitle">View & Edit Your Information</div>
        </div>
      </div>
      <div style="text-align: right;">
          <div class="picture-box" id="pictureBox">
          <img id="photoPreview" style="display: none;" src="" alt="Photo Preview">
          <div class="picture-placeholder" id="photoPlaceholder">
            {{#if user.profilePicture}}
              <img src="{{user.profilePicture}}" alt="Photo" style="width: 100%; height: 100%; object-fit: contain;">
            {{else}}
              <span>2x2<br>Photo</span>
            {{/if}}
          </div>
        </div>
        <input type="file" id="photoInput" name="profilePicture" accept="image/*" style="display: none;">
        <p style="font-size: 10px; margin-top: 5px; color: #666;">Click to change photo</p>
      </div>
    </div>

    {{#if error_msg}}
    <div style="background: #fee; border: 1px solid #f99; color: #c33; padding: 10px; margin: 15px 0; font-size: 11px;">
      {{error_msg}}
    </div>
    {{/if}}
    {{#if success_msg}}
    <div style="background: #efe; border: 1px solid #9f9; color: #3c3; padding: 10px; margin: 15px 0; font-size: 11px;">
      {{success_msg}}
    </div>
    {{/if}}

    <!-- Form Content -->
    <div class="form-content">
      <form action="/user/profile" method="POST" id="profileForm" enctype="multipart/form-data">
        
        {{#ifEquals user.role 'counselor'}}
        <!-- COUNSELOR PROFILE FORM - LIMITED FIELDS -->
        
        <!-- Name Section -->
        <div class="section-header">Personal Information</div>
        
        <div class="form-row full">
          <div class="form-group">
            <label>Name</label>
            <input type="text" name="name" value="{{user.name}}" required>
          </div>
        </div>

        <!-- Password Section -->
        <div class="section-header">Security</div>
        
        <div class="form-row full">
          <div class="form-group">
            <label>Current Password</label>
            <input type="password" name="currentPassword" placeholder="Enter your current password">
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>New Password</label>
            <input type="password" name="newPassword" placeholder="Enter new password (min. 6 characters)">
          </div>
          <div class="form-group">
            <label>Confirm New Password</label>
            <input type="password" name="confirmPassword" placeholder="Confirm new password">
          </div>
        </div>

        {{else}}
        <!-- STUDENT PROFILE FORM - ALL FIELDS -->
        
        <div class="form-row full">
          <div class="form-group">
            <label>Name</label>
            <input type="text" name="name" value="{{user.name}}" required>
          </div>
        </div>

        <div class="form-row three-col">
          <div class="form-group">
            <label>Nickname</label>
            <input type="text" name="nickname" value="{{user.nickname}}">
          </div>
          <div class="form-group">
            <label>Age</label>
            <input type="number" name="age" value="{{user.age}}" min="1" max="120">
          </div>
          <div class="form-group">
            <label>Date of Birth</label>
            <input type="date" name="dateOfBirth" value="{{user.dateOfBirth}}">
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Place of Birth</label>
            <input type="text" name="placeOfBirth" value="{{user.placeOfBirth}}">
          </div>
          <div class="form-group">
            <label>Nationality</label>
            <input type="text" name="nationality" value="{{user.nationality}}">
          </div>
        </div>

        <div class="form-row three-col">
          <div class="form-group">
            <label>Sex</label>
            <select name="sex">
              <option value="">Select</option>
              <option value="male" {{#ifEquals user.sex 'male'}}selected{{/ifEquals}}>Male</option>
              <option value="female" {{#ifEquals user.sex 'female'}}selected{{/ifEquals}}>Female</option>
              <option value="other" {{#ifEquals user.sex 'other'}}selected{{/ifEquals}}>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label>Civil Status</label>
            <input type="text" name="civilStatus" value="{{user.civilStatus}}">
          </div>
          <div class="form-group">
            <label>Religion</label>
            <input type="text" name="religion" value="{{user.religion}}">
          </div>
        </div>

        <!-- Contact Information -->
        <div class="section-header">Contact Information</div>

        <div class="form-row full">
          <div class="form-group">
            <label>Current Address</label>
            <input type="text" name="currentAddress" value="{{user.currentAddress}}">
          </div>
        </div>

        <div class="form-row full">
          <div class="form-group">
            <label>Permanent Address</label>
            <input type="text" name="permanentAddress" value="{{user.permanentAddress}}">
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Contact Number</label>
            <input type="tel" name="contactNumber" value="{{user.contactNumber}}">
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" value="{{user.email}}" required>
          </div>
        </div>

        <div class="form-row full">
          <div class="form-group">
            <label>Alternate Email</label>
            <input type="email" name="emailAlternate" value="{{user.emailAlternate}}">
          </div>
        </div>

        <!-- Academic Information -->
        <div class="section-header">Academic Information</div>

        <div class="form-row three-col">
          <div class="form-group">
            <label>Course</label>
            <select name="course" required data-value="{{user.course}}">
              <option value="">Select Course</option>
              <option value="CPE">CPE (Computer Engineering)</option>
              <option value="IT">IT (Information Technology)</option>
              <option value="BSFI">BSFI (Business Administration - Finance)</option>
              <option value="BSENTREP">BSENTREP (Business Administration - Entrepreneurship)</option>
              <option value="BEED">BEED (Bachelor of Elementary Education)</option>
              <option value="EDUC">EDUC (Bachelor of Secondary Education)</option>
              <option value="CRIM">CRIM (Criminology)</option>
              <option value="TOURISM">TOURISM (Tourism)</option>
              <option value="HM">HM (Hospitality Management)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Year Level</label>
            <select name="year" required data-value="{{user.year}}">
              <option value="">Select Year</option>
              <option value="1st Year">1st Year</option>
              <option value="2nd Year">2nd Year</option>
              <option value="3rd Year">3rd Year</option>
              <option value="4th Year">4th Year</option>
            </select>
          </div>
          <div class="form-group">
            <label>Section</label>
            <input type="text" name="section" value="{{user.section}}">
          </div>
        </div>

        <!-- Family Information -->
        <div class="section-header">Family Information</div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Father's Name</label>
            <input type="text" name="fatherName" value="{{user.fatherName}}">
          </div>
          <div class="form-group">
            <label>Father's Occupation</label>
            <input type="text" name="fatherOccupation" value="{{user.fatherOccupation}}">
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Mother's Name</label>
            <input type="text" name="motherName" value="{{user.motherName}}">
          </div>
          <div class="form-group">
            <label>Mother's Occupation</label>
            <input type="text" name="motherOccupation" value="{{user.motherOccupation}}">
          </div>
        </div>

        <!-- Emergency Contact Information -->
        <div class="section-header">Emergency Contact</div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Emergency Contact Name</label>
            <input type="text" name="emergencyContactName" value="{{user.emergencyContactName}}">
          </div>
          <div class="form-group">
            <label>Relationship</label>
            <input type="text" name="emergencyContactRelation" value="{{user.emergencyContactRelation}}">
          </div>
        </div>

        <div class="form-row full">
          <div class="form-group">
            <label>Emergency Contact Address</label>
            <input type="text" name="emergencyContactAddress" value="{{user.emergencyContactAddress}}">
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Emergency Contact Number</label>
            <input type="tel" name="emergencyContactNumber" value="{{user.emergencyContactNumber}}">
          </div>
          <div class="form-group">
            <label>Emergency Contact Email</label>
            <input type="email" name="emergencyContactEmail" value="{{user.emergencyContactEmail}}">
          </div>
        </div>

        <!-- Educational Background -->
        <div class="section-header">Educational Background</div>

        <table class="info-table">
          <thead>
            <tr>
              <th>Level</th>
              <th>School Attended</th>
              <th>Dates Attended</th>
              <th>Honors Received</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Elementary</strong></td>
              <td><input type="text" name="elementarySchool" value="{{user.elementarySchool}}"></td>
              <td><input type="text" name="elementaryDates" value="{{user.elementaryDates}}"></td>
              <td><input type="text" name="elementaryHonors" value="{{user.elementaryHonors}}"></td>
            </tr>
            <tr>
              <td><strong>Junior High</strong></td>
              <td><input type="text" name="juniorHighSchool" value="{{user.juniorHighSchool}}"></td>
              <td><input type="text" name="juniorHighDates" value="{{user.juniorHighDates}}"></td>
              <td><input type="text" name="juniorHighHonors" value="{{user.juniorHighHonors}}"></td>
            </tr>
            <tr>
              <td><strong>Senior High</strong></td>
              <td><input type="text" name="seniorHighSchool" value="{{user.seniorHighSchool}}"></td>
              <td><input type="text" name="seniorHighDates" value="{{user.seniorHighDates}}"></td>
              <td><input type="text" name="seniorHighHonors" value="{{user.seniorHighHonors}}"></td>
            </tr>
            <tr>
              <td><strong>College/University</strong></td>
              <td><input type="text" name="collegeName" value="{{user.collegeName}}"></td>
              <td><input type="text" name="collegeDates" value="{{user.collegeDates}}"></td>
              <td><input type="text" name="collegeHonors" value="{{user.collegeHonors}}"></td>
            </tr>
          </tbody>
        </table>

        <!-- Health Information -->
        <div class="section-header">Health Information</div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Vision Status</label>
            <input type="text" name="vision" value="{{user.vision}}" placeholder="e.g., Normal / Defective">
          </div>
          <div class="form-group">
            <label>Vision Details</label>
            <input type="text" name="visionDetails" value="{{user.visionDetails}}" placeholder="If defective, specify">
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Hearing Status</label>
            <input type="text" name="hearing" value="{{user.hearing}}" placeholder="e.g., Normal / Defective">
          </div>
          <div class="form-group">
            <label>Hearing Details</label>
            <input type="text" name="hearingDetails" value="{{user.hearingDetails}}" placeholder="If defective, specify">
          </div>
        </div>

        <div class="form-row full">
          <div class="form-group">
            <label>Any Health Problem/Illness</label>
            <textarea name="healthProblem">{{user.healthProblem}}</textarea>
          </div>
        </div>

        <div class="form-row full">
          <div class="form-group">
            <label>Accidents/Operations Experienced</label>
            <textarea name="accidentsOperations">{{user.accidentsOperations}}</textarea>
          </div>
        </div>

        <!-- Special Information -->
        <div class="section-header">Special Information</div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>LGBTQIA+ Status</label>
            <input type="text" name="lgbtqia" value="{{user.lgbtqia}}" placeholder="e.g., Yes / No">
          </div>
          <div class="form-group">
            <label>LGBTQIA+ Specify</label>
            <input type="text" name="lgbtqiaSpecify" value="{{user.lgbtqiaSpecify}}" placeholder="Specify if Yes">
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Indigenous Group Member</label>
            <input type="text" name="indigenousGroup" value="{{user.indigenousGroup}}" placeholder="e.g., Yes / No">
          </div>
          <div class="form-group">
            <label>Indigenous Group Name</label>
            <input type="text" name="indigenousGroupName" value="{{user.indigenousGroupName}}" placeholder="Tribe name if Yes">
          </div>
        </div>

        <div class="form-row two-col">
          <div class="form-group">
            <label>Person with Disability</label>
            <input type="text" name="personWithDisability" value="{{user.personWithDisability}}" placeholder="e.g., Yes / No">
          </div>
          <div class="form-group">
            <label>Disability Type</label>
            <input type="text" name="disabilityType" value="{{user.disabilityType}}" placeholder="Specify if Yes">
          </div>
        </div>

        {{/ifEquals}}

        <!-- Buttons -->
        <div class="button-group">
          <button type="submit" class="edit-btn">SAVE CHANGES</button>
          <button type="button" class="cancel-btn" onclick="history.back()">CANCEL</button>
        </div>

        <!-- Print Button -->
        <button type="button" class="print-btn" id="printBtn" onclick="printProfile()">
          <span style="margin-right: 5px;">🖨️</span>PRINT
        </button>
      </form>
    </div>

    <!-- Footer -->
    <div class="form-footer">
      <p>Last Updated: {{user.updatedAt}}</p>
    </div>
  </div>

  <script>
    // Photo upload preview
    const pictureBox = document.getElementById('pictureBox');
    const photoInput = document.getElementById('photoInput');
    const photoPreview = document.getElementById('photoPreview');
    const photoPlaceholder = document.getElementById('photoPlaceholder');

    pictureBox.addEventListener('click', () => {
      photoInput.click();
    });

    photoInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          photoPreview.src = event.target.result;
          photoPreview.style.display = 'block';
          photoPlaceholder.style.display = 'none';
        };
        reader.readAsDataURL(file);
      }
    });

    // Restore select dropdowns values from data attribute
    window.addEventListener('load', function() {
      const selectElements = document.querySelectorAll('select[data-value]');
      selectElements.forEach(select => {
        const savedValue = select.getAttribute('data-value');
        if (savedValue) {
          select.value = savedValue;
        }
      });
    });

    // Add cursor pointer style when hovering over picture box
    pictureBox.style.cursor = 'pointer';

    // Print Profile Function
    function printProfile() {
      const printWindow = window.open('', '', 'height=500,width=800');
      const printContent = document.querySelector('.profile-page').outerHTML;
      
      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <title>{{user.name}} - Student Profile</title>
          <style>
            * {
              margin: 0;
              padding: 0;
              box-sizing: border-box;
            }
            body {
              font-family: Arial, sans-serif;
              color: #333;
              padding: 20px;
            }
            .profile-page {
              background: white;
              border: 2px solid #000;
              padding: 30px;
            }
            .form-header {
              display: flex;
              justify-content: space-between;
              align-items: flex-start;
              margin-bottom: 25px;
              padding-bottom: 15px;
              border-bottom: 1px solid #000;
            }
            .logo { width: 60px; height: 60px; }
            .logo img { max-width: 100%; max-height: 100%; }
            .organization-title { font-size: 12px; font-weight: bold; margin-bottom: 3px; }
            .form-title { font-size: 14px; font-weight: bold; margin-bottom: 2px; }
            .form-subtitle { font-size: 10px; color: #666; }
            .picture-box {
              width: 120px; height: 120px; border: 2px solid #000; 
              display: flex; align-items: center; justify-content: center; overflow: hidden;
            }
            .picture-box img { width: 100%; height: 100%; object-fit: cover; }
            .section-header { font-size: 12px; font-weight: bold; margin-top: 18px; margin-bottom: 10px; }
            .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin-bottom: 12px; }
            .form-group { display: flex; flex-direction: column; }
            .form-group label { font-size: 11px; font-weight: normal; margin-bottom: 2px; }
            .form-group input, .form-group select, .form-group textarea {
              padding: 4px 0; border: none; border-bottom: 1px solid #000; 
              font-size: 11px; font-family: Arial, sans-serif; background: transparent; color: #333;
            }
            .info-table { width: 100%; border-collapse: collapse; margin: 8px 0; font-size: 11px; }
            .info-table th, .info-table td { border: 1px solid #000; padding: 6px; text-align: left; }
            .info-table th { background-color: #f5f5f5; font-weight: bold; }
            .button-group, .print-btn { display: none; }
            .form-footer { padding: 15px 0; margin-top: 20px; border-top: 1px solid #000; text-align: center; font-size: 10px; color: #666; }
            @media print {
              body { margin: 0; padding: 0; }
              .button-group, .print-btn { display: none; }
            }
          </style>
        </head>
        <body>
          ${printContent}
          <script>
            window.print();
          <\/script>
        </body>
        </html>
      `);
      printWindow.document.close();
    }
  </script>
</body>
</html>
