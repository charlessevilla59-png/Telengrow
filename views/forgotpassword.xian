<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-fade-in-down {
      animation: fadeInDown 0.6s ease-out;
    }

    .animate-slide-in-left {
      animation: slideInLeft 0.6s ease-out;
    }

    .gradient-bg {
      background: linear-gradient(135deg, #16a34a 0%, #059669 100%);
    }

    .form-input {
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.95);
    }

    .form-input:focus {
      background: #ffffff;
      transform: translateY(-2px);
    }

    .submit-btn {
      background: linear-gradient(135deg, #16a34a 0%, #059669 100%);
      transition: all 0.3s ease;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(22, 163, 74, 0.3);
    }

    .submit-btn:active {
      transform: translateY(0);
    }

    .hidden-form {
      display: none;
    }

    .shown {
      display: block !important;
    }
  </style>
</head>
<body class="gradient-bg min-h-screen flex items-center justify-center p-4">
  <!-- Animated Background Elements -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-10 left-10 w-72 h-72 bg-white rounded-full mix-blend-multiply filter blur-xl opacity-10 animate-pulse"></div>
    <div class="absolute -bottom-8 right-10 w-72 h-72 bg-white rounded-full mix-blend-multiply filter blur-xl opacity-10 animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <!-- Main Container -->
  <div class="relative w-full max-w-md">
    <!-- Card -->
    <div class="bg-white rounded-3xl shadow-2xl p-8 md:p-10 animate-fade-in-down">
      <!-- Header Section -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-green-100 to-emerald-100 rounded-full mb-4 animate-slide-in-left">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Reset Password</h1>
        <p class="text-gray-600 text-sm md:text-base">Quickly reset your password</p>
      </div>

      <!-- Step 1: Email Verification -->
      <form id="emailForm" action="/forgot-password/verify" method="POST" class="space-y-6">
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-800 mb-3">Email Address</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <input 
              type="email" 
              id="email"
              name="email" 
              required
              placeholder="your.email@example.com"
              class="form-input w-full pl-12 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-600 focus:ring-2 focus:ring-green-100 text-gray-800"
            >
          </div>
        </div>

        <button 
          type="submit"
          class="submit-btn w-full text-white font-semibold py-3 rounded-xl shadow-lg hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-green-300"
        >
          <span class="flex items-center justify-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
            Verify Email
          </span>
        </button>
      </form>

      <!-- Step 2: Password Reset (Initially Hidden) -->
      <form id="resetForm" action="/forgot-password/reset" method="POST" class="space-y-6 hidden-form">
        <input type="hidden" id="resetEmail" name="email">
        
        <div>
          <label for="newPassword" class="block text-sm font-semibold text-gray-800 mb-3">New Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <input 
              type="password" 
              id="newPassword"
              name="newPassword" 
              required
              minlength="8"
              placeholder="Enter new password (min 8 characters)"
              class="form-input w-full pl-12 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-600 focus:ring-2 focus:ring-green-100 text-gray-800"
            >
          </div>
          <p class="text-xs text-gray-500 mt-2">Password must be at least 8 characters long</p>
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-semibold text-gray-800 mb-3">Confirm Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <input 
              type="password" 
              id="confirmPassword"
              name="confirmPassword" 
              required
              minlength="8"
              placeholder="Confirm your password"
              class="form-input w-full pl-12 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-600 focus:ring-2 focus:ring-green-100 text-gray-800"
            >
          </div>
        </div>

        <div class="flex gap-3">
          <button 
            type="button"
            onclick="goBackToEmail()"
            class="flex-1 font-semibold py-3 rounded-xl shadow border-2 border-green-600 text-green-600 hover:bg-green-50 transition"
          >
            <span class="flex items-center justify-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Back
            </span>
          </button>

          <button 
            type="submit"
            class="flex-1 submit-btn text-white font-semibold py-3 rounded-xl shadow-lg hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-green-300"
          >
            <span class="flex items-center justify-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Reset Password
            </span>
          </button>
        </div>
      </form>

      <!-- Divider -->
      <div class="flex items-center my-6">
        <div class="flex-1 h-px bg-gray-200"></div>
        <span class="px-3 text-sm text-gray-500">or</span>
        <div class="flex-1 h-px bg-gray-200"></div>
      </div>

      <!-- Back to Login Link -->
      <div class="text-center">
        <p class="text-gray-600 text-sm mb-3">Remember your password?</p>
        <a href="/login" class="inline-flex items-center text-green-600 hover:text-green-700 font-semibold transition">
          <span>Back to Login</span>
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Help Text -->
      <div class="mt-8 p-4 bg-green-50 border border-green-200 rounded-xl">
        <p class="text-xs text-gray-700 leading-relaxed">
          <span class="font-semibold text-green-700">💡 Tip:</span> Your password will be changed instantly once verified.
        </p>
      </div>
    </div>

    <!-- Support Text -->
    <div class="text-center mt-6 text-white text-sm">
      <p>Having trouble? <a href="/" class="underline hover:text-gray-200 transition">Contact Support</a></p>
    </div>
  </div>

  <script>
    document.getElementById('emailForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const email = document.getElementById('email').value;
      
      try {
        const response = await fetch('/forgot-password/verify', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ email })
        });
        
        const data = await response.json();
        
        if (data.success) {
          // Show reset form
          document.getElementById('emailForm').classList.add('hidden-form');
          document.getElementById('resetForm').classList.remove('hidden-form');
          document.getElementById('resetForm').classList.add('shown');
          document.getElementById('resetEmail').value = email;
        } else {
          alert(data.message || 'Email not found');
        }
      } catch (error) {
        alert('Error: ' + error.message);
      }
    });

    function goBackToEmail() {
      document.getElementById('resetForm').classList.add('hidden-form');
      document.getElementById('emailForm').classList.remove('hidden-form');
      document.getElementById('emailForm').classList.add('shown');
    }

    document.getElementById('resetForm').addEventListener('submit', function(e) {
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      
      if (newPassword !== confirmPassword) {
        e.preventDefault();
        alert('Passwords do not match');
      }
    });
  </script>
</body>
</html>
