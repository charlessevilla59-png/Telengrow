<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-orange-500 to-red-600 min-h-screen flex items-center justify-center">
  <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-md">
    <h1 class="text-3xl font-bold text-center mb-6 text-gray-800">Forgot Password</h1>
    <p class="text-gray-600 text-center mb-6">Enter your email to reset your password</p>
    
    <form action="/forgot-password" method="POST">
      <div class="mb-6">
        <label class="block text-gray-700 mb-2">Email</label>
        <input type="email" name="email" required 
               class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500">
      </div>
      
      <button type="submit" 
              class="w-full bg-orange-600 text-white py-3 rounded-lg font-semibold hover:bg-orange-700 transition">
        Reset Password
      </button>
    </form>
    
    <div class="mt-4 text-center text-gray-600">
      <a href="/login" class="text-orange-600 hover:underline">Back to Login</a>
    </div>
  </div>
</body>
</html>
