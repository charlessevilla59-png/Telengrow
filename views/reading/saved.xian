<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  {{> sidebar}}
  
  <nav class="bg-white shadow-md p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-purple-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <a href="/user/dashboard" class="text-gray-600 hover:text-gray-800 flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to Dashboard</span>
        </a>
        <h1 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h1>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-800 mb-2">⭐ Saved Materials</h1>
      <p class="text-gray-600">Your bookmarked reading materials</p>
    </div>

    <!-- Saved Materials Grid -->
    {{#if savedMaterials.length}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {{#each savedMaterials}}
      <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition">
        <!-- Book Icon Header -->
        <div class="h-48 bg-gradient-to-br from-yellow-500 to-orange-500 flex items-center justify-center">
          {{#if (eq this.material.fileType 'pdf')}}
          <span class="text-7xl">📕</span>
          {{else if (eq this.material.fileType 'document')}}
          <span class="text-7xl">📘</span>
          {{else}}
          <span class="text-7xl">📖</span>
          {{/if}}
        </div>

        <!-- Content -->
        <div class="p-6">
          <!-- Category & Reading Time -->
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full font-semibold">
              {{this.material.category}}
            </span>
            <span class="text-xs text-gray-500">⏱️ {{this.material.readingTime}} min</span>
          </div>

          <!-- Title -->
          <h3 class="text-xl font-bold text-gray-800 mb-2">{{this.material.title}}</h3>

          <!-- Excerpt -->
          <p class="text-gray-600 text-sm mb-4 line-clamp-3">{{this.material.excerpt}}</p>

          <!-- Meta Info -->
          <div class="flex items-center gap-3 text-xs text-gray-500 mb-4">
            <span>👁️ {{this.material.views}} views</span>
            {{#if this.material.counselor}}
            <span>👨‍💼 {{this.material.counselor.name}}</span>
            {{/if}}
          </div>

          <!-- Saved Date -->
          <div class="mb-4">
            <span class="text-xs text-gray-500">⭐ Saved {{formatDate this.savedAt}}</span>
          </div>

          <!-- Buttons -->
          <div class="flex gap-2">
            {{#if (eq this.material.fileType 'article')}}
            <a href="/reading/{{this.material.slug}}" 
               class="flex-1 bg-emerald-600 text-white text-center py-2 rounded-lg font-semibold hover:bg-emerald-700 transition text-sm">
              📖 Read
            </a>
            {{else}}
            <a href="/reading/view/{{this.material.id}}" 
               class="flex-1 bg-blue-600 text-white text-center py-2 rounded-lg font-semibold hover:bg-blue-700 transition text-sm">
              👁️ View
            </a>
            {{/if}}
            <button onclick="removeSaved({{this.material.id}})" 
                    class="bg-red-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-red-700 transition text-sm">
              🗑️
            </button>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="bg-white rounded-xl shadow-md p-12 text-center">
      <div class="text-8xl mb-4">⭐</div>
      <h3 class="text-2xl font-bold text-gray-700 mb-2">No Saved Materials Yet</h3>
      <p class="text-gray-600 mb-6">Start saving materials you want to read later!</p>
      <a href="/reading" class="inline-block bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition font-semibold">
        Browse Materials
      </a>
    </div>
    {{/if}}
  </div>

  <script>
    async function removeSaved(materialId) {
      if (!confirm('Remove this material from saved?')) return;
      
      try {
        const response = await fetch(`/reading/unsave/${materialId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert('✅ Material removed from saved');
          location.reload();
        } else {
          alert('❌ Error: ' + result.message);
        }
      } catch (error) {
        console.error('Remove error:', error);
        alert('❌ Failed to remove material');
      }
    }
  </script>
</body>
</html>
