<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Personal Information Intake Form</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #333;
      min-height: 100vh;
      padding: 20px;
    }

    html {
      scroll-behavior: smooth;
    }

    /* Main form container */
    .form-page {
      background: white;
      max-width: 850px;
      margin: 0 auto;
      border: 2px solid #000;
      padding: 30px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    /* Header */
    .form-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 1px solid #000;
    }

    .header-left {
      flex: 1;
    }

    .organization-title {
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 0.5px;
      margin-bottom: 3px;
      color: #333;
    }

    .form-title {
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 1px;
      color: #000;
      margin-bottom: 2px;
    }

    .form-subtitle {
      font-size: 10px;
      color: #666;
    }

    /* Logo styling */
    .logo {
      width: 60px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 20px;
      flex-shrink: 0;
    }

    .logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    /* Picture box - 2x2 size */
    .picture-box {
      width: 140px;
      height: 140px;
      border: 2px solid #000;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      position: relative;
      cursor: pointer;
      overflow: hidden;
    }

    .picture-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .picture-placeholder {
      text-align: center;
      color: #999;
      font-size: 11px;
      font-weight: normal;
    }

    .picture-label {
      font-size: 10px;
      text-align: center;
      margin-top: 5px;
      font-weight: bold;
      color: #333;
    }

    /* Form content */
    .form-content {
      padding: 0;
    }

    /* Section header */
    .section-header {
      font-size: 12px;
      font-weight: bold;
      color: #000;
      margin-top: 18px;
      margin-bottom: 10px;
      padding-bottom: 0;
      border-bottom: none;
    }

    .section-header:first-child {
      margin-top: 0;
    }

    /* Form row */
    .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 20px;
      margin-bottom: 12px;
    }

    .form-row.full {
      grid-template-columns: 1fr;
    }

    .form-row.two-col {
      grid-template-columns: repeat(2, 1fr);
    }

    .form-row.three-col {
      grid-template-columns: repeat(3, 1fr);
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-size: 11px;
      font-weight: normal;
      color: #333;
      margin-bottom: 2px;
      letter-spacing: 0px;
    }

    .form-group label.required::after {
      content: " *";
      color: #000;
      font-weight: bold;
    }

    /* Underline-style inputs */
    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="password"],
    .form-group input[type="number"],
    .form-group input[type="tel"],
    .form-group input[type="date"],
    .form-group input[type="file"],
    .form-group select,
    .form-group textarea {
      padding: 4px 0;
      border: none;
      border-bottom: 1px solid #000;
      border-radius: 0;
      font-size: 11px;
      font-family: Arial, sans-serif;
      background-color: transparent;
      color: #333;
    }

    .form-group input[type="text"]::placeholder,
    .form-group input[type="email"]::placeholder,
    .form-group input[type="tel"]::placeholder {
      color: #999;
      font-size: 10px;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-bottom-color: #333;
      background-color: #fafafa;
    }

    textarea {
      resize: vertical;
      min-height: 50px;
      padding: 4px;
      border: 1px solid #ccc;
    }

    /* Radio and Checkbox */
    .radio-group,
    .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-top: 4px;
    }

    .radio-item,
    .checkbox-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
    }

    .radio-item input,
    .checkbox-item input {
      cursor: pointer;
      margin: 0;
    }

    .radio-item label,
    .checkbox-item label {
      cursor: pointer;
      margin: 0;
      font-weight: normal;
    }

    /* Two column radio */
    .radio-two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    /* Table styling */
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin: 8px 0;
      font-size: 11px;
    }

    .info-table th,
    .info-table td {
      border: 1px solid #000;
      padding: 6px;
      text-align: left;
    }

    .info-table th {
      background-color: #f5f5f5;
      font-weight: bold;
      color: #000;
    }

    .info-table input {
      width: 100%;
      border: none;
      padding: 3px;
      font-size: 11px;
      background: transparent;
    }

    /* Button styling */
    .button-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-top: 25px;
    }

    .submit-btn,
    .reset-btn {
      padding: 8px 20px;
      border: 1px solid #000;
      font-size: 12px;
      font-weight: bold;
      cursor: pointer;
      border-radius: 0;
      transition: all 0.3s ease;
    }

    .submit-btn {
      background-color: #000;
      color: white;
    }

    .submit-btn:hover {
      background-color: #333;
    }

    .reset-btn {
      background-color: white;
      color: #000;
    }

    .reset-btn:hover {
      background-color: #f5f5f5;
    }

    /* Footer */
    .form-footer {
      padding: 15px 0;
      margin-top: 20px;
      border-top: 1px solid #000;
      text-align: center;
      font-size: 10px;
      color: #666;
    }

    .signature-line {
      margin-top: 20px;
      text-align: center;
      font-size: 10px;
    }

    .signature-line span {
      display: inline-block;
      border-top: 1px solid #000;
      padding-top: 5px;
      width: 250px;
      margin: 20px 0;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .form-header {
        flex-direction: column;
        gap: 15px;
      }

      .form-row.two-col,
      .form-row.three-col {
        grid-template-columns: 1fr;
      }

      .button-group {
        grid-template-columns: 1fr;
      }

      .radio-two-col {
        grid-template-columns: 1fr;
      }

      .picture-box {
        width: 120px;
        height: 120px;
      }
    }
  </style>
</head>
<body>
  <form id="piiForm" class="form-page">
    <!-- Header Section with Logo and Photo Box -->
    <div class="form-header">
      <div>
        <div style="display: flex; align-items: center; gap: 15px;">
          <div class="logo">
            <img src="/images/logo.jpg" alt="Organization Logo">
          </div>
          <div class="header-left">
            <div class="organization-title">TELL 'N GROW</div>
            <div class="form-title">PERSONAL INFORMATION INTAKE FORM</div>
            <div class="form-subtitle">Individual Student Record</div>
          </div>
        </div>
      </div>
      <div style="text-align: right;">
        <div class="picture-box" id="pictureBox">
          <img id="photoPreview" style="display: none;" src="" alt="Photo Preview">
          <div class="picture-placeholder" id="photoPlaceholder">
            2 x 2<br>Photo
          </div>
        </div>
        <div class="picture-label">Upload 2x2 Photo</div>
        <input type="file" id="photoInput" accept="image/*" style="display: none;">
      </div>
    </div>

    <!-- Form Content -->
    <div class="form-content">
      
      <!-- Personal Information -->
      <div class="section-header">Personal Information</div>
      
      <div class="form-row">
        <div class="form-group">
          <label>Name</label>
          <input type="text" name="fullName" placeholder="Last Name, First Name, Middle Name">
        </div>
      </div>

      <div class="form-row three-col">
        <div class="form-group">
          <label>Nickname</label>
          <input type="text" name="nickname">
        </div>
        <div class="form-group">
          <label>Age</label>
          <input type="number" name="age" min="1" max="120">
        </div>
        <div class="form-group">
          <label>Date of Birth</label>
          <input type="date" name="dateOfBirth">
        </div>
      </div>

      <div class="form-row two-col">
        <div class="form-group">
          <label>Place of Birth</label>
          <input type="text" name="placeOfBirth">
        </div>
        <div class="form-group">
          <label>Nationality</label>
          <input type="text" name="nationality">
        </div>
      </div>

      <div class="form-row three-col">
        <div class="form-group">
          <label>Sex</label>
          <select name="sex">
            <option value="">Select</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Civil Status</label>
          <input type="text" name="civilStatus">
        </div>
        <div class="form-group">
          <label>Religion</label>
          <input type="text" name="religion">
        </div>
      </div>

      <!-- Contact Information -->
      <div class="section-header">Contact Information</div>

      <div class="form-row full">
        <div class="form-group">
          <label>Current Address</label>
          <input type="text" name="currentAddress">
        </div>
      </div>

      <div class="form-row full">
        <div class="form-group">
          <label>Permanent Address</label>
          <input type="text" name="permanentAddress">
        </div>
      </div>

      <div class="form-row two-col">
        <div class="form-group">
          <label>Contact No.</label>
          <input type="tel" name="contactNo">
        </div>
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" name="email">
        </div>
      </div>

      <!-- Family Information -->
      <div class="section-header">Family Information</div>

      <div class="form-row two-col">
        <div class="form-group">
          <label>Father's Name</label>
          <input type="text" name="fatherName">
        </div>
        <div class="form-group">
          <label>Occupation</label>
          <input type="text" name="fatherOccupation">
        </div>
      </div>

      <div class="form-row two-col">
        <div class="form-group">
          <label>Mother's Name</label>
          <input type="text" name="motherName">
        </div>
        <div class="form-group">
          <label>Occupation</label>
          <input type="text" name="motherOccupation">
        </div>
      </div>

      <!-- Educational Background -->
      <div class="section-header">Educational Background</div>

      <table class="info-table">
        <thead>
          <tr>
            <th>Level</th>
            <th>School Attended</th>
            <th>Inclusive Dates of Attendance</th>
            <th>Scholarships/Academic Honors</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Elementary</strong></td>
            <td><input type="text" name="elementarySchool"></td>
            <td><input type="text" name="elementaryDates" placeholder="From - To"></td>
            <td><input type="text" name="elementaryHonors"></td>
          </tr>
          <tr>
            <td><strong>Junior High School</strong></td>
            <td><input type="text" name="juniorHighSchool"></td>
            <td><input type="text" name="juniorHighDates" placeholder="From - To"></td>
            <td><input type="text" name="juniorHighHonors"></td>
          </tr>
          <tr>
            <td><strong>Senior High School</strong></td>
            <td><input type="text" name="seniorHighSchool"></td>
            <td><input type="text" name="seniorHighDates" placeholder="From - To"></td>
            <td><input type="text" name="seniorHighHonors"></td>
          </tr>
          <tr>
            <td><strong>College/University</strong></td>
            <td><input type="text" name="collegeSchool"></td>
            <td><input type="text" name="collegeDates" placeholder="From - To"></td>
            <td><input type="text" name="collegeHonors"></td>
          </tr>
        </tbody>
      </table>

      <!-- Health Information -->
      <div class="section-header">General State of Health</div>

      <div class="form-row full">
        <div class="form-group">
          <label>Common Health Concerns:</label>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 4px;">
            <div class="checkbox-item">
              <input type="checkbox" name="headache">
              <label>Headache</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" name="stomachTrouble">
              <label>Stomach Trouble</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" name="coldFlu">
              <label>Cold/Flu</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" name="allergies">
              <label>Allergies</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" name="asthma">
              <label>Asthma</label>
            </div>
          </div>
        </div>
      </div>

      <div class="form-row two-col">
        <div class="form-group">
          <label>Vision: ☐ Normal ☐ Defective ___________</label>
        </div>
        <div class="form-group">
          <label>Auditory: ☐ Normal ☐ Defective ___________</label>
        </div>
      </div>

      <div class="form-row full">
        <div class="form-group">
          <label>Accidents/Operations Experienced/Effect:</label>
          <input type="text" name="accidentsOperations">
        </div>
      </div>

      <div class="form-row full">
        <div class="form-group">
          <label>Present Concerns/Problems:</label>
          <textarea name="presentConcerns"></textarea>
        </div>
      </div>

      <div class="form-row full">
        <div class="form-group">
          <label>Any Health Problem/Illness:</label>
          <textarea name="healthProblems"></textarea>
        </div>
      </div>

      <!-- Additional Information -->
      <div class="section-header">Additional Information</div>

      <div class="form-row full">
        <div class="form-group">
          <label>Tell us something about yourself that is not included in the above information (skills, talents, hobbies, dreams, etc.):</label>
          <textarea name="additionalInfo" style="min-height: 80px;"></textarea>
        </div>
      </div>

      <!-- Signature & Consent -->
      <div class="form-footer">
        <p style="margin-bottom: 10px;"><strong>I certify that all the information above is true and correct.</strong></p>
        <div class="signature-line">
          <span style="display: inline-block; width: 250px; text-align: center; font-size: 10px; padding-top: 8px;">Signature of Student/Above Printed Name</span>
        </div>
      </div>

      <!-- Buttons -->
      <div class="button-group" style="margin-top: 15px;">
        <button type="submit" class="submit-btn">SUBMIT</button>
        <button type="reset" class="reset-btn">CLEAR</button>
      </div>
    </div>
  </form>

  <script>
    // Photo upload preview
    const pictureBox = document.getElementById('pictureBox');
    const photoInput = document.getElementById('photoInput');
    const photoPreview = document.getElementById('photoPreview');
    const photoPlaceholder = document.getElementById('photoPlaceholder');

    pictureBox.addEventListener('click', () => {
      photoInput.click();
    });

    photoInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          photoPreview.src = event.target.result;
          photoPreview.style.display = 'block';
          photoPlaceholder.style.display = 'none';
        };
        reader.readAsDataURL(file);
      }
    });

    // Form submission
    document.getElementById('piiForm').addEventListener('submit', function(e) {
      e.preventDefault();
      alert('Form submitted successfully!');
    });
  </script>
</body>
</html>
