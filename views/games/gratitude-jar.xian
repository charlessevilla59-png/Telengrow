<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
    .note {
      animation: float 3s ease-in-out infinite;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.8); }
      to { opacity: 1; transform: scale(1); }
    }
    .fade-in {
      animation: fadeIn 0.5s ease-out;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-yellow-400 to-orange-500 min-h-screen">
  <!-- Back Button -->
  <a href="/games" class="fixed top-4 left-4 bg-white p-3 rounded-full shadow-lg hover:scale-110 transition z-50">
    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
  </a>

  <!-- Sound Toggle Button -->
  <button onclick="toggleSound()" id="soundBtn" 
          class="fixed top-4 right-4 bg-white p-3 rounded-full shadow-lg text-2xl hover:scale-110 transition z-50">
    🔊
  </button>

  <div class="container mx-auto p-6">
    <!-- Header -->
    <div class="text-center text-white mb-8">
      <h1 class="text-4xl font-bold mb-2">🏺 Gratitude Jar</h1>
      <p class="text-yellow-100">Fill your jar with things you're grateful for</p>
    </div>

    <!-- Game Container -->
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl p-8">
      
      <!-- Stats -->
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="text-center bg-yellow-50 p-4 rounded-lg">
          <div class="text-3xl font-bold text-yellow-600" id="noteCount">0</div>
          <div class="text-sm text-gray-600">Gratitude Notes</div>
        </div>
        <div class="text-center bg-orange-50 p-4 rounded-lg">
          <div class="text-3xl font-bold text-orange-600" id="jarLevel">0%</div>
          <div class="text-sm text-gray-600">Jar Filled</div>
        </div>
      </div>

      <!-- Jar Visualization -->
      <div class="relative mb-6">
        <div class="w-64 h-80 mx-auto bg-gradient-to-b from-transparent to-yellow-100 border-4 border-yellow-600 rounded-b-3xl relative overflow-hidden">
          <div id="jarFill" class="absolute bottom-0 w-full bg-gradient-to-t from-yellow-400 to-yellow-200 transition-all duration-500" style="height: 0%"></div>
          <div id="notesContainer" class="absolute inset-0 p-4 flex flex-wrap gap-2 items-end justify-center"></div>
        </div>
        <div class="text-center mt-2 text-2xl">🏺</div>
      </div>

      <!-- Input Form -->
      <div class="mb-6">
        <label class="block text-gray-700 font-semibold mb-2">What are you grateful for today?</label>
        <textarea id="gratitudeInput" 
                  rows="3"
                  class="w-full px-4 py-2 border-2 border-yellow-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500"
                  placeholder="I'm grateful for..."></textarea>
      </div>

      <!-- Buttons -->
      <div class="flex gap-4 mb-6">
        <button onclick="addNote()" 
                class="flex-1 bg-yellow-600 text-white py-3 rounded-lg font-semibold hover:bg-yellow-700 transition">
          Add to Jar ✨
        </button>
        <button onclick="viewNotes()" 
                class="flex-1 bg-orange-600 text-white py-3 rounded-lg font-semibold hover:bg-orange-700 transition">
          View All Notes 📝
        </button>
      </div>

      <!-- Tips -->
      <div class="bg-yellow-50 p-4 rounded-lg">
        <h3 class="font-semibold text-yellow-800 mb-2">💡 Tips:</h3>
        <ul class="text-sm text-gray-700 space-y-1">
          <li>• Write at least 3 things you're grateful for each day</li>
          <li>• Be specific - "my friend's smile" vs "my friends"</li>
          <li>• Include small things - a good cup of coffee counts!</li>
          <li>• Come back daily to build a gratitude habit</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Modal for viewing notes -->
  <div id="notesModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl p-8 max-w-2xl w-full max-h-[80vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold text-gray-800">Your Gratitude Notes 📝</h2>
        <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="notesList" class="space-y-3"></div>
    </div>
  </div>

  <script>
    // 🔊 Sound Effects
    const sounds = {
      add: new Audio('data:audio/wav;base64,'),
      view: new Audio('data:audio/wav;base64,'),
      celebrate: new Audio('https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3')
    };

    sounds.add.volume = 0.3;
    sounds.view.volume = 0.3;
    sounds.celebrate.volume = 0.6;

    let soundEnabled = true;

    function playSound(soundName) {
      if (!soundEnabled || !sounds[soundName]) return;
      try {
        sounds[soundName].currentTime = 0;
        sounds[soundName].play().catch(e => console.log('Sound play failed:', e));
      } catch (e) {
        console.log('Sound error:', e);
      }
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundBtn');
      btn.textContent = soundEnabled ? '🔊' : '🔇';
    }

    let notes = JSON.parse(localStorage.getItem('gratitudeNotes') || '[]');
    
    function updateDisplay() {
      const noteCount = notes.length;
      document.getElementById('noteCount').textContent = noteCount;
      
      const jarLevel = Math.min(100, noteCount * 5);
      document.getElementById('jarLevel').textContent = jarLevel + '%';
      document.getElementById('jarFill').style.height = jarLevel + '%';
      
      // Display note emojis in jar
      const container = document.getElementById('notesContainer');
      container.innerHTML = '';
      const emojis = ['💛', '🌟', '✨', '💫', '⭐', '🌈', '🎉', '💝'];
      for (let i = 0; i < Math.min(noteCount, 20); i++) {
        const emoji = document.createElement('div');
        emoji.textContent = emojis[i % emojis.length];
        emoji.className = 'text-2xl note';
        emoji.style.animationDelay = (i * 0.2) + 's';
        container.appendChild(emoji);
      }
    }
    
    function addNote() {
      const input = document.getElementById('gratitudeInput');
      const text = input.value.trim();
      
      if (!text) {
        Swal.fire({
          icon: 'warning',
          title: 'Oops!',
          text: 'Please write something you\'re grateful for!',
          confirmButtonColor: '#d97706'
        });
        return;
      }
      
      const note = {
        id: Date.now(),
        text: text,
        date: new Date().toISOString()
      };
      
      notes.unshift(note);
      localStorage.setItem('gratitudeNotes', JSON.stringify(notes));
      
      playSound('add');
      
      input.value = '';
      updateDisplay();
      
      // Show success message
      Swal.fire({
        icon: 'success',
        title: 'Added! ✨',
        text: 'Your gratitude note has been added to the jar',
        timer: 1500,
        showConfirmButton: false,
        toast: true,
        position: 'top-end'
      });
    }
    
    function viewNotes() {
      playSound('view');
      
      const modal = document.getElementById('notesModal');
      const list = document.getElementById('notesList');
      
      if (notes.length === 0) {
        list.innerHTML = '<p class="text-gray-500 text-center py-8">No gratitude notes yet. Start adding some!</p>';
      } else {
        list.innerHTML = notes.map(note => `
          <div class="bg-yellow-50 p-4 rounded-lg border-l-4 border-yellow-500 fade-in">
            <p class="text-gray-800 mb-2">${note.text}</p>
            <div class="flex justify-between items-center text-sm text-gray-500">
              <span>${new Date(note.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <button onclick="deleteNote(${note.id})" class="text-red-500 hover:text-red-700">Delete</button>
            </div>
          </div>
        `).join('');
      }
      
      modal.classList.remove('hidden');
    }
    
    function closeModal() {
      document.getElementById('notesModal').classList.add('hidden');
    }
    
    function deleteNote(id) {
      Swal.fire({
        title: 'Delete this note?',
        text: 'This gratitude note will be removed from your jar',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, delete it',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          notes = notes.filter(n => n.id !== id);
          localStorage.setItem('gratitudeNotes', JSON.stringify(notes));
          updateDisplay();
          viewNotes();
          Swal.fire({
            icon: 'success',
            title: 'Deleted!',
            text: 'Your note has been removed',
            timer: 1500,
            showConfirmButton: false
          });
        }
      });
    }
    
    // Allow Enter key to add note
    document.getElementById('gratitudeInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        addNote();
      }
    });
    
    // Initialize
    updateDisplay();
  </script>
</body>
</html>
