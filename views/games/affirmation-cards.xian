<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    .card {
      perspective: 1000px;
      cursor: pointer;
    }
    .card-inner {
      position: relative;
      width: 100%;
      height: 100%;
      transition: transform 0.6s;
      transform-style: preserve-3d;
    }
    .card.flipped .card-inner {
      transform: rotateY(180deg);
    }
    .card-front, .card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .card-back {
      transform: rotateY(180deg);
    }
    @keyframes glow {
      0%, 100% { box-shadow: 0 0 20px rgba(147, 51, 234, 0.5); }
      50% { box-shadow: 0 0 40px rgba(147, 51, 234, 0.8); }
    }
    .glowing {
      animation: glow 2s ease-in-out infinite;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-purple-500 to-indigo-600 min-h-screen">
  <!-- Back Button -->
  <a href="/games" class="fixed top-4 left-4 bg-white p-3 rounded-full shadow-lg hover:scale-110 transition z-50">
    <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
  </a>

  <!-- Sound Toggle Button -->
  <button onclick="toggleSound()" id="soundBtn" 
          class="fixed top-4 right-4 bg-white p-3 rounded-full shadow-lg text-2xl hover:scale-110 transition z-50">
    🔊
  </button>

  <div class="container mx-auto p-6">
    <!-- Header -->
    <div class="text-center text-white mb-8">
      <h1 class="text-4xl font-bold mb-2">🌟 Affirmation Cards</h1>
      <p class="text-purple-100">Flip a card for your daily positive affirmation</p>
    </div>

    <!-- Game Container -->
    <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-2xl p-8">
      
      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="text-center bg-purple-50 p-4 rounded-lg">
          <div class="text-3xl font-bold text-purple-600" id="cardsFlipped">0</div>
          <div class="text-sm text-gray-600">Cards Flipped</div>
        </div>
        <div class="text-center bg-indigo-50 p-4 rounded-lg">
          <div class="text-3xl font-bold text-indigo-600" id="todayCount">0</div>
          <div class="text-sm text-gray-600">Today</div>
        </div>
        <div class="text-center bg-pink-50 p-4 rounded-lg">
          <div class="text-3xl font-bold text-pink-600" id="favoriteCount">0</div>
          <div class="text-sm text-gray-600">Favorites</div>
        </div>
      </div>

      <!-- Card Display -->
      <div class="mb-8">
        <div id="cardContainer" class="card w-full h-80 mx-auto glowing" onclick="flipCard()">
          <div class="card-inner">
            <div class="card-front bg-gradient-to-br from-purple-400 to-pink-400 text-white">
              <div class="text-center">
                <div class="text-6xl mb-4">✨</div>
                <p class="text-2xl font-bold">Tap to reveal</p>
                <p class="text-lg">your affirmation</p>
              </div>
            </div>
            <div class="card-back bg-gradient-to-br from-indigo-400 to-purple-400 text-white">
              <div class="text-center">
                <p id="affirmationText" class="text-2xl font-bold leading-relaxed"></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class="flex gap-4 mb-6">
        <button onclick="newCard()" 
                class="flex-1 bg-purple-600 text-white py-3 rounded-lg font-semibold hover:bg-purple-700 transition">
          New Card 🔄
        </button>
        <button onclick="saveFavorite()" 
                class="flex-1 bg-pink-600 text-white py-3 rounded-lg font-semibold hover:bg-pink-700 transition">
          Save Favorite ❤️
        </button>
        <button onclick="viewFavorites()" 
                class="flex-1 bg-indigo-600 text-white py-3 rounded-lg font-semibold hover:bg-indigo-700 transition">
          My Favorites 📚
        </button>
      </div>

      <!-- Tips -->
      <div class="bg-purple-50 p-4 rounded-lg">
        <h3 class="font-semibold text-purple-800 mb-2">💜 Tips:</h3>
        <ul class="text-sm text-gray-700 space-y-1">
          <li>• Read your affirmation out loud for more impact</li>
          <li>• Take a deep breath before flipping a card</li>
          <li>• Save your favorites to revisit when you need them</li>
          <li>• Start your day with a positive affirmation</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Modal for favorites -->
  <div id="favoritesModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl p-8 max-w-2xl w-full max-h-[80vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold text-gray-800">Your Favorite Affirmations ❤️</h2>
        <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="favoritesList" class="space-y-3"></div>
    </div>
  </div>

  <script>
    // 🔊 Sound Effects
    const sounds = {
      flip: new Audio('data:audio/wav;base64,'),
      save: new Audio('data:audio/wav;base64,'),
      celebrate: new Audio('https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3')
    };

    sounds.flip.volume = 0.4;
    sounds.save.volume = 0.4;
    sounds.celebrate.volume = 0.6;

    let soundEnabled = true;

    function playSound(soundName) {
      if (!soundEnabled || !sounds[soundName]) return;
      try {
        sounds[soundName].currentTime = 0;
        sounds[soundName].play().catch(e => console.log('Sound play failed:', e));
      } catch (e) {
        console.log('Sound error:', e);
      }
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundBtn');
      btn.textContent = soundEnabled ? '🔊' : '🔇';
    }

    const affirmations = [
      "I am worthy of love and respect",
      "I choose to be happy and grateful today",
      "I am capable of achieving my goals",
      "I trust myself to make good decisions",
      "I am growing and learning every day",
      "I deserve peace and happiness",
      "I am strong and resilient",
      "I believe in my abilities",
      "I am enough just as I am",
      "I choose to focus on the positive",
      "I am proud of how far I've come",
      "I am in control of my thoughts and feelings",
      "I radiate confidence and positivity",
      "I am grateful for this moment",
      "I am creating the life I want",
      "I am surrounded by love and support",
      "I trust the journey I'm on",
      "I am becoming the best version of myself",
      "I choose courage over fear",
      "I am deserving of good things"
    ];

    let currentAffirmation = '';
    let stats = JSON.parse(localStorage.getItem('affirmationStats') || '{"total": 0, "today": 0, "lastDate": ""}');
    let favorites = JSON.parse(localStorage.getItem('favoriteAffirmations') || '[]');

    function updateStats() {
      const today = new Date().toDateString();
      if (stats.lastDate !== today) {
        stats.today = 0;
        stats.lastDate = today;
      }
      
      document.getElementById('cardsFlipped').textContent = stats.total;
      document.getElementById('todayCount').textContent = stats.today;
      document.getElementById('favoriteCount').textContent = favorites.length;
      
      localStorage.setItem('affirmationStats', JSON.stringify(stats));
    }

    function getRandomAffirmation() {
      return affirmations[Math.floor(Math.random() * affirmations.length)];
    }

    function flipCard() {
      const card = document.getElementById('cardContainer');
      if (!card.classList.contains('flipped')) {
        playSound('flip');
        currentAffirmation = getRandomAffirmation();
        document.getElementById('affirmationText').textContent = currentAffirmation;
        card.classList.add('flipped');
        
        stats.total++;
        stats.today++;
        updateStats();
      }
    }

    function newCard() {
      const card = document.getElementById('cardContainer');
      card.classList.remove('flipped');
      setTimeout(() => {
        playSound('flip');
        currentAffirmation = getRandomAffirmation();
        document.getElementById('affirmationText').textContent = currentAffirmation;
        card.classList.add('flipped');
        
        stats.total++;
        stats.today++;
        updateStats();
      }, 300);
    }

    function saveFavorite() {
      if (!currentAffirmation) {
        Swal.fire({
          icon: 'info',
          title: 'Flip a card first!',
          text: 'You need to reveal an affirmation before saving it',
          confirmButtonColor: '#8b5cf6'
        });
        return;
      }
      
      if (favorites.includes(currentAffirmation)) {
        Swal.fire({
          icon: 'info',
          title: 'Already saved!',
          text: 'This affirmation is already in your favorites',
          confirmButtonColor: '#8b5cf6'
        });
        return;
      }
      
      playSound('save');
      favorites.push(currentAffirmation);
      localStorage.setItem('favoriteAffirmations', JSON.stringify(favorites));
      updateStats();
      
      Swal.fire({
        icon: 'success',
        title: 'Added to favorites! ❤️',
        text: 'You can view it anytime in your favorites',
        timer: 1500,
        showConfirmButton: false,
        toast: true,
        position: 'top-end'
      });
    }

    function viewFavorites() {
      const modal = document.getElementById('favoritesModal');
      const list = document.getElementById('favoritesList');
      
      if (favorites.length === 0) {
        list.innerHTML = '<p class="text-gray-500 text-center py-8">No favorites yet. Save some affirmations!</p>';
      } else {
        list.innerHTML = favorites.map((aff, index) => `
          <div class="bg-purple-50 p-4 rounded-lg border-l-4 border-purple-500">
            <p class="text-gray-800 mb-2">${aff}</p>
            <button onclick="removeFavorite(${index})" class="text-sm text-red-500 hover:text-red-700">Remove</button>
          </div>
        `).join('');
      }
      
      modal.classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('favoritesModal').classList.add('hidden');
    }

    function removeFavorite(index) {
      Swal.fire({
        title: 'Remove from favorites?',
        text: 'This affirmation will be removed from your saved list',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, remove it',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          favorites.splice(index, 1);
          localStorage.setItem('favoriteAffirmations', JSON.stringify(favorites));
          updateStats();
          viewFavorites();
          Swal.fire({
            icon: 'success',
            title: 'Removed!',
            timer: 1500,
            showConfirmButton: false
          });
        }
      });
    }

    // Initialize
    updateStats();
  </script>
</body>
</html>
