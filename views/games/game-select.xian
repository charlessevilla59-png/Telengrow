<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  {{> sidebar}}
  
  <!-- Navigation -->
  <nav class="bg-white shadow-md p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <button onclick="openSidebar()" class="text-gray-700 hover:text-purple-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <h1 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h1>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="container mx-auto p-6">
    <!-- Back Button -->
    <div class="mb-4">
      <a href="/user/dashboard" class="inline-flex items-center text-purple-600 hover:text-purple-700 transition">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span class="font-medium">Back to Dashboard</span>
      </a>
    </div>

    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-800 mb-2">🎮 Game Selection</h1>
      <p class="text-gray-600">Choose a game to relax and relieve stress</p>
    </div>

    <!-- Game Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
      
      <!-- Breathing Bubble -->
      <a href="/games/breathing-bubble" class="bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition transform hover:scale-105">
        <div class="text-6xl mb-4">🫧</div>
        <h2 class="text-2xl font-bold mb-2">Breathing Bubble</h2>
        <p class="text-purple-100 text-sm mb-4">Follow the bubble to practice deep breathing exercises</p>
        <div class="text-xs space-y-1">
          <div>⏱️ 5-10 minutes</div>
          <div>🎯 Easy</div>
        </div>
      </a>

      <!-- Color Tap -->
      <a href="/games/color-tap" class="bg-gradient-to-br from-pink-500 to-red-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition transform hover:scale-105">
        <div class="text-6xl mb-4">🎨</div>
        <h2 class="text-2xl font-bold mb-2">Color Tap</h2>
        <p class="text-pink-100 text-sm mb-4">Match colors quickly to improve focus</p>
        <div class="text-xs space-y-1">
          <div>⏱️ 3-5 minutes</div>
          <div>🎯 Medium</div>
        </div>
      </a>

      <!-- Grid Memory -->
      <a href="/games/grid-memory" class="bg-gradient-to-br from-blue-500 to-cyan-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition transform hover:scale-105">
        <div class="text-6xl mb-4">🧩</div>
        <h2 class="text-2xl font-bold mb-2">Grid Memory</h2>
        <p class="text-blue-100 text-sm mb-4">Remember patterns to enhance memory</p>
        <div class="text-xs space-y-1">
          <div>⏱️ 5-8 minutes</div>
          <div>🎯 Medium-Hard</div>
        </div>
      </a>

      <!-- Stress Ball -->
      <a href="/games/stress-ball" class="bg-gradient-to-br from-green-500 to-teal-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition transform hover:scale-105">
        <div class="text-6xl mb-4">🎯</div>
        <h2 class="text-2xl font-bold mb-2">Stress Ball</h2>
        <p class="text-green-100 text-sm mb-4">Click to release stress instantly</p>
        <div class="text-xs space-y-1">
          <div>⏱️ 2-5 minutes</div>
          <div>🎯 Easy</div>
        </div>
      </a>

      <!-- Gratitude Jar -->
      <a href="/games/gratitude-jar" class="bg-gradient-to-br from-yellow-500 to-orange-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition transform hover:scale-105">
        <div class="text-6xl mb-4">🏺</div>
        <h2 class="text-2xl font-bold mb-2">Gratitude Jar</h2>
        <p class="text-yellow-100 text-sm mb-4">Fill your jar with gratitude</p>
        <div class="text-xs space-y-1">
          <div>⏱️ 5-10 minutes</div>
          <div>🎯 Easy</div>
        </div>
      </a>

      <!-- Affirmation Cards -->
      <a href="/games/affirmation-cards" class="bg-gradient-to-br from-purple-500 to-indigo-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition transform hover:scale-105">
        <div class="text-6xl mb-4">🌟</div>
        <h2 class="text-2xl font-bold mb-2">Affirmation Cards</h2>
        <p class="text-purple-100 text-sm mb-4">Flip cards for positive affirmations</p>
        <div class="text-xs space-y-1">
          <div>⏱️ 2-5 minutes</div>
          <div>🎯 Easy</div>
        </div>
      </a>

      <!-- Zen Garden -->
      <a href="/games/zen-garden" class="bg-gradient-to-br from-amber-500 to-stone-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition transform hover:scale-105">
        <div class="text-6xl mb-4">🪨</div>
        <h2 class="text-2xl font-bold mb-2">Zen Garden</h2>
        <p class="text-amber-100 text-sm mb-4">Rake sand and find inner peace</p>
        <div class="text-xs space-y-1">
          <div>⏱️ 10-15 minutes</div>
          <div>🎯 Easy</div>
        </div>
      </a>

      <!-- Puzzle Therapy -->
      <a href="/games/puzzle-therapy" class="bg-gradient-to-br from-teal-500 to-blue-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition transform hover:scale-105">
        <div class="text-6xl mb-4">🧩</div>
        <h2 class="text-2xl font-bold mb-2">Puzzle Therapy</h2>
        <p class="text-teal-100 text-sm mb-4">Piece together calming images</p>
        <div class="text-xs space-y-1">
          <div>⏱️ 5-15 minutes</div>
          <div>🎯 Easy-Hard</div>
        </div>
      </a>

    </div>
  </div>
</body>
</html>
