<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gradient-to-br from-blue-500 to-cyan-600 min-h-screen">
  <!-- Back Button -->
  <a href="/games" class="fixed top-4 left-4 bg-white p-3 rounded-full shadow-lg hover:scale-110 transition z-50">
    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
  </a>

  <!-- Sound Toggle Button -->
  <button onclick="toggleSound()" id="soundBtn" 
          class="fixed top-4 right-4 bg-white p-3 rounded-full shadow-lg text-2xl hover:scale-110 transition z-50">
    🔊
  </button>

  <div class="container mx-auto p-6">
    <!-- Header -->
    <div class="text-center text-white mb-8">
      <h1 class="text-4xl font-bold mb-2">🧩 Grid Memory</h1>
      <p class="text-blue-100">Remember the pattern!</p>
    </div>

    <!-- Game Container -->
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl p-8">
      
      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="text-center">
          <div class="text-3xl font-bold text-blue-600" id="level">1</div>
          <div class="text-sm text-gray-600">Level</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-cyan-600" id="score">0</div>
          <div class="text-sm text-gray-600">Score</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-purple-600" id="lives">3</div>
          <div class="text-sm text-gray-600">Lives</div>
        </div>
      </div>

      <!-- Status Message -->
      <div id="status" class="text-center text-xl font-semibold text-gray-700 mb-6">
        Click Start to begin
      </div>

      <!-- Memory Grid -->
      <div id="memoryGrid" class="grid grid-cols-4 gap-3 mb-6 max-w-md mx-auto">
        <!-- Grid will be generated by JavaScript -->
      </div>

      <!-- Controls -->
      <div id="controls">
        <button id="startBtn" onclick="startGame()" 
                class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
          Start Game
        </button>
      </div>

      <!-- Result (Hidden initially) -->
      <div id="result" class="hidden text-center">
        <div class="text-6xl mb-4">🎮</div>
        <h2 class="text-3xl font-bold text-gray-800 mb-2">Game Over!</h2>
        <div class="text-5xl font-bold text-blue-600 mb-2" id="finalScore">0</div>
        <p class="text-gray-600 mb-6">Level Reached: <span id="finalLevel">1</span></p>
        <div class="space-y-3">
          <button onclick="location.reload()" 
                  class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
            Play Again
          </button>
          <a href="/games" 
             class="block w-full bg-gray-200 text-gray-800 py-3 rounded-lg font-semibold hover:bg-gray-300 transition">
            Back to Games
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 🔊 Sound Effects - Memory game sounds
    const sounds = {
      show: new Audio('https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3'), // Tile show
      click: new Audio('https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3'), // Tile click
      correct: new Audio('https://assets.mixkit.co/active_storage/sfx/2018/2018-preview.mp3'), // Correct sequence
      wrong: new Audio('https://assets.mixkit.co/active_storage/sfx/2955/2955-preview.mp3'), // Wrong tile
      levelUp: new Audio('https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3'), // Level up
      gameOver: new Audio('https://assets.mixkit.co/active_storage/sfx/1867/1867-preview.mp3') // Game over
    };

    // Set volumes
    sounds.show.volume = 0.3;
    sounds.click.volume = 0.4;
    sounds.correct.volume = 0.5;
    sounds.wrong.volume = 0.4;
    sounds.levelUp.volume = 0.6;
    sounds.gameOver.volume = 0.5;

    let soundEnabled = true;

    // Function to play sound
    function playSound(soundName) {
      if (!soundEnabled || !sounds[soundName]) return;
      
      try {
        sounds[soundName].currentTime = 0;
        sounds[soundName].play().catch(e => console.log('Sound play failed:', e));
      } catch (e) {
        console.log('Sound error:', e);
      }
    }

    // Toggle sound function
    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundBtn');
      btn.textContent = soundEnabled ? '🔊' : '🔇';
    }

    let level = 1;
    let score = 0;
    let lives = 3;
    let sequence = [];
    let playerSequence = [];
    let isShowingSequence = false;
    let isPlaying = false;

    function startGame() {
      level = 1;
      score = 0;
      lives = 3;
      isPlaying = true;
      
      document.getElementById('startBtn').classList.add('hidden');
      document.getElementById('result').classList.add('hidden');
      
      updateStats();
      generateGrid();
      nextLevel();
    }

    function generateGrid() {
      const grid = document.getElementById('memoryGrid');
      grid.innerHTML = '';
      
      for (let i = 0; i < 12; i++) {
        const tile = document.createElement('button');
        tile.className = 'h-20 bg-gray-200 rounded-lg hover:bg-gray-300 transition';
        tile.dataset.index = i;
        tile.onclick = () => tileClicked(i);
        grid.appendChild(tile);
      }
    }

    function nextLevel() {
      playerSequence = [];
      sequence.push(Math.floor(Math.random() * 12));
      
      document.getElementById('status').textContent = `Level ${level} - Watch carefully!`;
      isShowingSequence = true;
      
      showSequence();
    }

    function showSequence() {
      let index = 0;
      const tiles = document.querySelectorAll('#memoryGrid button');
      
      const interval = setInterval(() => {
        if (index > 0) {
          tiles[sequence[index - 1]].classList.remove('bg-blue-500');
          tiles[sequence[index - 1]].classList.add('bg-gray-200');
        }
        
        if (index < sequence.length) {
          tiles[sequence[index]].classList.remove('bg-gray-200');
          tiles[sequence[index]].classList.add('bg-blue-500');
          playSound('show'); // Play sound when showing tile
          index++;
        } else {
          tiles[sequence[index - 1]].classList.remove('bg-blue-500');
          tiles[sequence[index - 1]].classList.add('bg-gray-200');
          clearInterval(interval);
          isShowingSequence = false;
          document.getElementById('status').textContent = 'Your turn!';
        }
      }, 800);
    }

    function tileClicked(index) {
      if (!isPlaying || isShowingSequence) return;
      
      playSound('click'); // Play click sound
      
      const tiles = document.querySelectorAll('#memoryGrid button');
      tiles[index].classList.add('bg-cyan-400');
      
      setTimeout(() => {
        tiles[index].classList.remove('bg-cyan-400');
      }, 200);
      
      playerSequence.push(index);
      
      // Check if correct
      const currentStep = playerSequence.length - 1;
      if (playerSequence[currentStep] !== sequence[currentStep]) {
        playSound('wrong'); // Play wrong sound
        lives--;
        updateStats();
        
        if (lives <= 0) {
          endGame();
        } else {
          document.getElementById('status').textContent = 'Wrong! Try again...';
          setTimeout(() => {
            nextLevel();
          }, 1500);
        }
        return;
      }
      
      // Check if sequence complete
      if (playerSequence.length === sequence.length) {
        playSound('correct'); // Play correct sound
        score += level * 10;
        level++;
        updateStats();
        
        document.getElementById('status').textContent = 'Correct! Next level...';
        
        // Play level up sound after a delay
        setTimeout(() => {
          playSound('levelUp');
          nextLevel();
        }, 1500);
      }
    }

    function updateStats() {
      document.getElementById('level').textContent = level;
      document.getElementById('score').textContent = score;
      document.getElementById('lives').textContent = lives;
    }

    function endGame() {
      isPlaying = false;
      
      playSound('gameOver'); // Play game over sound
      
      // Show celebration popup with sound
      Swal.fire({
        icon: 'success',
        title: '🎮 Game Over!',
        html: `
          <p class="text-lg mb-2">Well done!</p>
          <p class="text-3xl font-bold text-blue-600 mb-2">${score} points</p>
          <p class="text-gray-600">Level reached: ${level}</p>
        `,
        confirmButtonColor: '#3b82f6',
        confirmButtonText: 'Play Again',
        showCancelButton: true,
        cancelButtonText: 'Back to Games',
        cancelButtonColor: '#6b7280',
        didOpen: () => {
          playSound('gameOver');
        }
      }).then((result) => {
        if (result.isConfirmed) {
          location.reload();
        } else if (result.dismiss === Swal.DismissReason.cancel) {
          window.location.href = '/games';
        }
      });
      
      document.getElementById('memoryGrid').classList.add('hidden');
      document.getElementById('status').classList.add('hidden');
    }
  </script>
</body>
</html>
