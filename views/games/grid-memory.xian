<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    /* Animated Background */
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    body {
      background: linear-gradient(-45deg, #3b82f6, #06b6d4, #10b981, #3b82f6);
      background-size: 400% 400%;
      animation: gradientShift 15s ease infinite;
      min-height: 100vh;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes flip {
      0% { transform: rotateY(0); }
      50% { transform: rotateY(90deg); }
      100% { transform: rotateY(0); }
    }

    @keyframes glow-blue {
      0%, 100% { box-shadow: 0 0 10px rgba(59, 130, 246, 0.3), 0 4px 20px rgba(0,0,0,0.2); }
      50% { box-shadow: 0 0 30px rgba(59, 130, 246, 1), 0 8px 40px rgba(59, 130, 246, 0.5); }
    }

    @keyframes pulse-scale {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }

    @keyframes bounce-tile {
      0% { transform: scale(1); }
      50% { transform: scale(0.95); }
      100% { transform: scale(1); }
    }

    @keyframes shake-wrong {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    .game-container {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      animation: fadeIn 0.8s ease-out;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25),
                  0 0 60px -15px rgba(59, 130, 246, 0.4);
    }

    .stats-container {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(6, 182, 212, 0.1) 100%);
      border: 1px solid rgba(59, 130, 246, 0.2);
      backdrop-filter: blur(10px);
    }

    .stat-item {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .stat-item:hover {
      transform: scale(1.1) translateY(-5px);
    }

    .memory-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .memory-tile {
      aspect-ratio: 1;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%);
      border: 2px solid #bae6fd;
      position: relative;
      overflow: hidden;
    }

    .memory-tile::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .memory-tile:hover {
      transform: scale(1.1) translateY(-4px);
      box-shadow: 0 20px 40px rgba(59, 130, 246, 0.2);
      border-color: #3b82f6;
    }

    .memory-tile:hover::before {
      opacity: 1;
    }

    .memory-tile.active {
      animation: pulse-scale 0.4s ease-out;
      background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
      box-shadow: 0 0 30px rgba(59, 130, 246, 0.8);
    }

    .memory-tile.correct {
      animation: bounce-tile 0.4s ease-out;
      background: linear-gradient(135deg, #10b981 0%, #06d6a6 100%);
      border-color: #10b981;
    }

    .memory-tile.wrong {
      animation: shake-wrong 0.3s ease-in-out;
      background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
      border-color: #ef4444;
    }

    .btn-primary {
      background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.5s ease;
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4);
    }

    .btn-primary:hover::before {
      left: 100%;
    }

    .tips-container {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(6, 182, 212, 0.15) 100%);
      border: 2px solid rgba(59, 130, 246, 0.3);
      backdrop-filter: blur(10px);
    }

    .action-btn {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .action-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .action-btn:active {
      transform: scale(0.95);
    }

    .header-text {
      animation: fadeIn 0.8s ease-out 0.1s backwards;
    }
  </style>
</head>
<body>
  <!-- Back Button -->
  <a href="/games" class="fixed top-6 left-6 bg-white p-4 rounded-full shadow-lg hover:scale-110 transition z-50 action-btn hover:shadow-2xl">
    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
  </a>

  <!-- Sound Toggle Button -->
  <button onclick="toggleSound()" id="soundBtn" 
          class="fixed top-6 right-6 bg-white p-4 rounded-full shadow-lg text-2xl hover:scale-110 transition z-50 action-btn hover:shadow-2xl">
    🔊
  </button>

  <div class="min-h-screen flex items-center justify-center p-4">
    <div class="container max-w-3xl">
      <!-- Header -->
      <div class="text-center text-white mb-12 header-text">
        <div class="text-7xl mb-4 animate-bounce">🧩</div>
        <h1 class="text-5xl font-bold mb-3 drop-shadow-lg">Grid Memory</h1>
        <p class="text-lg text-blue-100 drop-shadow">Remember the pattern and match them!</p>
      </div>

      <!-- Game Container -->
      <div class="game-container rounded-3xl shadow-2xl p-8 md:p-12">
        
        <!-- Stats -->
        <div class="stats-container rounded-2xl p-6 mb-10 grid grid-cols-3 gap-4">
          <div class="stat-item text-center">
            <div class="text-4xl font-bold bg-gradient-to-r from-blue-600 to-blue-400 bg-clip-text text-transparent" id="level">1</div>
            <div class="text-sm text-gray-600 font-semibold mt-2">Level</div>
          </div>
          <div class="stat-item text-center">
            <div class="text-4xl font-bold bg-gradient-to-r from-cyan-600 to-blue-600 bg-clip-text text-transparent" id="score">0</div>
            <div class="text-sm text-gray-600 font-semibold mt-2">Score</div>
          </div>
          <div class="stat-item text-center">
            <div class="text-4xl font-bold bg-gradient-to-r from-red-600 to-pink-600 bg-clip-text text-transparent" id="lives">3</div>
            <div class="text-sm text-gray-600 font-semibold mt-2">Lives</div>
          </div>
        </div>

        <!-- Status Message -->
        <div id="status" class="text-center text-2xl font-bold text-gray-700 mb-8 animate-fade-in">
          Click Start to begin
        </div>

        <!-- Memory Grid -->
        <div id="memoryGrid" class="memory-grid mb-10">
          <!-- Grid will be generated by JavaScript -->
        </div>

        <!-- Controls -->
        <div id="controls" class="mb-6">
          <button id="startBtn" onclick="startGame()" 
                  class="w-full btn-primary text-white py-4 px-6 rounded-xl font-bold text-lg hover:text-white transition">
            ▶️ Start Game
          </button>
        </div>

        <!-- Tips -->
        <div class="tips-container rounded-2xl p-6">
          <h3 class="font-bold text-lg text-blue-900 mb-4">💡 How to Play:</h3>
          <ul class="space-y-2 text-gray-700 font-medium">
            <li class="flex items-start gap-3">
              <span class="text-blue-600 font-bold">•</span>
              <span>Watch the tiles light up in a specific pattern</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-blue-600 font-bold">•</span>
              <span>Click the tiles in the same order</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-blue-600 font-bold">•</span>
              <span>Each level gets longer and faster</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-blue-600 font-bold">•</span>
              <span>Three mistakes and it's game over</span>
            </li>
          </ul>
        </div>

        <!-- Result (Hidden initially) -->
        <div id="result" class="hidden text-center mt-8 animate-fade-in">
          <div class="text-7xl mb-6">🎮</div>
          <h2 class="text-4xl font-bold text-gray-800 mb-2">Game Over!</h2>
          <div class="text-6xl font-bold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent mb-2" id="finalScore">0</div>
          <p class="text-gray-600 mb-6 text-lg">Level Reached: <span id="finalLevel" class="font-bold">1</span></p>
          <div class="space-y-3">
            <button onclick="location.reload()" 
                    class="w-full btn-primary text-white py-4 px-6 rounded-xl font-bold text-lg hover:text-white transition">
              🔄 Play Again
            </button>
            <a href="/games" 
               class="block w-full bg-gray-200 text-gray-800 py-4 px-6 rounded-xl font-bold text-lg hover:bg-gray-300 transition">
              ← Back to Games
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 🔊 Enhanced Sound Effects for Memory Game
    class MemorySounds {
      constructor() {
        this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
      }

      playTone(frequency, duration = 0.1, type = 'sine', vol = 0.3) {
        try {
          const now = this.audioContext.currentTime;
          const osc = this.audioContext.createOscillator();
          const gain = this.audioContext.createGain();

          osc.connect(gain);
          gain.connect(this.audioContext.destination);
          osc.type = type;
          osc.frequency.value = frequency;

          gain.gain.setValueAtTime(vol, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + duration);

          osc.start(now);
          osc.stop(now + duration);
        } catch (e) {
          console.log('Audio error:', e);
        }
      }

      show() { this.playTone(600, 0.15, 'sine', 0.4); }
      click() { this.playTone(700, 0.12, 'sine', 0.3); }
      correct() { this.playTone(1000, 0.2); this.playTone(1200, 0.1); }
      wrong() { this.playTone(300, 0.3, 'triangle'); }
      levelUp() { this.playTone(500, 0.1); this.playTone(700, 0.1); this.playTone(900, 0.2); }
      gameOver() { this.playTone(400, 0.2); this.playTone(300, 0.3); }
    }

    const synth = new MemorySounds();
    let soundEnabled = true;

    function playSound(soundName) {
      if (!soundEnabled) return;
      try {
        if (soundName === 'show') synth.show();
        else if (soundName === 'click') synth.click();
        else if (soundName === 'correct') synth.correct();
        else if (soundName === 'wrong') synth.wrong();
        else if (soundName === 'levelUp') synth.levelUp();
        else if (soundName === 'gameOver') synth.gameOver();
      } catch (e) {
        console.log('Sound error:', e);
      }
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundBtn');
      btn.textContent = soundEnabled ? '🔊' : '🔇';
      btn.style.animation = 'pulse-scale 0.4s ease-out';
      setTimeout(() => btn.style.animation = 'none', 400);
    }

    let level = 1;
    let score = 0;
    let lives = 3;
    let sequence = [];
    let playerSequence = [];
    let isShowingSequence = false;
    let isPlaying = false;

    function startGame() {
      level = 1;
      score = 0;
      lives = 3;
      isPlaying = true;
      
      document.getElementById('startBtn').classList.add('hidden');
      document.getElementById('result').classList.add('hidden');
      
      updateStats();
      generateGrid();
      nextLevel();
    }

    function generateGrid() {
      const grid = document.getElementById('memoryGrid');
      grid.innerHTML = '';
      
      for (let i = 0; i < 12; i++) {
        const tile = document.createElement('button');
        tile.className = 'memory-tile';
        tile.dataset.index = i;
        tile.onclick = () => tileClicked(i);
        grid.appendChild(tile);
      }
    }

    function nextLevel() {
      playerSequence = [];
      sequence.push(Math.floor(Math.random() * 12));
      
      document.getElementById('status').textContent = `Level ${level} - Watch carefully!`;
      isShowingSequence = true;
      
      showSequence();
    }

    function showSequence() {
      let index = 0;
      const tiles = document.querySelectorAll('#memoryGrid button');
      
      const interval = setInterval(() => {
        if (index > 0) {
          tiles[sequence[index - 1]].classList.remove('active');
        }
        
        if (index < sequence.length) {
          tiles[sequence[index]].classList.add('active');
          playSound('show');
          index++;
        } else {
          tiles[sequence[index - 1]].classList.remove('bg-blue-500');
          tiles[sequence[index - 1]].classList.add('bg-gray-200');
          clearInterval(interval);
          isShowingSequence = false;
          document.getElementById('status').textContent = 'Your turn!';
        }
      }, 800);
    }

    function tileClicked(index) {
      if (!isPlaying || isShowingSequence) return;
      
      playSound('click'); // Play click sound
      
      const tiles = document.querySelectorAll('#memoryGrid button');
      tiles[index].classList.add('bg-cyan-400');
      
      setTimeout(() => {
        tiles[index].classList.remove('bg-cyan-400');
      }, 200);
      
      playerSequence.push(index);
      
      // Check if correct
      const currentStep = playerSequence.length - 1;
      if (playerSequence[currentStep] !== sequence[currentStep]) {
        playSound('wrong'); // Play wrong sound
        lives--;
        updateStats();
        
        if (lives <= 0) {
          endGame();
        } else {
          document.getElementById('status').textContent = 'Wrong! Try again...';
          setTimeout(() => {
            nextLevel();
          }, 1500);
        }
        return;
      }
      
      // Check if sequence complete
      if (playerSequence.length === sequence.length) {
        playSound('correct'); // Play correct sound
        score += level * 10;
        level++;
        updateStats();
        
        document.getElementById('status').textContent = 'Correct! Next level...';
        
        // Play level up sound after a delay
        setTimeout(() => {
          playSound('levelUp');
          nextLevel();
        }, 1500);
      }
    }

    function updateStats() {
      document.getElementById('level').textContent = level;
      document.getElementById('score').textContent = score;
      document.getElementById('lives').textContent = lives;
    }

    function endGame() {
      isPlaying = false;
      
      playSound('gameOver'); // Play game over sound
      
      const calculatedPoints = Math.floor(score * 2 + level * 15);
      
      // Show celebration popup with save option
      Swal.fire({
        icon: 'success',
        title: '🎮 Game Over!',
        html: `
          <p class="text-lg mb-2">Well done!</p>
          <p class="text-3xl font-bold text-blue-600 mb-2">${score} points</p>
          <p class="text-gray-600">Level reached: ${level}</p>
          <p class="text-2xl font-bold text-green-600 mt-3">+${calculatedPoints}! 🎯</p>
        `,
        confirmButtonColor: '#3b82f6',
        confirmButtonText: 'Save & Dashboard',
        showCancelButton: true,
        cancelButtonText: 'Play Again',
        cancelButtonColor: '#6b7280',
        didOpen: () => {
          playSound('gameOver');
        }
      }).then((result) => {
        if (result.isConfirmed) {
          saveGridMemoryScore(score, calculatedPoints);
        } else if (result.dismiss === Swal.DismissReason.cancel) {
          location.reload();
        }
      });
      
      document.getElementById('memoryGrid').classList.add('hidden');
      document.getElementById('status').classList.add('hidden');
    }

    // 💾 Save Grid Memory Score
    async function saveGridMemoryScore(score, points) {
      try {
        const response = await fetch('/api/games/save-score', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            gameType: 'grid-memory',
            score: score,
            points: points,
            duration: 0,
            difficulty: level <= 2 ? 'easy' : level <= 4 ? 'medium' : level <= 6 ? 'hard' : 'expert',
            accuracy: 100
          })
        });

        const data = await response.json();

        if (data.success) {
          localStorage.setItem('pointsUpdated', Date.now().toString());
          Swal.fire({
            icon: 'success',
            title: '✅ Score Saved!',
            html: `
              <p class="text-lg mb-2">Amazing memory!</p>
              <p class="text-3xl font-bold text-green-600 mb-2">+${points} Points!</p>
              <p class="text-gray-600">Total Points: ${data.totalPoints}</p>
            `,
            confirmButtonColor: '#10b981',
            confirmButtonText: 'View Dashboard',
            allowOutsideClick: false
          }).then(() => {
            window.location.href = '/user/dashboard';
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.message || 'Failed to save score',
            confirmButtonColor: '#3b82f6'
          });
        }
      } catch (error) {
        console.error('Save error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Connection Error',
          text: 'Failed to save. Check your connection.',
          confirmButtonColor: '#3b82f6'
        });
      }
    }
  </script>
</body>
</html>
