<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    .ball {
      transition: transform 0.1s;
      cursor: pointer;
    }
    .ball:active {
      transform: scale(0.9);
    }
    @keyframes squeeze {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(0.85); }
    }
    .squeezing {
      animation: squeeze 0.3s ease-in-out;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-green-500 to-teal-600 min-h-screen">
  <!-- Back Button -->
  <a href="/games" class="fixed top-4 left-4 bg-white p-3 rounded-full shadow-lg hover:scale-110 transition z-50">
    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
  </a>

  <!-- Sound Toggle Button -->
  <button onclick="toggleSound()" id="soundBtn" 
          class="fixed top-4 right-4 bg-white p-3 rounded-full shadow-lg text-2xl hover:scale-110 transition z-50">
    🔊
  </button>

  <div class="container mx-auto p-6">
    <!-- Header -->
    <div class="text-center text-white mb-8">
      <h1 class="text-4xl font-bold mb-2">🎯 Stress Ball</h1>
      <p class="text-green-100">Click to release stress!</p>
    </div>

    <!-- Game Container -->
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl p-8">
      
      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="text-center">
          <div class="text-3xl font-bold text-green-600" id="clicks">0</div>
          <div class="text-sm text-gray-600">Clicks</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-teal-600" id="points">0</div>
          <div class="text-sm text-gray-600">Points</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-purple-600" id="stress">100%</div>
          <div class="text-sm text-gray-600">Stress</div>
        </div>
      </div>

      <!-- Stress Meter -->
      <div class="mb-8">
        <div class="flex justify-between text-sm text-gray-600 mb-2">
          <span>Stress Level</span>
          <span id="stressText">Very Stressed</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-4">
          <div id="stressMeter" class="bg-gradient-to-r from-red-500 to-orange-500 h-4 rounded-full transition-all duration-300" style="width: 100%"></div>
        </div>
      </div>

      <!-- Stress Ball -->
      <div class="flex justify-center mb-8">
        <div id="stressBall" onclick="squeezeBall()" 
             class="ball w-64 h-64 rounded-full bg-gradient-to-br from-green-400 to-teal-500 shadow-2xl flex items-center justify-center">
          <span class="text-6xl">🎯</span>
        </div>
      </div>

      <!-- Message -->
      <div id="message" class="text-center text-xl font-semibold text-gray-700 mb-6">
        Click the ball to release stress!
      </div>

      <!-- Motivational Messages -->
      <div class="bg-green-50 rounded-lg p-4">
        <h3 class="font-semibold text-green-800 mb-2">💚 Keep Going!</h3>
        <p id="motivation" class="text-sm text-green-700">
          Every click helps you relax. Take deep breaths between clicks.
        </p>
      </div>

      <!-- Reset Button -->
      <button onclick="resetGame()" 
              class="w-full mt-6 bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 transition">
        Reset
      </button>
    </div>
  </div>

  <script>
    // 🔊 Sound Effects - Relaxing tap sounds
    const sounds = {
      tap: new Audio('https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3'), // Soft tap
      pop: new Audio('https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3'), // Pop sound
      calm: new Audio('https://assets.mixkit.co/active_storage/sfx/2019/2019-preview.mp3'), // Calm achievement
      complete: new Audio('https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3') // Complete
    };

    // Set volumes - soft and relaxing
    sounds.tap.volume = 0.2;
    sounds.pop.volume = 0.3;
    sounds.calm.volume = 0.4;
    sounds.complete.volume = 0.5;

    let soundEnabled = true;

    // Function to play sound
    function playSound(soundName) {
      if (!soundEnabled || !sounds[soundName]) return;
      
      try {
        sounds[soundName].currentTime = 0;
        sounds[soundName].play().catch(e => console.log('Sound play failed:', e));
      } catch (e) {
        console.log('Sound error:', e);
      }
    }

    // Toggle sound function
    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundBtn');
      btn.textContent = soundEnabled ? '🔊' : '🔇';
    }

    let clicks = 0;
    let points = 0;
    let stressLevel = 100;

    const motivationalMessages = [
      "You're doing great! Keep clicking!",
      "Feel the stress melting away...",
      "Each click brings more calm.",
      "You're on your way to relaxation!",
      "Breathe deeply and continue.",
      "Stress is leaving your body.",
      "You're becoming more peaceful.",
      "Keep up the good work!",
      "Almost there! You're doing amazing!",
      "You've reached a state of calm!"
    ];

    const stressMessages = [
      { threshold: 90, text: "Very Stressed", color: "from-red-500 to-orange-500" },
      { threshold: 70, text: "Stressed", color: "from-orange-500 to-yellow-500" },
      { threshold: 50, text: "Moderate", color: "from-yellow-500 to-green-400" },
      { threshold: 30, text: "Relaxed", color: "from-green-400 to-teal-500" },
      { threshold: 0, text: "Very Calm", color: "from-teal-500 to-blue-500" }
    ];

    function squeezeBall() {
      clicks++;
      points++;
      stressLevel = Math.max(0, stressLevel - 1);
      
      // Play sound based on stress level
      if (stressLevel === 0) {
        playSound('complete'); // Complete sound when fully calm
      } else if (stressLevel % 10 === 0) {
        playSound('calm'); // Calm sound every 10 clicks
      } else if (clicks % 5 === 0) {
        playSound('pop'); // Pop sound every 5 clicks
      } else {
        playSound('tap'); // Regular tap sound
      }
      
      // Add squeeze animation
      const ball = document.getElementById('stressBall');
      ball.classList.add('squeezing');
      setTimeout(() => ball.classList.remove('squeezing'), 300);
      
      updateStats();
      updateStressMeter();
      updateMessage();
    }

    function updateStats() {
      document.getElementById('clicks').textContent = clicks;
      document.getElementById('points').textContent = points;
      document.getElementById('stress').textContent = stressLevel + '%';
    }

    function updateStressMeter() {
      const meter = document.getElementById('stressMeter');
      meter.style.width = stressLevel + '%';
      
      // Update color based on stress level
      for (let msg of stressMessages) {
        if (stressLevel >= msg.threshold) {
          meter.className = `bg-gradient-to-r ${msg.color} h-4 rounded-full transition-all duration-300`;
          document.getElementById('stressText').textContent = msg.text;
          break;
        }
      }
    }

    function updateMessage() {
      const messageIndex = Math.floor((100 - stressLevel) / 10);
      const message = motivationalMessages[Math.min(messageIndex, motivationalMessages.length - 1)];
      document.getElementById('motivation').textContent = message;
      
      if (stressLevel === 0) {
        playSound('complete');
        
        // Show celebration popup
        Swal.fire({
          icon: 'success',
          title: '🎉 Perfect!',
          text: 'You are completely calm! All stress released!',
          confirmButtonColor: '#10b981',
          confirmButtonText: 'Awesome!',
          didOpen: () => {
            playSound('complete');
          }
        });
        
        document.getElementById('message').textContent = '🎉 Perfect! You are completely calm!';
        document.getElementById('message').classList.add('text-green-600');
      } else if (stressLevel < 30) {
        document.getElementById('message').textContent = '😌 You\'re feeling much better!';
      } else if (stressLevel < 70) {
        document.getElementById('message').textContent = '👍 Keep going, you\'re doing well!';
      }
    }

    function resetGame() {
      clicks = 0;
      points = 0;
      stressLevel = 100;
      
      updateStats();
      updateStressMeter();
      
      document.getElementById('message').textContent = 'Click the ball to release stress!';
      document.getElementById('message').classList.remove('text-green-600');
      document.getElementById('motivation').textContent = 'Every click helps you relax. Take deep breaths between clicks.';
    }
  </script>
</body>
</html>
