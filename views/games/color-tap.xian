<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gradient-to-br from-pink-500 to-red-600 min-h-screen">
  <!-- Back Button -->
  <a href="/games" class="fixed top-4 left-4 bg-white p-3 rounded-full shadow-lg hover:scale-110 transition z-50">
    <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
  </a>

  <!-- Sound Toggle Button -->
  <button onclick="toggleSound()" id="soundBtn" 
          class="fixed top-4 right-4 bg-white p-3 rounded-full shadow-lg text-2xl hover:scale-110 transition z-50">
    🔊
  </button>

  <div class="container mx-auto p-6">
    <!-- Header -->
    <div class="text-center text-white mb-8">
      <h1 class="text-4xl font-bold mb-2">🎨 Color Tap</h1>
      <p class="text-pink-100">Tap the matching colors!</p>
    </div>

    <!-- Game Container -->
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl p-8">
      
      <!-- Stats -->
      <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="text-center">
          <div class="text-2xl font-bold text-pink-600" id="score">0</div>
          <div class="text-xs text-gray-600">Score</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-purple-600" id="combo">0</div>
          <div class="text-xs text-gray-600">Combo</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-blue-600" id="timer">30</div>
          <div class="text-xs text-gray-600">Time</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-green-600" id="level">1</div>
          <div class="text-xs text-gray-600">Level</div>
        </div>
      </div>

      <!-- Target Color -->
      <div class="text-center mb-6">
        <p class="text-gray-600 mb-2">Tap this color:</p>
        <div id="targetColor" class="w-24 h-24 mx-auto rounded-lg shadow-lg"></div>
      </div>

      <!-- Color Grid -->
      <div id="colorGrid" class="grid grid-cols-3 gap-4 mb-6">
        <!-- Colors will be generated by JavaScript -->
      </div>

      <!-- Start Button -->
      <button id="startBtn" onclick="startGame()" 
              class="w-full bg-pink-600 text-white py-3 rounded-lg font-semibold hover:bg-pink-700 transition">
        Start Game
      </button>

      <!-- Result (Hidden initially) -->
      <div id="result" class="hidden text-center">
        <div class="text-6xl mb-4">🎉</div>
        <h2 class="text-3xl font-bold text-gray-800 mb-2">Game Over!</h2>
        <div class="text-5xl font-bold text-pink-600 mb-4" id="finalScore">0</div>
        <div class="space-y-3">
          <button onclick="location.reload()" 
                  class="w-full bg-pink-600 text-white py-3 rounded-lg font-semibold hover:bg-pink-700 transition">
            Play Again
          </button>
          <a href="/games" 
             class="block w-full bg-gray-200 text-gray-800 py-3 rounded-lg font-semibold hover:bg-gray-300 transition">
            Back to Games
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 🔊 Sound Effects
    const sounds = {
      correct: new Audio('https://assets.mixkit.co/active_storage/sfx/2018/2018-preview.mp3'),
      wrong: new Audio('https://assets.mixkit.co/active_storage/sfx/2955/2955-preview.mp3'),
      click: new Audio('https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3'),
      levelUp: new Audio('https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3'),
      gameOver: new Audio('https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3')
    };

    // Set volume for all sounds
    Object.values(sounds).forEach(sound => {
      sound.volume = 0.4;
    });

    // Function to play sound
    function playSound(soundName) {
      if (sounds[soundName]) {
        sounds[soundName].currentTime = 0;
        sounds[soundName].play().catch(e => console.log('Sound play failed:', e));
      }
    }

    const colors = [
      { name: 'red', hex: '#ef4444' },
      { name: 'blue', hex: '#3b82f6' },
      { name: 'green', hex: '#10b981' },
      { name: 'yellow', hex: '#f59e0b' },
      { name: 'purple', hex: '#a855f7' },
      { name: 'pink', hex: '#ec4899' },
      { name: 'orange', hex: '#f97316' },
      { name: 'teal', hex: '#14b8a6' }
    ];

    let score = 0;
    let combo = 0;
    let level = 1;
    let timeLeft = 30;
    let targetColor;
    let gameInterval;
    let isPlaying = false;
    let soundEnabled = true;

    function startGame() {
      playSound('click'); // Play click sound when starting
      
      score = 0;
      combo = 0;
      level = 1;
      timeLeft = 30;
      isPlaying = true;
      
      document.getElementById('startBtn').classList.add('hidden');
      document.getElementById('result').classList.add('hidden');
      
      updateStats();
      generateGrid();
      
      gameInterval = setInterval(() => {
        timeLeft--;
        document.getElementById('timer').textContent = timeLeft;
        
        if (timeLeft <= 0) {
          endGame();
        }
      }, 1000);
    }

    function generateGrid() {
      const grid = document.getElementById('colorGrid');
      grid.innerHTML = '';
      
      // Pick random target color
      targetColor = colors[Math.floor(Math.random() * colors.length)];
      document.getElementById('targetColor').style.backgroundColor = targetColor.hex;
      
      // Generate 9 colors (including at least one target)
      const gridColors = [];
      gridColors.push(targetColor); // Ensure at least one match
      
      for (let i = 1; i < 9; i++) {
        gridColors.push(colors[Math.floor(Math.random() * colors.length)]);
      }
      
      // Shuffle
      gridColors.sort(() => Math.random() - 0.5);
      
      // Create buttons
      gridColors.forEach(color => {
        const button = document.createElement('button');
        button.className = 'h-20 rounded-lg shadow-lg hover:scale-105 transition transform';
        button.style.backgroundColor = color.hex;
        button.onclick = () => checkColor(color);
        grid.appendChild(button);
      });
    }

    function checkColor(selectedColor) {
      if (!isPlaying) return;
      
      if (selectedColor.name === targetColor.name) {
        playSound('correct'); // Play correct sound
        
        score += (10 * level) + (combo * 5);
        combo++;
        
        if (combo % 5 === 0) {
          level++;
          timeLeft += 5; // Bonus time
          playSound('levelUp'); // Play level up sound
        }
        
        updateStats();
        generateGrid();
      } else {
        playSound('wrong'); // Play wrong sound
        combo = 0;
        updateStats();
      }
    }

    function updateStats() {
      document.getElementById('score').textContent = score;
      document.getElementById('combo').textContent = combo;
      document.getElementById('level').textContent = level;
    }

    function endGame() {
      isPlaying = false;
      clearInterval(gameInterval);
      
      playSound('gameOver'); // Play game over sound
      
      // Show celebration popup with sound
      Swal.fire({
        icon: 'success',
        title: '🎉 Game Over!',
        html: `
          <p class="text-lg mb-2">Great job!</p>
          <p class="text-3xl font-bold text-pink-600 mb-2">${score} points</p>
          <p class="text-gray-600">Level reached: ${level}</p>
        `,
        confirmButtonColor: '#ec4899',
        confirmButtonText: 'Play Again',
        showCancelButton: true,
        cancelButtonText: 'Back to Games',
        cancelButtonColor: '#6b7280',
        didOpen: () => {
          playSound('gameOver');
        }
      }).then((result) => {
        if (result.isConfirmed) {
          location.reload();
        } else if (result.dismiss === Swal.DismissReason.cancel) {
          window.location.href = '/games';
        }
      });
      
      document.getElementById('colorGrid').classList.add('hidden');
      document.getElementById('targetColor').classList.add('hidden');
    }

    // Toggle sound function
    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundBtn');
      btn.textContent = soundEnabled ? '🔊' : '🔇';
      
      // Mute/unmute all sounds
      Object.values(sounds).forEach(sound => {
        sound.volume = soundEnabled ? 0.4 : 0;
      });
    }
  </script>
</body>
</html>
