<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    /* Animated Background */
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    body {
      background: linear-gradient(-45deg, #ff6b6b, #ff8c42, #ffd93d, #ff6b6b);
      background-size: 400% 400%;
      animation: gradientShift 15s ease infinite;
      min-height: 100vh;
    }

    /* Smooth animations */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    @keyframes bounce-pop {
      0% { transform: scale(0); opacity: 1; }
      100% { transform: scale(1.5); opacity: 0; }
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    @keyframes spin-bounce {
      0% { transform: scale(1) rotate(0deg); }
      50% { transform: scale(1.1) rotate(10deg); }
      100% { transform: scale(1) rotate(0deg); }
    }

    @keyframes glow-pulse {
      0%, 100% { box-shadow: 0 0 10px rgba(255, 107, 107, 0.3), 0 4px 20px rgba(0,0,0,0.2); }
      50% { box-shadow: 0 0 30px rgba(255, 107, 107, 0.8), 0 8px 40px rgba(0,0,0,0.3); }
    }

    @keyframes color-shift {
      0% { filter: brightness(1) saturate(1); }
      50% { filter: brightness(1.2) saturate(1.3); }
      100% { filter: brightness(1) saturate(1); }
    }

    /* Container Styling */
    .game-container {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      animation: fadeIn 0.8s ease-out;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25),
                  0 0 60px -15px rgba(255, 107, 107, 0.4);
    }

    /* Stats Container */
    .stats-container {
      background: linear-gradient(135deg, rgba(255, 107, 107, 0.1) 0%, rgba(255, 140, 66, 0.1) 100%);
      border: 1px solid rgba(255, 107, 107, 0.2);
      backdrop-filter: blur(10px);
    }

    /* Stat Items */
    .stat-item {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .stat-item:hover {
      transform: scale(1.1) translateY(-5px);
    }

    /* Color Grid */
    .color-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .color-box {
      aspect-ratio: 1;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      position: relative;
      overflow: hidden;
    }

    .color-box::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.3) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .color-box:hover {
      transform: scale(1.12) translateY(-8px) rotate(2deg);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
      animation: glow-pulse 0.6s ease-in-out;
    }

    .color-box:hover::before {
      opacity: 1;
    }

    .color-box:active {
      transform: scale(0.9);
      animation: spin-bounce 0.4s ease-out;
    }

    .color-box.correct {
      animation: spin-bounce 0.5s ease-out;
    }

    .color-box.wrong {
      animation: shake 0.3s ease-in-out;
      opacity: 0.7;
    }

    /* Button Styling */
    .btn-primary {
      background: linear-gradient(135deg, #ff6b6b 0%, #ff8c42 100%);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.5s ease;
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(255, 107, 107, 0.4);
    }

    .btn-primary:hover::before {
      left: 100%;
    }

    /* Tips Container */
    .tips-container {
      background: linear-gradient(135deg, rgba(255, 107, 107, 0.15) 0%, rgba(255, 140, 66, 0.15) 100%);
      border: 2px solid rgba(255, 107, 107, 0.3);
      backdrop-filter: blur(10px);
    }

    .action-btn {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .action-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .action-btn:active {
      transform: scale(0.95);
    }

    .header-text {
      animation: fadeIn 0.8s ease-out 0.1s backwards;
    }

    /* Sound Toggle Button */
    #soundBtn {
      position: fixed;
      top: 24px;
      right: 24px;
      background: white;
      border-radius: 50%;
      padding: 1rem;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      font-size: 1.5rem;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      z-index: 50;
      border: 2px solid transparent;
    }

    #soundBtn:hover {
      transform: scale(1.15) rotate(10deg);
      box-shadow: 0 15px 40px rgba(255, 107, 107, 0.4);
      border-color: #ff6b6b;
    }

    #soundBtn:active {
      transform: scale(0.95);
    }

    /* Particle Effect */
    .particle {
      position: fixed;
      pointer-events: none;
      font-size: 1.5rem;
      animation: bounce-pop 0.8s ease-out forwards;
    }

    /* Combo Counter Animation */
    .combo-text {
      position: fixed;
      pointer-events: none;
      font-weight: bold;
      font-size: 2rem;
      animation: bounce-pop 1s ease-out forwards;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    }

    /* Target Color Highlight */
    #targetColor {
      animation: color-shift 0.6s ease-in-out;
    }

    /* Back button enhancement */
    a[href="/games"] {
      position: fixed;
      top: 24px;
      left: 24px;
      background: white;
      border-radius: 50%;
      padding: 1rem;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      z-index: 50;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    a[href="/games"]:hover {
      transform: scale(1.15) translateX(-5px);
      box-shadow: 0 15px 40px rgba(255, 107, 107, 0.4);
    }

    a[href="/games"]:active {
      transform: scale(0.95);
    }
  </style>
</head>
<body>
  <!-- Back Button -->
  <a href="/games" class="fixed top-6 left-6 bg-white p-4 rounded-full shadow-lg hover:scale-110 transition z-50 action-btn hover:shadow-2xl">
    <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
  </a>

  <!-- Sound Toggle Button -->
  <button onclick="toggleSound()" id="soundBtn" 
          class="fixed top-6 right-6 bg-white p-4 rounded-full shadow-lg text-2xl hover:scale-110 transition z-50 action-btn hover:shadow-2xl">
    🔊
  </button>

  <div class="min-h-screen flex items-center justify-center p-4">
    <div class="container max-w-2xl">
      <!-- Header -->
      <div class="text-center text-white mb-12 header-text">
        <div class="text-7xl mb-4 animate-bounce">🎨</div>
        <h1 class="text-5xl font-bold mb-3 drop-shadow-lg">Color Tap</h1>
        <p class="text-lg text-orange-100 drop-shadow">Test your focus and reaction speed!</p>
      </div>

      <!-- Game Container -->
      <div class="game-container rounded-3xl shadow-2xl p-8 md:p-12">
        
        <!-- Stats -->
        <div class="stats-container rounded-2xl p-6 mb-10 grid grid-cols-4 gap-4">
          <div class="stat-item text-center">
            <div class="text-4xl font-bold bg-gradient-to-r from-orange-600 to-red-600 bg-clip-text text-transparent" id="score">0</div>
            <div class="text-sm text-gray-600 font-semibold mt-2">Score</div>
          </div>
          <div class="stat-item text-center">
            <div class="text-4xl font-bold bg-gradient-to-r from-yellow-600 to-orange-600 bg-clip-text text-transparent" id="combo">0</div>
            <div class="text-sm text-gray-600 font-semibold mt-2">Combo</div>
          </div>
          <div class="stat-item text-center">
            <div class="text-4xl font-bold bg-gradient-to-r from-orange-600 to-pink-600 bg-clip-text text-transparent" id="timer">30</div>
            <div class="text-sm text-gray-600 font-semibold mt-2">Time</div>
          </div>
          <div class="stat-item text-center">
            <div class="text-4xl font-bold bg-gradient-to-r from-red-600 to-orange-600 bg-clip-text text-transparent" id="level">1</div>
            <div class="text-sm text-gray-600 font-semibold mt-2">Level</div>
          </div>
        </div>

        <!-- Target Color -->
        <div class="text-center mb-10">
          <p class="text-gray-700 font-bold mb-4">Tap this color:</p>
          <div id="targetColor" class="w-32 h-32 mx-auto rounded-2xl shadow-2xl transform hover:scale-110 transition"></div>
        </div>

        <!-- Color Grid -->
        <div id="colorGrid" class="color-grid mb-10">
          <!-- Colors will be generated by JavaScript -->
        </div>

        <!-- Start Button -->
        <button id="startBtn" onclick="startGame()" 
                class="w-full btn-primary text-white py-4 px-6 rounded-xl font-bold text-lg hover:text-white transition mb-6">
          ▶️ Start Game
        </button>

        <!-- Tips -->
        <div class="tips-container rounded-2xl p-6">
          <h3 class="font-bold text-lg text-orange-900 mb-4">💡 Pro Tips:</h3>
          <ul class="space-y-2 text-gray-700 font-medium">
            <li class="flex items-start gap-3">
              <span class="text-orange-600 font-bold">•</span>
              <span>Focus on the target color at the top</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-orange-600 font-bold">•</span>
              <span>Click the matching color in the grid as fast as you can</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-orange-600 font-bold">•</span>
              <span>Build your combo for bonus points</span>
            </li>
          </ul>
        </div>

        <!-- Result (Hidden initially) -->
        <div id="result" class="hidden text-center mt-8 animate-fade-in">
          <div class="text-7xl mb-6">🎉</div>
          <h2 class="text-4xl font-bold text-gray-800 mb-4">Game Over!</h2>
          <div class="text-6xl font-bold bg-gradient-to-r from-orange-600 to-red-600 bg-clip-text text-transparent mb-6" id="finalScore">0</div>
          <div class="space-y-3">
            <button onclick="location.reload()" 
                    class="w-full btn-primary text-white py-4 px-6 rounded-xl font-bold text-lg hover:text-white transition">
              🔄 Play Again
            </button>
            <a href="/games" 
               class="block w-full bg-gray-200 text-gray-800 py-4 px-6 rounded-xl font-bold text-lg hover:bg-gray-300 transition">
              ← Back to Games
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 🔊 Enhanced Sound Effects using Web Audio API Synthesis
    class SoundEffects {
      constructor() {
        this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
      }

      playTone(frequency, duration = 0.1, type = 'sine') {
        try {
          const now = this.audioContext.currentTime;
          const osc = this.audioContext.createOscillator();
          const gain = this.audioContext.createGain();

          osc.connect(gain);
          gain.connect(this.audioContext.destination);
          osc.type = type;
          osc.frequency.value = frequency;

          gain.gain.setValueAtTime(0.3, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + duration);

          osc.start(now);
          osc.stop(now + duration);
        } catch (e) {
          console.log('Audio API error:', e);
        }
      }

      correct() { this.playTone(800, 0.15); this.playTone(1000, 0.1, 'square'); }
      wrong() { this.playTone(300, 0.2, 'triangle'); this.playTone(250, 0.15, 'triangle'); }
      click() { this.playTone(600, 0.08); }
      levelUp() { this.playTone(500, 0.1); this.playTone(700, 0.1); this.playTone(900, 0.15); }
      gameOver() { this.playTone(400, 0.2); this.playTone(350, 0.2); this.playTone(300, 0.3); }
    }

    const synth = new SoundEffects();
    let soundEnabled = true;

    // Particle Effect System
    function createParticle(x, y, emoji = '✨', duration = 800) {
      const particle = document.createElement('div');
      particle.className = 'particle';
      particle.textContent = emoji;
      particle.style.left = x + 'px';
      particle.style.top = y + 'px';
      particle.style.animation = `bounce-pop ${duration / 1000}s ease-out`;
      document.body.appendChild(particle);
      setTimeout(() => particle.remove(), duration);
    }

    // Audio URLs (fallback for external sounds if Web Audio fails)
    const sounds = {
      correct: 'https://assets.mixkit.co/active_storage/sfx/2018/2018-preview.mp3',
      wrong: 'https://assets.mixkit.co/active_storage/sfx/2955/2955-preview.mp3',
      click: 'https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3',
      levelUp: 'https://assets.mixkit.co/active_storage/sfx/2000/2000-preview.mp3',
      gameOver: 'https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3'
    };

    function playSound(soundName) {
      if (!soundEnabled) return;
      try {
        if (soundName === 'correct') synth.correct();
        else if (soundName === 'wrong') synth.wrong();
        else if (soundName === 'click') synth.click();
        else if (soundName === 'levelUp') synth.levelUp();
        else if (soundName === 'gameOver') synth.gameOver();
      } catch (e) {
        console.log('Sound error:', e);
      }
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundBtn');
      btn.textContent = soundEnabled ? '🔊' : '🔇';
      btn.style.animation = 'spin-bounce 0.4s ease-out';
      setTimeout(() => btn.style.animation = 'none', 400);
    }

    const colors = [
      { name: 'red', hex: '#ef4444' },
      { name: 'blue', hex: '#3b82f6' },
      { name: 'green', hex: '#10b981' },
      { name: 'yellow', hex: '#f59e0b' },
      { name: 'purple', hex: '#a855f7' },
      { name: 'pink', hex: '#ec4899' },
      { name: 'orange', hex: '#f97316' },
      { name: 'teal', hex: '#14b8a6' }
    ];

    let score = 0;
    let combo = 0;
    let level = 1;
    let timeLeft = 30;
    let targetColor;
    let gameInterval;
    let isPlaying = false;

    function startGame() {
      playSound('click'); // Play click sound when starting
      
      score = 0;
      combo = 0;
      level = 1;
      timeLeft = 30;
      isPlaying = true;
      
      document.getElementById('startBtn').classList.add('hidden');
      document.getElementById('result').classList.add('hidden');
      
      updateStats();
      generateGrid();
      
      gameInterval = setInterval(() => {
        timeLeft--;
        document.getElementById('timer').textContent = timeLeft;
        
        if (timeLeft <= 0) {
          endGame();
        }
      }, 1000);
    }

    function generateGrid() {
      const grid = document.getElementById('colorGrid');
      grid.innerHTML = '';
      
      // Pick random target color
      targetColor = colors[Math.floor(Math.random() * colors.length)];
      document.getElementById('targetColor').style.backgroundColor = targetColor.hex;
      document.getElementById('targetColor').style.animation = 'none';
      setTimeout(() => {
        document.getElementById('targetColor').style.animation = 'color-shift 0.6s ease-in-out';
      }, 10);
      
      // Generate 9 colors (including at least one target)
      const gridColors = [];
      gridColors.push(targetColor);
      
      for (let i = 1; i < 9; i++) {
        gridColors.push(colors[Math.floor(Math.random() * colors.length)]);
      }
      
      // Shuffle
      gridColors.sort(() => Math.random() - 0.5);
      
      // Create buttons
      gridColors.forEach((color, index) => {
        const button = document.createElement('button');
        button.className = 'color-box';
        button.style.backgroundColor = color.hex;
        button.style.animationDelay = `${index * 0.05}s`;
        button.onclick = () => checkColor(color, button);
        grid.appendChild(button);
      });
    }

    function checkColor(selectedColor, button) {
      if (!isPlaying) return;
      
      if (selectedColor.name === targetColor.name) {
        playSound('correct');
        
        // Add correct animation
        button.classList.add('correct');
        button.style.animation = 'spin-bounce 0.4s ease-out';
        
        // Create particles
        const rect = button.getBoundingClientRect();
        for (let i = 0; i < 5; i++) {
          createParticle(rect.left + rect.width / 2, rect.top + rect.height / 2, ['✅', '⭐', '🎯', '✨', '🎉'][i]);
        }
        
        // Update score with visual feedback
        const oldScore = score;
        score += (10 * level) + (combo * 5);
        combo++;
        
        // Animate combo counter
        const scoreElement = document.getElementById('score');
        scoreElement.style.animation = 'pulse 0.4s ease-out';
        setTimeout(() => scoreElement.style.animation = 'none', 400);
        
        if (combo % 5 === 0) {
          level++;
          timeLeft += 5;
          playSound('levelUp');
          
          // Show level up effect
          Swal.fire({
            icon: 'success',
            title: `🌟 Level ${level}!`,
            text: '+5 seconds bonus!',
            timer: 1000,
            showConfirmButton: false,
            toast: true,
            position: 'top',
            didOpen: () => playSound('levelUp')
          });
        }
        
        updateStats();
        generateGrid();
      } else {
        playSound('wrong');
        
        // Add wrong animation
        button.classList.add('wrong');
        button.style.animation = 'shake 0.3s ease-in-out';
        
        // Particle effect for wrong
        const rect = button.getBoundingClientRect();
        createParticle(rect.left + rect.width / 2, rect.top + rect.height / 2, '❌', 600);
        
        combo = 0;
        updateStats();
        
        setTimeout(() => {
          button.classList.remove('wrong');
          button.style.animation = 'none';
        }, 300);
      }
    }

    function updateStats() {
      document.getElementById('score').textContent = score;
      document.getElementById('combo').textContent = combo;
      document.getElementById('level').textContent = level;
    }

    function endGame() {
      isPlaying = false;
      clearInterval(gameInterval);
      
      playSound('gameOver');
      
      const calculatedPoints = Math.floor(score * 1.5 + level * 10);
      
      // Show celebration popup with save option
      Swal.fire({
        icon: 'success',
        title: '🎉 Game Over!',
        html: `
          <p class="text-lg mb-2">Great job!</p>
          <p class="text-3xl font-bold text-pink-600 mb-2">${score} points</p>
          <p class="text-gray-600">Level reached: ${level}</p>
          <p class="text-2xl font-bold text-green-600 mt-3">+${calculatedPoints}! 🎯</p>
        `,
        confirmButtonColor: '#ec4899',
        confirmButtonText: 'Save & Dashboard',
        showCancelButton: true,
        cancelButtonText: 'Play Again',
        cancelButtonColor: '#6b7280',
        didOpen: () => {
          playSound('gameOver');
        }
      }).then((result) => {
        if (result.isConfirmed) {
          saveColorTapScore(score, calculatedPoints);
        } else if (result.dismiss === Swal.DismissReason.cancel) {
          location.reload();
        }
      });
      
      document.getElementById('colorGrid').classList.add('hidden');
      document.getElementById('targetColor').classList.add('hidden');
    }

    // 💾 Save Color Tap Score
    async function saveColorTapScore(score, points) {
      try {
        const response = await fetch('/api/games/save-score', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            gameType: 'color-tap',
            score: score,
            points: points,
            duration: (30 - parseInt(document.getElementById('timer').textContent)) * 1000,
            difficulty: level <= 2 ? 'easy' : level <= 4 ? 'medium' : 'hard',
            accuracy: Math.floor((score / (level * 10)) * 100)
          })
        });

        const data = await response.json();

        if (data.success) {
          localStorage.setItem('pointsUpdated', Date.now().toString());
          Swal.fire({
            icon: 'success',
            title: '✅ Score Saved!',
            html: `
              <p class="text-lg mb-2">Excellent performance!</p>
              <p class="text-3xl font-bold text-green-600 mb-2">+${points} Points!</p>
              <p class="text-gray-600">Total Points: ${data.totalPoints}</p>
            `,
            confirmButtonColor: '#10b981',
            confirmButtonText: 'View Dashboard',
            allowOutsideClick: false
          }).then(() => {
            window.location.href = '/user/dashboard';
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.message || 'Failed to save score',
            confirmButtonColor: '#ec4899'
          });
        }
      } catch (error) {
        console.error('Save error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Connection Error',
          text: 'Failed to save. Check your connection.',
          confirmButtonColor: '#ec4899'
        });
      }
    }
  </script>
</body>
</html>
