<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    @keyframes breathe {
      0%, 100% { transform: scale(0.5); opacity: 0.5; }
      50% { transform: scale(1.5); opacity: 1; }
    }
    .breathing {
      animation: breathe 8s ease-in-out infinite;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-purple-500 to-pink-600 min-h-screen flex items-center justify-center">
  <!-- Back Button -->
  <a href="/games" class="fixed top-4 left-4 bg-white p-3 rounded-full shadow-lg hover:scale-110 transition z-50">
    <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
  </a>

  <!-- Sound Toggle Button -->
  <button onclick="toggleSound()" id="soundBtn" 
          class="fixed top-4 right-4 bg-white p-3 rounded-full shadow-lg text-2xl hover:scale-110 transition z-50">
    🔊
  </button>

  <div class="container mx-auto p-6">
    <!-- Header -->
    <div class="text-center text-white mb-8">
      <h1 class="text-4xl font-bold mb-2">🫧 Breathing Bubble</h1>
      <p class="text-purple-100">Follow the bubble to breathe deeply</p>
    </div>

    <!-- Game Container -->
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl p-8">
      
      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="text-center">
          <div class="text-3xl font-bold text-purple-600" id="cycles">0</div>
          <div class="text-sm text-gray-600">Cycles</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-pink-600" id="timer">8</div>
          <div class="text-sm text-gray-600">Seconds</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-purple-600" id="points">0</div>
          <div class="text-sm text-gray-600">Points</div>
        </div>
      </div>

      <!-- Breathing Circle -->
      <div class="relative h-96 flex items-center justify-center mb-8">
        <svg class="absolute" width="400" height="400" viewBox="0 0 400 400">
          <circle id="bubble" cx="200" cy="200" r="80" 
                  fill="url(#gradient)" 
                  class="breathing" />
          <defs>
            <radialGradient id="gradient">
              <stop offset="0%" style="stop-color:rgb(168,85,247);stop-opacity:0.8" />
              <stop offset="100%" style="stop-color:rgb(236,72,153);stop-opacity:0.4" />
            </radialGradient>
          </defs>
        </svg>
        
        <!-- Instruction Text -->
        <div class="absolute text-center">
          <div id="instruction" class="text-2xl font-bold text-gray-800 mb-2">Breathe In</div>
          <div id="countdown" class="text-6xl font-bold text-purple-600">4</div>
        </div>
      </div>

      <!-- Controls -->
      <div class="flex gap-4">
        <button id="startBtn" onclick="startBreathing()" 
                class="flex-1 bg-purple-600 text-white py-3 rounded-lg font-semibold hover:bg-purple-700 transition">
          Start
        </button>
        <button id="stopBtn" onclick="stopBreathing()" disabled
                class="flex-1 bg-gray-300 text-gray-600 py-3 rounded-lg font-semibold cursor-not-allowed">
          Stop
        </button>
      </div>

      <!-- Tips -->
      <div class="mt-6 bg-purple-50 rounded-lg p-4">
        <h3 class="font-semibold text-purple-800 mb-2">💡 Tips:</h3>
        <ul class="text-sm text-purple-700 space-y-1">
          <li>• Breathe in through your nose for 4 seconds</li>
          <li>• Breathe out through your mouth for 4 seconds</li>
          <li>• Focus on the bubble expanding and contracting</li>
          <li>• Try to complete at least 5 cycles</li>
        </ul>
      </div>
    </div>
  </div>

  <script>
    // 🔊 Sound Effects - Using TikTok breathing sound!
    const sounds = {
      breathing: new Audio('/sounds/breathing-sound.mp3'), // Your TikTok audio
      complete: new Audio('/sounds/complete.mp3') // Optional success sound
    };

    // Set volumes
    sounds.breathing.volume = 0.6;
    sounds.breathing.loop = true; // Loop the breathing sound
    if (sounds.complete) sounds.complete.volume = 0.5;

    let soundEnabled = true;

    // Function to play sound safely
    function playSound(soundName) {
      if (!soundEnabled || !sounds[soundName]) return;
      
      try {
        sounds[soundName].currentTime = 0;
        sounds[soundName].play().catch(e => {
          console.log('Sound play failed:', e);
        });
      } catch (e) {
        console.log('Sound error:', e);
      }
    }

    // Function to stop sound
    function stopSound(soundName) {
      if (sounds[soundName]) {
        sounds[soundName].pause();
        sounds[soundName].currentTime = 0;
      }
    }

    // Toggle sound function
    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundBtn');
      btn.textContent = soundEnabled ? '🔊' : '🔇';
      
      if (!soundEnabled) {
        // Stop all sounds when muted
        Object.keys(sounds).forEach(key => stopSound(key));
      } else {
        // Resume breathing sound if active
        if (isBreathing) {
          playSound('breathing');
        }
      }
    }

    let isBreathing = false;
    let cycles = 0;
    let points = 0;
    let currentPhase = 'inhale';
    let countdown = 4;
    let interval;

    function startBreathing() {
      if (isBreathing) return;
      
      isBreathing = true;
      
      // Play TikTok breathing sound (loops automatically)
      playSound('breathing');
      
      document.getElementById('startBtn').disabled = true;
      document.getElementById('startBtn').classList.add('bg-gray-300', 'cursor-not-allowed');
      document.getElementById('startBtn').classList.remove('bg-purple-600', 'hover:bg-purple-700');
      
      document.getElementById('stopBtn').disabled = false;
      document.getElementById('stopBtn').classList.remove('bg-gray-300', 'cursor-not-allowed');
      document.getElementById('stopBtn').classList.add('bg-red-500', 'hover:bg-red-600');
      
      breatheCycle();
    }

    function stopBreathing() {
      isBreathing = false;
      clearInterval(interval);
      
      // Stop breathing sound
      stopSound('breathing');
      
      document.getElementById('startBtn').disabled = false;
      document.getElementById('startBtn').classList.remove('bg-gray-300', 'cursor-not-allowed');
      document.getElementById('startBtn').classList.add('bg-purple-600', 'hover:bg-purple-700');
      
      document.getElementById('stopBtn').disabled = true;
      document.getElementById('stopBtn').classList.add('bg-gray-300', 'cursor-not-allowed');
      document.getElementById('stopBtn').classList.remove('bg-red-500', 'hover:bg-red-600');
      
      document.getElementById('instruction').textContent = 'Paused';
      document.getElementById('countdown').textContent = '—';
    }

    function breatheCycle() {
      if (!isBreathing) return;
      
      countdown = 4;
      updateDisplay();
      
      interval = setInterval(() => {
        countdown--;
        
        if (countdown <= 0) {
          if (currentPhase === 'inhale') {
            // Switch to exhale
            currentPhase = 'exhale';
            countdown = 4;
            document.getElementById('instruction').textContent = 'Breathe Out';
          } else {
            // Complete one cycle
            currentPhase = 'inhale';
            cycles++;
            points += 10;
            document.getElementById('cycles').textContent = cycles;
            document.getElementById('points').textContent = points;
            countdown = 4;
            document.getElementById('instruction').textContent = 'Breathe In';
            
            // Play complete sound (optional)
            playSound('complete');
            
            // Show celebration at milestones
            if (cycles === 5) {
              Swal.fire({
                icon: 'success',
                title: '🎉 Great Job!',
                text: 'You completed 5 breathing cycles!',
                timer: 2000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end',
                didOpen: () => {
                  playSound('complete');
                }
              });
            } else if (cycles === 10) {
              Swal.fire({
                icon: 'success',
                title: '🌟 Amazing!',
                text: '10 cycles completed! You are very calm now.',
                timer: 2000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end',
                didOpen: () => {
                  playSound('complete');
                }
              });
            }
          }
        }
        
        updateDisplay();
      }, 1000);
    }

    function updateDisplay() {
      document.getElementById('countdown').textContent = countdown;
      document.getElementById('timer').textContent = countdown;
    }
  </script>
</body>
</html>
